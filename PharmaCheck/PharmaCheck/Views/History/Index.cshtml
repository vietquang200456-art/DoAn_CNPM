@{
    ViewData["Title"] = "Lịch Sử Tra Cứu";
    bool isAdmin = User.IsInRole("Admin");
    var historyList = ViewBag.HistoryList as IEnumerable<dynamic>;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 animate-fade-in">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8 pb-6 border-b border-slate-100">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-3">
                <div class="bg-indigo-50 text-indigo-600 p-2.5 rounded-xl border border-indigo-100/50 shadow-sm">
                    <i class="fas fa-history text-xl"></i>
                </div>
                <span>Lịch Sử Nhật Ký Tra Cứu @(isAdmin ? "(Quyền Admin)" : "")</span>
            </h1>
            <p class="text-sm text-slate-500 mt-1.5">
                @(isAdmin ? "Quản lý và theo dõi toàn bộ nhật ký tra cứu của người dùng." : "Xem lại danh sách các thuốc và bệnh lý bạn đã kiểm tra.")
            </p>
        </div>
        <a asp-controller="Home" asp-action="Check" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm shadow-lg transition-all active:scale-[0.98]">
            <i class="fas fa-plus text-xs"></i> Tra cứu mới
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-xl mb-6 flex items-center gap-3 text-sm">
            <i class="fas fa-exclamation-circle text-red-500"></i> @ViewBag.ErrorMessage
        </div>
    }

    @if (historyList == null || !historyList.Any())
    {
        <div class="bg-white border border-slate-100 rounded-2xl p-16 text-center shadow-sm">
            <div class="w-16 h-16 bg-slate-50 text-slate-400 flex items-center justify-center rounded-2xl mx-auto mb-4 text-2xl border border-slate-100">
                <i class="fas fa-folder-open"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800">Chưa có lịch sử tra cứu</h3>
        </div>
    }
    else
    {
        <div class="bg-white border border-slate-100 rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[900px]">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 text-xs font-bold uppercase tracking-wider">
                            <th class="py-4 px-6 w-[160px]">Thời gian</th>
                            @if (isAdmin) { <th class="py-4 px-6 w-[200px]">Tài khoản</th> }
                            <th class="py-4 px-6 w-[220px]">Phân loại</th>
                            <th class="py-4 px-6">Nội dung tra cứu</th>
                            @if (isAdmin) { <th class="py-4 px-6 text-center w-[80px]">Xóa</th> }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @foreach (var item in historyList)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-6 text-slate-500 font-mono text-xs whitespace-nowrap">
                                    @item.Time
                                </td>
                                
                                @if (isAdmin)
                                {
                                    <td class="py-4 px-6 font-medium text-slate-800 truncate max-w-[180px]">
                                        @item.UserName
                                    </td>
                                }

                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-[11px] font-bold border whitespace-nowrap uppercase @item.BadgeColor">
                                        <i class="fas @item.Icon text-[10px]"></i>
                                        @item.TypeName
                                    </span>
                                </td>

                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 flex items-center justify-center rounded-lg border bg-slate-50 shrink-0">
                                            <i class="fas @(item.SearchType == "Drug-Drug" ? "fa-exchange-alt text-purple-500" : (item.SearchType == "Drug-Disease" ? "fa-shield-virus text-amber-500" : "fa-pills text-teal-500")) text-[10px]"></i>
                                        </div>
                                        <span class="text-slate-700 font-medium truncate max-w-[400px]" title="@item.SearchQuery">
                                            @item.SearchQuery
                                        </span>
                                    </div>
                                </td>

                                @if (isAdmin)
                                {
                                    <td class="py-4 px-6 text-center">
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xác nhận xóa bản ghi này?');">
                                            <button type="submit" class="text-slate-400 hover:text-red-500 transition-colors">
                                                <i class="far fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="bg-slate-50/50 border-t border-slate-100 px-6 py-4 text-xs text-slate-500 font-medium">
                Tổng cộng: <strong class="text-slate-700">@historyList.Count()</strong> bản ghi
            </div>
        </div>
    }
</div>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>