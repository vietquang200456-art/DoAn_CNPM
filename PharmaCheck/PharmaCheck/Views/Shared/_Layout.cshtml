@* Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCheck</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'medical': {
                            50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
                            400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
                            800: '#075985', 900: '#0c3d66'
                        },
                        'danger': '#dc2626',
                        'warning': '#f59e0b',
                        'success': '#10b981'
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(3, 105, 161, 0.5) rgba(226, 232, 240, 1);
        }
        *::-webkit-scrollbar { width: 8px; height: 8px; }
        *::-webkit-scrollbar-track { background: rgba(226, 232, 240, 1); }
        *::-webkit-scrollbar-thumb { background: rgba(3, 105, 161, 0.5); border-radius: 4px; }
        
        .transition-all { transition: all 0.3s ease; }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(3, 105, 161, 0.15); }

        .nav-link { position: relative; transition: color 0.25s ease; }
        .nav-link::after {
            content: ''; position: absolute; bottom: 0; left: 50%; width: 0; height: 2px;
            background-color: #0369a1; transition: all 0.25s ease; transform: translateX(-50%);
        }
        .nav-link:hover::after { width: 80%; }
    </style>
</head>

<body class="bg-slate-50 text-gray-900 flex flex-col min-h-screen">
    
    @* 🌟 GỌI HEADER PARTIAL *@
    <partial name="_Header" />

    <main class="flex-grow">
        @RenderBody()
    </main>

    @* 🌟 GỌI FOOTER PARTIAL *@
    <partial name="_Footer" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>