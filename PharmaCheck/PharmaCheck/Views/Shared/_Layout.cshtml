<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCheck</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        'medical': {
        50: '#f0f9ff',
        100: '#e0f2fe',
        200: '#bae6fd',
        300: '#7dd3fc',
        400: '#38bdf8',
        500: '#0ea5e9',
        600: '#0284c7',
        700: '#0369a1',
        800: '#075985',
        900: '#0c3d66'
        },
        'danger': '#dc2626',
        'warning': '#f59e0b',
        'success': '#10b981'
        }
        }
        }
        }
    </script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Alpine.js for interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        * {
        scrollbar-width: thin;
        scrollbar-color: rgba(3, 105, 161, 0.5) rgba(226, 232, 240, 1);
        }

        *::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        }

        *::-webkit-scrollbar-track {
        background: rgba(226, 232, 240, 1);
        }

        *::-webkit-scrollbar-thumb {
        background: rgba(3, 105, 161, 0.5);
        border-radius: 4px;
        }

        .transition-all {
        transition: all 0.3s ease;
        }

        .card-hover {
        transition: all 0.3s ease;
        }

        .card-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(3, 105, 161, 0.15);
        }
    </style>
</head>

<body class="bg-slate-50 text-gray-900">
    <!-- Header/Navigation -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo & Brand -->
                <div class="flex items-center gap-3">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                        <div class="bg-medical-700 text-white p-2 rounded-lg">
                            <i class="fas fa-pills text-lg"></i>
                        </div>
                        <span class="text-xl font-bold text-medical-700">PharmaCheck</span>
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:flex items-center gap-1">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="px-4 py-2 rounded-md text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                        <i class="fas fa-home mr-2"></i>Trang Chủ
                    </a>
                    <a asp-area="" asp-controller="Drug" asp-action="Index"
                       class="px-4 py-2 rounded-md text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                        <i class="fas fa-pills mr-2"></i>Quản Lý Thuốc
                    </a>
                    <a asp-area="" asp-controller="Disease" asp-action="Index"
                       class="px-4 py-2 rounded-md text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                        <i class="fas fa-heartbeat mr-2"></i>Quản Lý Bệnh Lý
                    </a>
                    <a asp-area="" asp-controller="Interaction" asp-action="Index"
                       class="px-4 py-2 rounded-md text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                        <i class="fas fa-exchange-alt mr-2"></i>Cấu Hình Tương Tác
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy"
                       class="px-4 py-2 rounded-md text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                        <i class="fas fa-shield-alt mr-2"></i>Bảo Mật
                    </a>
                </div>

                <!-- Mobile Menu Toggle -->
                <button class="md:hidden p-2 rounded-md text-gray-700 hover:bg-medical-50"
                        onclick="document.getElementById('mobileMenu').classList.toggle('hidden')">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>

            <!-- Mobile Navigation Menu -->
            <div id="mobileMenu" class="hidden md:hidden border-t border-slate-200">
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="block px-4 py-3 text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                    <i class="fas fa-home mr-2"></i>Trang Chủ
                </a>
                <a asp-area="" asp-controller="Drug" asp-action="Index"
                   class="block px-4 py-3 text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                    <i class="fas fa-pills mr-2"></i>Quản Lý Thuốc
                </a>
                <a asp-area="" asp-controller="Interaction" asp-action="Index"
                   class="block px-4 py-3 text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                    <i class="fas fa-exchange-alt mr-2"></i>Cấu Hình Tương Tác
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy"
                   class="block px-4 py-3 text-gray-700 hover:bg-medical-50 hover:text-medical-700 transition-colors">
                    <i class="fas fa-shield-alt mr-2"></i>Bảo Mật
                </a>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="min-h-screen">
        @RenderBody()
    </main>

    <section class="py-16 bg-gradient-to-r from-medical-700 to-medical-600 text-white">
        <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
            <h2 class="text-4xl font-bold mb-4">Bạn Đã Sẵn Sàng?</h2>
            <p class="text-xl text-blue-100 mb-8">
                Bắt đầu tra cứu tương tác thuốc - bệnh ngay bây giờ để đảm bảo an toàn cho bệnh nhân của bạn.
            </p>
            <button onclick="document.getElementById('searchSection').scrollIntoView({behavior: 'smooth'})"
                    class="bg-white text-medical-700 px-8 py-4 rounded-lg font-semibold text-lg hover:bg-blue-50 transition-colors inline-flex items-center gap-2">
                <i class="fas fa-arrow-right"></i> Tra Cứu Ngay
            </button>
        </div>
    </section>
    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-100 mt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid md:grid-cols-4 gap-8 mb-8">
                <!-- About -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="bg-medical-600 text-white p-2 rounded-lg">
                            <i class="fas fa-pills"></i>
                        </div>
                        <h3 class="text-lg font-bold">PharmaCheck</h3>
                    </div>
                    <p class="text-gray-400 text-sm">
                        Hệ thống tra cứu tương tác thuốc - bệnh dành cho phòng khám chuyên nghiệp.
                    </p>
                </div>

                <!-- Quick Links -->
                <div>
                    <h4 class="font-semibold mb-4">Liên Kết</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Trang Chủ</a>
                        </li>
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Quản Lý Thuốc</a>
                        </li>
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Tương Tác</a>
                        </li>
                    </ul>
                </div>

                <!-- Support -->
                <div>
                    <h4 class="font-semibold mb-4">Hỗ Trợ</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Hướng Dẫn</a>
                        </li>
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Liên Hệ</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">FAQ</a></li>
                    </ul>
                </div>

                <!-- Legal -->
                <div>
                    <h4 class="font-semibold mb-4">Pháp Lý</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy"
                                   class="text-gray-400 hover:text-medical-400 transition-colors">Chính Sách Bảo Mật</a>
                        </li>
                        <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Điều Khoản Dịch
                            Vụ</a></li>
                            <li><a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">Trách Nhiệm Pháp
                                Lý</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="border-t border-gray-800 pt-8">
                        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                            <p class="text-gray-400 text-sm">
                                &copy; 2026 PharmaCheck. Tất cả quyền được bảo lưu. | Phân phối với mục đích y tế chuyên nghiệp.
                            </p>
                            <div class="flex gap-4">
                                <a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">
                                    <i class="fab fa-facebook text-xl"></i>
                                </a>
                                <a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">
                                    <i class="fab fa-twitter text-xl"></i>
                                </a>
                                <a href="#" class="text-gray-400 hover:text-medical-400 transition-colors">
                                    <i class="fab fa-linkedin text-xl"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>

            <!-- Scripts -->
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>
