@model PharmaCheck.Models.DiseasePagedListViewModel

@{
    ViewData["Title"] = "Quản Lý Bệnh Lý | PharmaCheck";
    bool isAdmin = User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<div class="bg-slate-900 text-white py-10 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-800/50 via-slate-900 to-slate-900 z-0"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-emerald-400 shadow-inner">
                        <i class="fas fa-heartbeat text-xl animate-pulse"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                            Hồ Sơ Danh Mục Bệnh Lý
                        </h1>
                        <p class="text-xs text-slate-400 font-medium mt-0.5 uppercase tracking-wider">Hệ thống quản lý thông tin lâm sàng chuyên sâu</p>
                    </div>
                </div>
                <p class="text-slate-400 text-sm mt-3 max-w-xl">
                    Hỗ trợ tra cứu, cập nhật triệu chứng, phân tích nguyên nhân và thiết lập phác đồ điều trị chuẩn hóa trong cơ sở dữ liệu PharmaCheck.
                </p>
            </div>
            @if (isAdmin)
            {
                <button onclick="openDiseaseModal()" 
                        class="bg-white hover:bg-slate-100 text-slate-900 px-5 py-3 rounded-xl font-bold transition-all duration-150 flex items-center gap-2 shadow-sm border border-slate-200 cursor-pointer text-sm self-start md:self-center">
                    <i class="fas fa-plus text-xs"></i> Khai báo bệnh lý mới
                </button>
            }
        </div>
    </div>
</div>

<section class="py-8 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 mb-6">
            <div class="flex flex-col lg:flex-row gap-4 items-center">
                <div class="w-full lg:flex-1 relative">
                    <input type="text"
                           id="diseaseSearch"
                           value="@Model.SearchTerm"
                           placeholder="Tìm tên bệnh, triệu chứng lâm sàng, nguyên nhân..."
                           class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white text-sm transition-all font-medium text-slate-800 placeholder-slate-400">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                        <i class="fas fa-search text-xs"></i>
                    </div>
                </div>

                <div class="w-full lg:w-auto flex flex-col sm:flex-row gap-3 items-center min-w-[350px]">
                    <div class="w-full sm:flex-1">
                        <select id="statusFilter" 
                                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white text-sm transition-all font-semibold text-slate-700">
                            <option value="">Tất cả trạng thái</option>
                            <!option value="active" @(Model.SeverityFilter?.ToLower() == "active" ? "selected" : "")>Đang Hoạt Động</!option>
                            <!option value="inactive" @(Model.SeverityFilter?.ToLower() == "inactive" ? "selected" : "")>Ngừng Hoạt Động</!option>
                        </select>
                    </div>
                    
                    <button onclick="searchAndFilter()" 
                            class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm">
                        <i class="fas fa-filter text-xs"></i> Lọc kết quả
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden mb-6">
            <partial name="~/Views/Disease/listdisease.cshtml" />
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 px-6 py-4 flex items-center justify-between flex-wrap gap-4">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                Hiển thị <span class="text-slate-800 font-extrabold">@((Model.CurrentPage - 1) * Model.PageSize + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> 
                trên tổng <span class="text-slate-800 font-extrabold">@Model.TotalRecords</span> mục dữ liệu
            </div>
            
            <div class="flex items-center gap-1 flex-wrap">
                <button onclick="goToPage(@(Model.CurrentPage - 1))" 
                        class="w-9 h-9 flex items-center justify-center border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                        @(Model.HasPreviousPage ? "" : "disabled") interstitial-button-click>
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <button class="w-9 h-9 flex items-center justify-center bg-slate-900 text-white font-bold rounded-lg text-sm shadow-sm">@i</button>
                    }
                    else if (i <= 3 || i >= Model.TotalPages - 2 || Math.Abs(i - Model.CurrentPage) <= 1)
                    {
                        <button onclick="goToPage(@i)" class="w-9 h-9 flex items-center justify-center border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 transition-colors font-bold text-sm cursor-pointer">@i</button>
                    }
                    else if (i == 4 || i == Model.TotalPages - 3)
                    {
                        <span class="w-9 h-9 flex items-center justify-center text-slate-400 font-bold">...</span>
                    }
                }

                <button onclick="goToPage(@(Model.CurrentPage + 1))" 
                        class="w-9 h-9 flex items-center justify-center border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                        @(Model.HasNextPage ? "" : "disabled")>
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>
    </div>
</section>

@if (isAdmin)
{
    <div id="diseaseModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4 transition-opacity duration-200">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[85vh] flex flex-col border border-slate-200 transform scale-100 transition-transform duration-200">
            <div class="bg-slate-900 text-white px-6 py-4.5 flex items-center justify-between border-b border-slate-800 rounded-t-2xl">
                <div class="flex items-center gap-2.5">
                    <i class="fas fa-heartbeat text-emerald-400"></i>
                    <h2 class="text-lg font-bold tracking-tight" id="modalTitle">Thêm Bệnh Lý Mới</h2>
                </div>
                <button onclick="closeDiseaseModal()" class="text-slate-400 hover:text-white hover:bg-slate-800 w-8 h-8 rounded-lg flex items-center justify-center transition-colors cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form id="diseaseForm" class="p-6 space-y-4 overflow-y-auto flex-1 text-sm">
                <input type="hidden" id="diseaseId" value="0">

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tên Bệnh Lý <span class="text-red-500">*</span></label>
                    <input type="text" id="diseaseName" placeholder="Nhập tên bệnh lý chuẩn hóa..."
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800" required>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Triệu Chứng Lâm Sàng</label>
                        <textarea rows="4" id="symptoms" placeholder="Các biểu hiện đặc trưng..."
                                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nguyên Nhân Gây Bệnh</label>
                        <textarea rows="4" id="causes" placeholder="Cơ chế sinh học hoặc tác nhân..."
                                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none"></textarea>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Phác Đồ & Phương Pháp Điều Trị</label>
                    <textarea rows="3" id="treatmentMethod" placeholder="Hướng dẫn điều trị hoặc nhóm thuốc chỉ định chính..."
                              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Mô Tả Chi Tiết / Ghi Chú Y Khoa</label>
                    <textarea rows="3" id="description" placeholder="Ghi chú thêm thông tin lưu ý..."
                              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Trạng Thái Quản Lý</label>
                    <div class="flex gap-6 mt-1">
                        <label class="flex items-center gap-2 cursor-pointer group font-medium text-slate-700">
                            <input type="radio" name="isActive" id="statusActive" value="true" checked class="w-4 h-4 accent-slate-900">
                            <span class="group-hover:text-slate-900 transition-colors">Đang Theo Dõi (Active)</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer group font-medium text-slate-700">
                            <input type="radio" name="isActive" id="statusInactive" value="false" class="w-4 h-4 accent-slate-900">
                            <span class="group-hover:text-slate-900 transition-colors">Ngừng Kê Khai (Inactive)</span>
                        </label>
                    </div>
                </div>

                <div id="formMessage" class="hidden px-4 py-3 rounded-xl font-semibold text-center"></div>
            </form>

            <div class="bg-slate-50 border-t border-slate-100 px-6 py-4 flex gap-2.5 justify-end rounded-b-2xl">
                <button onclick="closeDiseaseModal()"
                        class="px-5 py-2.5 border border-slate-200 text-slate-700 rounded-xl font-bold hover:bg-slate-100 transition-colors cursor-pointer">
                    Hủy bỏ
                </button>
                <button onclick="saveDisease()" id="saveDiseaseBtn"
                        class="px-5 py-2.5 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-colors flex items-center gap-2 shadow-sm cursor-pointer">
                    <i class="fas fa-check text-xs"></i> <span id="saveBtnText">Xác nhận</span>
                </button>
            </div>
        </div>
    </div>

    <div id="deleteModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full border border-slate-200 p-6">
            <div class="flex items-center justify-center w-11 h-11 bg-red-50 text-red-600 rounded-xl mb-4 border border-red-100">
                <i class="fas fa-trash-alt text-base"></i>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1">Xóa bản ghi bệnh lý?</h3>
            <p class="text-sm text-slate-500 leading-relaxed mb-5">
                Hệ thống sẽ loại bỏ hoàn toàn thông tin của bệnh <span id="deleteItemName" class="font-bold text-slate-800"></span> khỏi danh mục. Hành động này không thể hoàn tác.
            </p>
            <div class="flex gap-2 justify-end text-sm">
                <button onclick="closeDeleteModal()"
                        class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg font-bold hover:bg-slate-50 transition-colors cursor-pointer">
                    Quay lại
                </button>
                <button onclick="deleteDiseaseConfirmed()" id="confirmDeleteBtn"
                        class="px-4 py-2 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition-colors cursor-pointer flex items-center gap-1.5">
                    Đồng ý xóa
                </button>
            </div>
        </div>
    </div>
}
<script>
let currentDeleteId = 0;
let currentDeleteName = '';
const isAdminUser = @(isAdmin ? "true" : "false");

// ===== QUẢN LÝ ĐÓNG/MỞ MODAL =====
function openDiseaseModal() {
    if(!isAdminUser) return;
    resetForm();
    document.getElementById('diseaseModal').classList.remove('hidden');
    document.getElementById('modalTitle').textContent = 'Thêm Bệnh Lý Mới';
    document.getElementById('saveBtnText').textContent = 'Xác nhận';
}

function editDisease(id) {
    if(!isAdminUser || !id) return;
    
    fetch(`/Disease/GetDiseaseById?id=${id}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                fillFormWithData(data.data);
                document.getElementById('diseaseModal').classList.remove('hidden');
                document.getElementById('modalTitle').textContent = 'Chỉnh Sửa Bệnh Lý';
                document.getElementById('saveBtnText').textContent = 'Cập nhật bản ghi';
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Không thể kết nối lấy dữ liệu lâm sàng');
        });
}

function closeDiseaseModal() {
    if(!isAdminUser) return;
    document.getElementById('diseaseModal').classList.add('hidden');
    resetForm();
}

function confirmDeleteDisease(id, diseaseName) {
    if(!isAdminUser || !id) return;
    currentDeleteId = id;
    currentDeleteName = diseaseName;
    document.getElementById('deleteItemName').textContent = diseaseName;
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    if(!isAdminUser) return;
    document.getElementById('deleteModal').classList.add('hidden');
    currentDeleteId = 0;
    currentDeleteName = '';
}

document.addEventListener('click', function(e) {
    if(!isAdminUser) return;
    const diseaseModal = document.getElementById('diseaseModal');
    const deleteModal = document.getElementById('deleteModal');
    
    if (e.target === diseaseModal) {
        closeDiseaseModal();
    }
    if (e.target === deleteModal) {
        closeDeleteModal();
    }
});

// ===== THAO TÁC TRÊN FORM DỮ LIỆU =====
function resetForm() {
    if(!isAdminUser) return;
    const form = document.getElementById('diseaseForm');
    if(form) form.reset();
    document.getElementById('diseaseId').value = '0';
    document.getElementById('statusActive').checked = true;
    document.getElementById('formMessage').classList.add('hidden');
}

function fillFormWithData(data) {
    if(!isAdminUser) return;
    document.getElementById('diseaseId').value = data.id || 0;
    document.getElementById('diseaseName').value = data.name || '';
    document.getElementById('symptoms').value = data.symptoms || '';
    document.getElementById('causes').value = data.causes || '';
    document.getElementById('treatmentMethod').value = data.treatmentMethod || '';
    document.getElementById('description').value = data.description || '';
    
    if (data.isActive) {
        document.getElementById('statusActive').checked = true;
    } else {
        document.getElementById('statusInactive').checked = true;
    }
}

function saveDisease() {
    if(!isAdminUser) return;
    const form = document.getElementById('diseaseForm');
    
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const diseaseData = {
        id: parseInt(document.getElementById('diseaseId').value) || 0,
        name: document.getElementById('diseaseName').value,
        symptoms: document.getElementById('symptoms').value,
        causes: document.getElementById('causes').value,
        treatmentMethod: document.getElementById('treatmentMethod').value,
        description: document.getElementById('description').value,
        isActive: document.getElementById('statusActive').checked
    };

    const saveBtn = document.getElementById('saveDiseaseBtn');
    saveBtn.disabled = true;
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin text-xs"></i> Xử lý...';

    fetch('/Disease/SaveDisease', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(diseaseData)
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;

        if (data.success) {
            showMessage(true, data.message);
            setTimeout(() => {
                closeDiseaseModal();
                location.reload();
            }, 1200);
        } else {
            showMessage(false, data.message || 'Lỗi lưu trữ dữ liệu');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        showMessage(false, 'Mất kết nối tới máy chủ API');
    });
}

function deleteDiseaseConfirmed() {
    if(!isAdminUser || currentDeleteId === 0) return;

    const deleteBtn = document.getElementById('confirmDeleteBtn');
    deleteBtn.disabled = true;
    const originalText = deleteBtn.innerHTML;
    deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> Đang xóa...';

    fetch(`/Disease/DeleteDisease?id=${currentDeleteId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = originalText;

        if (data.success) {
            closeDeleteModal();
            location.reload();
        } else {
            alert('Lỗi: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = originalText;
        alert('Lỗi kết nối máy chủ không phản hồi');
    });
}

function showMessage(isSuccess, message) {
    const messageDiv = document.getElementById('formMessage');
    if(!messageDiv) return;
    messageDiv.textContent = message;
    messageDiv.classList.remove('hidden');
    
    if (isSuccess) {
        messageDiv.className = "px-4 py-2.5 rounded-xl text-center font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100";
    } else {
        messageDiv.className = "px-4 py-2.5 rounded-xl text-center font-semibold bg-red-50 text-red-700 border border-red-100";
    }
}

// ===== LOGIC TÌM KIẾM CHỦ ĐỘNG THEO YÊU CẦU =====
function goToPage(page) {
    if (page < 1) return;
    
    const searchTerm = document.getElementById('diseaseSearch').value;
    const status = document.getElementById('statusFilter').value; 
    
    let url = `/Disease/Index?page=${page}`;
    if (searchTerm) url += `&searchTerm=${encodeURIComponent(searchTerm.trim())}`;
    if (status) url += `&status=${encodeURIComponent(status)}`; 
    
    window.location.href = url;
}

// Hàm kích hoạt hành động tìm kiếm & lọc khi có tương tác chuẩn
function searchAndFilter() {
    goToPage(1);
}

// Bắt sự kiện gõ phím: Loại bỏ hoàn toàn setTimeout tự động load dữ liệu
document.getElementById('diseaseSearch').addEventListener('keydown', function(e) {
    // Chỉ kích hoạt lọc khi người dùng bấm phím Enter trực tiếp trên ô tìm kiếm
    if (e.key === 'Enter') {
        searchAndFilter();
    }
});

// Lưu ý: Đối với thẻ select lọc trạng thái, thông thường trang thuốc sẽ tự động reload luôn khi đổi lựa chọn.
// Nếu bạn muốn thẻ select này CŨNG PHẢI đợi nhấn nút "Lọc kết quả" mới chạy, hãy comment/xóa 3 dòng dưới đây:
document.getElementById('statusFilter').addEventListener('change', function(e) {
    searchAndFilter();
});
</script>