@model PharmaCheck.Models.DiseasePagedListViewModel

@{
    ViewData["Title"] = "Quản Lý Bệnh Lý | PharmaCheck";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="bg-gradient-to-r from-medical-700 to-medical-600 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold flex items-center gap-3">
                    <i class="fas fa-heartbeat"></i>
                    Quản Lý Danh Mục Bệnh Lý
                </h1>
                <p class="text-blue-100 mt-2">Tra cứu, tạo, sửa và quản lý thông tin các bệnh lý trong cơ sở dữ liệu</p>
            </div>
            @if (isAdmin)
            {
                <button onclick="openDiseaseModal()" class="bg-white text-medical-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors flex items-center gap-2 shadow-md">
                    <i class="fas fa-plus"></i> Thêm Bệnh Lý Mới
                </button>
            }
        </div>
    </div>
</div>

<section class="py-8 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-lg border border-slate-200 p-6 mb-8">
            <div class="grid md:grid-cols-3 gap-4">
                <div class="md:col-span-2">
                    <div class="relative">
                        <input type="text"
                               id="diseaseSearch"
                               value="@Model.SearchTerm"
                               placeholder="Tìm kiếm bệnh lý (tên, triệu chứng, nguyên nhân)..."
                               class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                        <i class="fas fa-search absolute right-4 top-4 text-medical-600"></i>
                    </div>
                </div>

                <div>
                    <select id="severityFilter" class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                        <option value="">Tất cả Trạng Thái</option>
                        <!option value="active" @(Model.SeverityFilter?.ToLower() == "active" ? "selected" : "")>Đang Hoạt Động</!option>
                        <!option value="inactive" @(Model.SeverityFilter?.ToLower() == "inactive" ? "selected" : "")>Ngừng Hoạt Động</!option>
                    </select>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-medical-700 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left font-semibold text-sm w-16">
                                <i class="fas fa-list mr-2"></i>STT
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-heartbeat mr-2"></i>Tên Bệnh Lý
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-exclamation-circle mr-2"></i>Triệu Chứng
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-question-circle mr-2"></i>Nguyên Nhân
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-stethoscope mr-2"></i>Phương Pháp Điều Trị
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-circle text-sm mr-2"></i>Trạng Thái
                            </th>
                            @if (isAdmin)
                            {
                                <th class="px-6 py-4 text-center font-semibold text-sm w-32">
                                    <i class="fas fa-cog mr-2"></i>Thao Tác
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-200">
                        @if (Model.Diseases != null && Model.Diseases.Any())
                        {
                            int stt = (Model.CurrentPage - 1) * Model.PageSize + 1;
                            @foreach (var disease in Model.Diseases)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-gray-900">@stt</td>
                                    <td class="px-6 py-4">
                                        <div class="font-semibold text-gray-900">@disease.Name</div>
                                        <div class="text-sm text-gray-500">ID: @disease.Id</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium max-w-xs truncate" title="@disease.Symptoms">
                                            @(string.IsNullOrEmpty(disease.Symptoms) ? "N/A" : disease.Symptoms)
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm text-gray-700 max-w-xs truncate" title="@disease.Causes">
                                            @(string.IsNullOrEmpty(disease.Causes) ? "N/A" : disease.Causes)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm text-gray-700 max-w-xs truncate" title="@disease.TreatmentMethod">
                                            @(string.IsNullOrEmpty(disease.TreatmentMethod) ? "N/A" : disease.TreatmentMethod)
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (disease.IsActive)
                                        {
                                            <span class="inline-flex items-center gap-2 bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
                                                <i class="fas fa-check-circle"></i>Đang Hoạt Động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-2 bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium">
                                                <i class="fas fa-times-circle"></i>Ngừng Hoạt Động
                                            </span>
                                        }
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td class="px-6 py-4">
                                            <div class="flex justify-center gap-2">
                                                <button onclick="editDisease(@disease.Id)" class="bg-blue-100 text-blue-700 hover:bg-blue-200 p-2 rounded-lg transition-colors" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button onclick="confirmDeleteDisease(@disease.Id, '@disease.Name')" class="bg-red-100 text-red-700 hover:bg-red-200 p-2 rounded-lg transition-colors" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(isAdmin ? 7 : 6)" class="px-6 py-8 text-center text-gray-500">
                                    <i class="fas fa-inbox text-3xl mb-2 block opacity-50"></i>
                                    Không có bệnh lý nào để hiển thị
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex items-center justify-between flex-wrap gap-4">
                <div class="text-sm text-gray-600">
                    Hiển thị <span class="font-semibold">@((Model.CurrentPage - 1) * Model.PageSize + 1)-@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> 
                    của <span class="font-semibold">@Model.TotalRecords</span> bệnh lý
                </div>
                <div class="flex gap-2 flex-wrap">
                    <button onclick="goToPage(@(Model.CurrentPage - 1))" 
                            class="px-4 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            @(Model.HasPreviousPage ? "" : "disabled")>
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <button class="px-3 py-2 bg-medical-700 text-white rounded-lg font-medium">@i</button>
                        }
                        else
                        {
                            <button onclick="goToPage(@i)" class="px-3 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors">@i</button>
                        }
                    }

                    <button onclick="goToPage(@(Model.CurrentPage + 1))" 
                            class="px-4 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            @(Model.HasNextPage ? "" : "disabled")>
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@if (isAdmin)
{
    <div id="diseaseModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 bg-medical-700 text-white px-6 py-4 flex items-center justify-between border-b border-medical-600">
                <h2 class="text-2xl font-bold flex items-center gap-3">
                    <i class="fas fa-heartbeat"></i>
                    <span id="modalTitle">Thêm Bệnh Lý Mới</span>
                </h2>
                <button onclick="closeDiseaseModal()" class="text-white hover:bg-medical-600 p-2 rounded-lg transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <form id="diseaseForm" class="p-6 space-y-4">
                <input type="hidden" id="diseaseId" value="0">

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-heartbeat text-medical-700 mr-2"></i>Tên Bệnh Lý <span class="text-red-600">*</span>
                    </label>
                    <input type="text" id="diseaseName" placeholder="VD: Tiểu đường loại 2"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors"
                           required>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-exclamation-circle text-medical-700 mr-2"></i>Triệu Chứng
                    </label>
                    <textarea rows="3" id="symptoms" placeholder="Nhập các triệu chứng..."
                              class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-question-circle text-medical-700 mr-2"></i>Nguyên Nhân
                    </label>
                    <textarea rows="3" id="causes" placeholder="Nhập nguyên nhân gây bệnh..."
                              class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-stethoscope text-medical-700 mr-2"></i>Phương Pháp Điều Trị
                    </label>
                    <textarea rows="3" id="treatmentMethod" placeholder="Nhập phương pháp điều trị..."
                              class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-align-left text-medical-700 mr-2"></i>Mô Tả / Ghi Chú
                    </label>
                    <textarea rows="3" id="description" placeholder="Nhập mô tả chi tiết..."
                              class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-circle text-medical-700 mr-2"></i>Trạng Thái
                    </label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="isActive" id="statusActive" value="true" checked class="w-4 h-4">
                            <span class="text-gray-700">Đang Hoạt Động</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="isActive" id="statusInactive" value="false" class="w-4 h-4">
                            <span class="text-gray-700">Ngừng Hoạt Động</span>
                        </label>
                    </div>
                </div>

                <div id="formMessage" class="hidden px-4 py-3 rounded-lg text-sm font-medium"></div>
            </form>

            <div class="sticky bottom-0 bg-slate-50 border-t border-slate-200 px-6 py-4 flex gap-3 justify-end">
                <button onclick="closeDiseaseModal()"
                        class="px-6 py-3 border-2 border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-50 transition-colors">
                    Hủy
                </button>
                <button onclick="saveDisease()" id="saveDiseaseBtn"
                        class="px-6 py-3 bg-medical-700 text-white rounded-lg font-semibold hover:bg-medical-800 transition-colors flex items-center gap-2">
                    <i class="fas fa-save"></i> <span id="saveBtnText">Lưu</span>
                </button>
            </div>
        </div>
    </div>

    <div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full">
            <div class="p-6">
                <div class="flex items-center justify-center w-12 h-12 mx-auto bg-red-100 rounded-full mb-4">
                    <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                </div>
                <h3 class="text-xl font-bold text-center text-gray-900 mb-2">Xác Nhận Xóa</h3>
                <p class="text-center text-gray-600 mb-6">
                    Bạn chắc chắn muốn xóa <span id="deleteItemName" class="font-semibold"></span>? Hành động này không thể hoàn tác.
                </p>
            </div>
            <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex gap-3 justify-end">
                <button onclick="closeDeleteModal()"
                        class="px-6 py-2 border border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-50 transition-colors">
                    Hủy
                </button>
                <button onclick="deleteDiseaseConfirmed()" id="confirmDeleteBtn"
                        class="px-6 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-colors flex items-center gap-2">
                    <i class="fas fa-trash"></i> Xóa
                </button>
            </div>
        </div>
    </div>
}

<script>
let currentDeleteId = 0;
let currentDeleteName = '';
let searchTimeout;
const isAdminUser = @(isAdmin ? "true" : "false");

// ===== Modal Management =====
function openDiseaseModal() {
    if(!isAdminUser) return;
    resetForm();
    document.getElementById('diseaseModal').classList.remove('hidden');
    document.getElementById('modalTitle').textContent = 'Thêm Bệnh Lý Mới';
    document.getElementById('saveBtnText').textContent = 'Lưu';
}

function editDisease(id) {
    if(!isAdminUser) return;
    if (!id || id === 0) return;
    
    fetch(`/Disease/GetDiseaseById?id=${id}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                fillFormWithData(data.data);
                document.getElementById('diseaseModal').classList.remove('hidden');
                document.getElementById('modalTitle').textContent = 'Chỉnh Sửa Bệnh Lý';
                document.getElementById('saveBtnText').textContent = 'Cập Nhật';
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Lỗi khi lấy dữ liệu bệnh lý');
        });
}

function closeDiseaseModal() {
    if(!isAdminUser) return;
    document.getElementById('diseaseModal').classList.add('hidden');
    resetForm();
}

function confirmDeleteDisease(id, diseaseName) {
    if(!isAdminUser) return;
    if (!id || id === 0) return;
    currentDeleteId = id;
    currentDeleteName = diseaseName;
    document.getElementById('deleteItemName').textContent = diseaseName;
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    if(!isAdminUser) return;
    document.getElementById('deleteModal').classList.add('hidden');
    currentDeleteId = 0;
    currentDeleteName = '';
}

// Close modals when clicking outside
document.addEventListener('click', function(e) {
    if(!isAdminUser) return;
    const diseaseModal = document.getElementById('diseaseModal');
    const deleteModal = document.getElementById('deleteModal');
    
    if (e.target === diseaseModal) {
        diseaseModal.classList.add('hidden');
        resetForm();
    }
    if (e.target === deleteModal) {
        deleteModal.classList.add('hidden');
    }
});

// ===== Form Management =====
function resetForm() {
    if(!isAdminUser) return;
    const form = document.getElementById('diseaseForm');
    if(form) form.reset();
    document.getElementById('diseaseId').value = '0';
    document.getElementById('statusActive').checked = true;
    document.getElementById('formMessage').classList.add('hidden');
}

function fillFormWithData(data) {
    if(!isAdminUser) return;
    document.getElementById('diseaseId').value = data.id || 0;
    document.getElementById('diseaseName').value = data.name || '';
    document.getElementById('symptoms').value = data.symptoms || '';
    document.getElementById('causes').value = data.causes || '';
    document.getElementById('treatmentMethod').value = data.treatmentMethod || '';
    document.getElementById('description').value = data.description || '';
    
    if (data.isActive) {
        document.getElementById('statusActive').checked = true;
    } else {
        document.getElementById('statusInactive').checked = true;
    }
}

function saveDisease() {
    if(!isAdminUser) return;
    const form = document.getElementById('diseaseForm');
    
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const diseaseData = {
        id: parseInt(document.getElementById('diseaseId').value) || 0,
        name: document.getElementById('diseaseName').value,
        symptoms: document.getElementById('symptoms').value,
        causes: document.getElementById('causes').value,
        treatmentMethod: document.getElementById('treatmentMethod').value,
        description: document.getElementById('description').value,
        isActive: document.getElementById('statusActive').checked
    };

    const saveBtn = document.getElementById('saveDiseaseBtn');
    saveBtn.disabled = true;
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';

    fetch('/Disease/SaveDisease', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(diseaseData)
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;

        if (data.success) {
            showMessage(true, data.message);
            setTimeout(() => {
                closeDiseaseModal();
                location.reload();
            }, 1500);
        } else {
            showMessage(false, data.message || 'Lỗi không xác định');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        showMessage(false, 'Lỗi kết nối máy chủ');
    });
}

function deleteDiseaseConfirmed() {
    if(!isAdminUser || currentDeleteId === 0) return;

    const deleteBtn = document.getElementById('confirmDeleteBtn');
    deleteBtn.disabled = true;
    const originalText = deleteBtn.innerHTML;
    deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xóa...';

    fetch(`/Disease/DeleteDisease?id=${currentDeleteId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = originalText;

        if (data.success) {
            alert(data.message);
            closeDeleteModal();
            location.reload();
        } else {
            alert('Lỗi: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = originalText;
        alert('Lỗi kết nối máy chủ');
    });
}

function showMessage(isSuccess, message) {
    const messageDiv = document.getElementById('formMessage');
    if(!messageDiv) return;
    messageDiv.textContent = message;
    messageDiv.classList.remove('hidden');
    
    if (isSuccess) {
        messageDiv.className = 'px-4 py-3 rounded-lg text-sm font-medium bg-green-100 text-green-800';
    } else {
        messageDiv.className = 'px-4 py-3 rounded-lg text-sm font-medium bg-red-100 text-red-800';
    }
}

// ===== Search & Filter =====
function goToPage(page) {
    if (page < 1) return;
    
    const searchTerm = document.getElementById('diseaseSearch').value;
    const severity = document.getElementById('severityFilter').value;
    
    let url = `/Disease/Index?page=${page}`;
    if (searchTerm) url += `&searchTerm=${encodeURIComponent(searchTerm)}`;
    if (severity) url += `&severity=${encodeURIComponent(severity)}`;
    
    window.location.href = url;
}

function searchAndFilter() {
    goToPage(1);
}

// Search with debounce
document.getElementById('diseaseSearch').addEventListener('keyup', function(e) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        searchAndFilter();
    }, 500);
});

// Status filter change
document.getElementById('severityFilter').addEventListener('change', function(e) {
    searchAndFilter();
});
</script>