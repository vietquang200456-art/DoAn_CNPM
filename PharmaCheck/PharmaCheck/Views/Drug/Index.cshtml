@model PharmaCheck.Models.DrugPagedListViewModel

@{
    ViewData["Title"] = "Quản Lý Thuốc | PharmaCheck";
}

<!-- Page Header -->
<div class="bg-gradient-to-r from-medical-700 to-medical-600 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold flex items-center gap-3">
                    <i class="fas fa-pills"></i>
                    Quản Lý Thuốc
                </h1>
                <p class="text-blue-100 mt-2">Tạo, sửa, xóa và quản lý thông tin thuốc trong cơ sở dữ liệu</p>
            </div>
            <button onclick="openDrugModal()" class="bg-white text-medical-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors flex items-center gap-2">
                <i class="fas fa-plus"></i> Thêm Thuốc Mới
            </button>
        </div>
    </div>
</div>

<!-- Main Content -->
<section class="py-8 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Search & Filter Bar -->
        <div class="bg-white rounded-xl shadow-lg border border-slate-200 p-6 mb-8">
            <div class="grid md:grid-cols-3 gap-4">
                <!-- Search Input -->
                <div class="md:col-span-2">
                    <div class="relative">
                        <input type="text"
                               id="drugSearch"
                               placeholder="Tìm kiếm thuốc (tên, hoạt chất, mã)..."
                               class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                        <i class="fas fa-search absolute right-4 top-4 text-medical-600"></i>
                    </div>
                </div>

                <!-- Filter Status -->
                <div>
                    <select id="statusFilter" class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                        <option value="">Tất cả Trạng Thái</option>
                        <option value="active">Đang Hoạt Động</option>
                        <option value="inactive">Ngừng Hoạt Động</option>
                        <option value="restricted">Hạn Chế</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <!-- Table Head -->
                    <thead class="bg-medical-700 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-pills mr-2"></i>Tên Thuốc
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-flask mr-2"></i>Hoạt Chất
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-thermometer-half mr-2"></i>Liều Dùng
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-tag mr-2"></i>Nhà sản xuất
                            </th>
                            <th class="px-6 py-4 text-left font-semibold text-sm">
                                <i class="fas fa-circle text-sm mr-2"></i>Trạng Thái
                            </th>
                            <th class="px-6 py-4 text-center font-semibold text-sm">
                                <i class="fas fa-cog mr-2"></i>Hành Động
                            </th>
                        </tr>
                    </thead>

                    <!-- Table Body -->
                    <tbody class="divide-y divide-slate-200">
                        @if (Model.Drugs != null && Model.Drugs.Any())
                        {
                            @foreach (var drug in Model.Drugs)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="font-semibold text-gray-900">@drug.Name</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                                            @drug.ActiveIngredient
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">@drug.Dosage</td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm">
                                            <div>@drug.Manufacturer</div>
                                            <!-- Show created date in smaller text 
                                            <div class="text-gray-500 text-xs">@(drug.CreatedAt.ToString("dd/MM/yyyy"))</div>
                                            -->
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (drug.IsActive)
                                        {
                                            <span class="inline-flex items-center gap-2 bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
                                                <i class="fas fa-check-circle"></i>Đang Hoạt Động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-2 bg-gray-100 text-gray-800 px-3 py-1 rounded-full text-sm font-medium">
                                                <i class="fas fa-times-circle"></i>Ngừng Hoạt Động
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex justify-center gap-2">
                                            <button onclick="editDrug(@drug.Id)" class="bg-blue-100 text-blue-700 hover:bg-blue-200 p-2 rounded-lg transition-colors" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button onclick="viewDrug(@drug.Id)" class="bg-gray-100 text-gray-700 hover:bg-gray-200 p-2 rounded-lg transition-colors" title="Xem Chi Tiết">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button onclick="confirmDeleteDrug(@drug.Id, '@drug.Name')" class="bg-red-100 text-red-700 hover:bg-red-200 p-2 rounded-lg transition-colors" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                                    <i class="fas fa-inbox text-3xl mb-2 block opacity-50"></i>
                                    Không có thuốc nào để hiển thị
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Table Footer with Pagination -->
            <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex items-center justify-between flex-wrap gap-4">
                <div class="text-sm text-gray-600">
                    Hiển thị <span class="font-semibold">@((Model.CurrentPage - 1) * Model.PageSize + 1)-@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> 
                    của <span class="font-semibold">@Model.TotalRecords</span> thuốc
                </div>
                <div class="flex gap-2 flex-wrap">
                    <!-- Previous Button -->
                    <button onclick="goToPage(@(Model.CurrentPage - 1))" 
                            class="px-4 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            @if (!Model.HasPreviousPage) { <text>disabled</text> }>
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Math.Min(Model.TotalPages, 5); i++)
                    {
                        @if (i == Model.CurrentPage)
                        {
                            <button class="px-3 py-2 bg-medical-700 text-white rounded-lg">@i</button>
                        }
                        else
                        {
                            <button onclick="goToPage(@i)" class="px-3 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors">@i</button>
                        }
                    }

                    @if (Model.TotalPages > 5)
                    {
                        <span class="px-2 py-2">...</span>
                        <button onclick="goToPage(@Model.TotalPages)" class="px-3 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors">@Model.TotalPages</button>
                    }

                    <!-- Next Button -->
                    <button onclick="goToPage(@(Model.CurrentPage + 1))" 
                            class="px-4 py-2 border border-slate-300 rounded-lg text-gray-700 hover:bg-slate-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            @if (!Model.HasNextPage) { <text>disabled</text> }>
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add/Edit Drug Modal -->
<div id="drugModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="sticky top-0 bg-medical-700 text-white px-6 py-4 flex items-center justify-between border-b border-medical-600">
            <h2 class="text-2xl font-bold flex items-center gap-3">
                <i class="fas fa-pills"></i>
                <span id="modalTitle">Thêm Thuốc Mới</span>
            </h2>
            <button onclick="closeDrugModal()" class="text-white hover:bg-medical-600 p-2 rounded-lg transition-colors">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <form id="drugForm" class="p-6 space-y-4">
            <!-- Hidden ID Field -->
            <input type="hidden" id="drugId" value="0">

            <!-- Drug Name -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-pills text-medical-700 mr-2"></i>Tên Thuốc <span class="text-red-600">*</span>
                </label>
                <input type="text" id="drugName" placeholder="VD: Amoxicillin 500mg"
                       class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors"
                       required>
            </div>

            <!-- Active Ingredient -->
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-flask text-medical-700 mr-2"></i>Hoạt Chất
                    </label>
                    <input type="text" id="activeIngredient" placeholder="VD: Amoxicillin Trihydrate"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                </div>

                <!-- Dosage -->
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-weight text-medical-700 mr-2"></i>Liều Lượng
                    </label>
                    <input type="text" id="dosage" placeholder="VD: 500mg"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                </div>
            </div>

            <!-- Manufacturer -->
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-building text-medical-700 mr-2"></i>Nhà Sản Xuất
                    </label>
                    <input type="text" id="manufacturer" placeholder="VD: Công ty ABC"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                </div>

                <!-- Function -->
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-heartbeat text-medical-700 mr-2"></i>Công Dụng
                    </label>
                    <input type="text" id="function" placeholder="VD: Kháng sinh, chống viêm"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                </div>
            </div>

            <!-- Side Effects -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-exclamation text-medical-700 mr-2"></i>Tác Dụng Phụ
                </label>
                <textarea rows="2" id="sideEffects" placeholder="Nhập tác dụng phụ..."
                          class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
            </div>

            <!-- Contraindications -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-ban text-medical-700 mr-2"></i>Chống Chỉ Định
                </label>
                <textarea rows="2" id="contraindications" placeholder="Nhập chống chỉ định..."
                          class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
            </div>

            <!-- Description -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-align-left text-medical-700 mr-2"></i>Mô Tả / Ghi Chú
                </label>
                <textarea rows="3" id="description" placeholder="Nhập mô tả chi tiết..."
                          class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none"></textarea>
            </div>

            <!-- Status -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-circle text-medical-700 mr-2"></i>Trạng Thái
                </label>
                <div class="flex gap-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="isActive" id="statusActive" value="true" checked class="w-4 h-4">
                        <span class="text-gray-700">Đang Hoạt Động</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="isActive" id="statusInactive" value="false" class="w-4 h-4">
                        <span class="text-gray-700">Ngừng Hoạt Động</span>
                    </label>
                </div>
            </div>

            <!-- Message Area -->
            <div id="formMessage" class="hidden px-4 py-3 rounded-lg text-sm font-medium"></div>
        </form>

        <!-- Modal Footer -->
        <div class="sticky bottom-0 bg-slate-50 border-t border-slate-200 px-6 py-4 flex gap-3 justify-end">
            <button onclick="closeDrugModal()"
                    class="px-6 py-3 border-2 border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-50 transition-colors">
                Hủy
            </button>
            <button onclick="saveDrug()" id="saveDrugBtn"
                    class="px-6 py-3 bg-medical-700 text-white rounded-lg font-semibold hover:bg-medical-800 transition-colors flex items-center gap-2">
                <i class="fas fa-save"></i> <span id="saveBtnText">Lưu</span>
            </button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full">
        <div class="p-6">
            <div class="flex items-center justify-center w-12 h-12 mx-auto bg-red-100 rounded-full mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
            </div>
            <h3 class="text-xl font-bold text-center text-gray-900 mb-2">Xác Nhận Xóa</h3>
            <p class="text-center text-gray-600 mb-6">
                Bạn chắc chắn muốn xóa <span id="deleteItemName" class="font-semibold"></span>? Hành động này không thể hoàn tác.
            </p>
        </div>
        <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex gap-3 justify-end">
            <button onclick="closeDeleteModal()"
                    class="px-6 py-2 border border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-50 transition-colors">
                Hủy
            </button>
            <button onclick="deleteDrugConfirmed()" id="confirmDeleteBtn"
                    class="px-6 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-colors flex items-center gap-2">
                <i class="fas fa-trash"></i> Xóa
            </button>
        </div>
    </div>
</div>

<!-- JavaScript Functions -->
<script>
let currentDeleteId = 0;
let currentDeleteName = '';
let isSearching = false;
let searchTimeout;

// ===== Modal Management =====
function openDrugModal() {
    resetForm();
    document.getElementById('drugModal').classList.remove('hidden');
    document.getElementById('modalTitle').textContent = 'Thêm Thuốc Mới';
    document.getElementById('saveBtnText').textContent = 'Lưu';
}

function editDrug(id) {
    if (!id || id === 0) return;
    
    // Fetch drug data
    fetch(`/Drug/GetDrugById?id=${id}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                fillFormWithData(data.data);
                document.getElementById('drugModal').classList.remove('hidden');
                document.getElementById('modalTitle').textContent = 'Chỉnh Sửa Thuốc';
                document.getElementById('saveBtnText').textContent = 'Cập Nhật';
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Lỗi khi lấy dữ liệu thuốc');
        });
}

function viewDrug(id) {
    if (!id || id === 0) return;
    alert('Chức năng xem chi tiết sẽ được triển khai');
}

function closeDrugModal() {
    document.getElementById('drugModal').classList.add('hidden');
    resetForm();
}

function confirmDeleteDrug(id, drugName) {
    if (!id || id === 0) return;
    currentDeleteId = id;
    currentDeleteName = drugName;
    document.getElementById('deleteItemName').textContent = drugName;
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    currentDeleteId = 0;
    currentDeleteName = '';
}

// Close modals when clicking outside
document.addEventListener('click', function(e) {
    const drugModal = document.getElementById('drugModal');
    const deleteModal = document.getElementById('deleteModal');
    
    if (e.target === drugModal) {
        drugModal.classList.add('hidden');
        resetForm();
    }
    if (e.target === deleteModal) {
        deleteModal.classList.add('hidden');
    }
});

// ===== Form Management =====
function resetForm() {
    document.getElementById('drugForm').reset();
    document.getElementById('drugId').value = '0';
    document.getElementById('statusActive').checked = true;
    document.getElementById('formMessage').classList.add('hidden');
}

function fillFormWithData(data) {
    document.getElementById('drugId').value = data.id || 0;
    document.getElementById('drugName').value = data.name || '';
    document.getElementById('activeIngredient').value = data.activeIngredient || '';
    document.getElementById('dosage').value = data.dosage || '';
    document.getElementById('manufacturer').value = data.manufacturer || '';
    document.getElementById('function').value = data.function || '';
    document.getElementById('sideEffects').value = data.sideEffects || '';
    document.getElementById('contraindications').value = data.contraindications || '';
    document.getElementById('description').value = data.description || '';
    
    if (data.isActive) {
        document.getElementById('statusActive').checked = true;
    } else {
        document.getElementById('statusInactive').checked = true;
    }
}

function saveDrug() {
    const form = document.getElementById('drugForm');
    
    // Validate form
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const drugData = {
        id: parseInt(document.getElementById('drugId').value) || 0,
        name: document.getElementById('drugName').value,
        activeIngredient: document.getElementById('activeIngredient').value,
        dosage: document.getElementById('dosage').value,
        manufacturer: document.getElementById('manufacturer').value,
        function: document.getElementById('function').value,
        sideEffects: document.getElementById('sideEffects').value,
        contraindications: document.getElementById('contraindications').value,
        description: document.getElementById('description').value,
        isActive: document.getElementById('statusActive').checked
    };

    // Disable button and show loading
    const saveBtn = document.getElementById('saveDrugBtn');
    saveBtn.disabled = true;
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';

    fetch('/Drug/SaveDrug', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(drugData)
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;

        if (data.success) {
            showMessage(true, data.message);
            setTimeout(() => {
                closeDrugModal();
                location.reload(); // Reload to show updated list
            }, 1500);
        } else {
            showMessage(false, data.message || 'Lỗi không xác định');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        showMessage(false, 'Lỗi kết nối máy chủ');
    });
}

function deleteDrugConfirmed() {
    if (currentDeleteId === 0) return;

    const deleteBtn = document.getElementById('confirmDeleteBtn');
    deleteBtn.disabled = true;
    const originalText = deleteBtn.innerHTML;
    deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xóa...';

    fetch(`/Drug/DeleteDrug?id=${currentDeleteId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = originalText;

        if (data.success) {
            alert(data.message);
            closeDeleteModal();
            location.reload(); // Reload to show updated list
        } else {
            alert('Lỗi: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        deleteBtn.disabled = false;
        deleteBtn.innerHTML = originalText;
        alert('Lỗi kết nối máy chủ');
    });
}

function showMessage(isSuccess, message) {
    const messageDiv = document.getElementById('formMessage');
    messageDiv.textContent = message;
    messageDiv.classList.remove('hidden');
    
    if (isSuccess) {
        messageDiv.className = 'px-4 py-3 rounded-lg text-sm font-medium bg-green-100 text-green-800';
    } else {
        messageDiv.className = 'px-4 py-3 rounded-lg text-sm font-medium bg-red-100 text-red-800';
    }
}

// ===== Search & Filter =====
function goToPage(page) {
    if (page < 1) return;
    
    const searchTerm = document.getElementById('drugSearch').value;
    const status = document.getElementById('statusFilter').value;
    
    let url = `/Drug/Index?page=${page}`;
    if (searchTerm) url += `&searchTerm=${encodeURIComponent(searchTerm)}`;
    if (status) url += `&status=${encodeURIComponent(status)}`;
    
    window.location.href = url;
}

function searchAndFilter() {
    goToPage(1);
}

// Search with debounce
document.getElementById('drugSearch').addEventListener('keyup', function(e) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        searchAndFilter();
    }, 500);
});

// Status filter change
document.getElementById('statusFilter').addEventListener('change', function(e) {
    searchAndFilter();
});
</script>
