@model PharmaCheck.Models.DrugPagedListViewModel

@{
    ViewData["Title"] = "Danh Mục Thuốc | PharmaCheck";
    // ĐỔI TẠI ĐÂY: Cho phép cả Admin và Pharmacist được hiển thị các tính năng chỉnh sửa dữ liệu 🌟
    bool isManager = User.IsInRole("Admin") || User.IsInRole("Pharmacist");
}

@* Antiforgery Token bảo vệ các request AJAX POST *@
@Html.AntiForgeryToken()

<div class="relative bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-800 text-white py-12 overflow-hidden shadow-lg">
    <div class="absolute top-0 right-0 -mt-12 -mr-12 w-64 h-64 bg-white opacity-5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-16 -ml-16 w-72 h-72 bg-blue-400 opacity-10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div class="space-y-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-white/10 text-blue-100 uppercase tracking-wider border border-white/10">
                    <i class="fas fa-database text-emerald-400"></i> Cơ sở dữ liệu hiện hành
                </span>
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight flex items-center gap-3">
                    <i class="fas fa-pills text-blue-300 animate-pulse"></i>
                    Quản Lý Danh Mục Thuốc
                </h1>
                <p class="text-blue-100 max-w-2xl font-light text-sm sm:text-base leading-relaxed">
                    @(isManager ? "Hệ thống quản trị danh mục: Hỗ trợ khởi tạo, hiệu chỉnh, khóa hoặc loại bỏ thông tin các hoạt chất lâm sàng." : "Trung tâm tra cứu y khoa công cộng: Hỗ trợ rà soát thông tin chi tiết và cơ chế dược lý của các nhóm biệt dược.")
                </p>
            </div>
            
            @if (isManager)
            {
                <div class="shrink-0">
                    <button onclick="openDrugModal()"
                            class="inline-flex items-center gap-2.5 bg-white text-blue-700 px-6 py-3.5 rounded-xl font-bold text-sm hover:bg-blue-50 hover:scale-[1.02] transition-all duration-300 cursor-pointer shadow-xl hover:shadow-white/10">
                        <i class="fas fa-plus text-base"></i> Thêm Thuốc Mới
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@if (isManager)
{
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-emerald-50 border border-emerald-200 p-4 rounded-2xl shadow-sm">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-emerald-600 rounded-xl text-white shadow-md shadow-emerald-600/10 shrink-0">
                    <i class="fas fa-file-excel text-lg"></i>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-slate-900">Nhập danh mục thuốc nhanh từ Excel</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Hệ thống sẽ tự động đối chiếu tên thuốc, cập nhật hoạt chất mới và bỏ qua dữ liệu trùng.</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 flex-wrap md:flex-nowrap">
                <input type="file" id="excelFileInput" accept=".xlsx" 
                       class="text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-white file:text-emerald-700 file:shadow-sm file:border-slate-200 hover:file:bg-slate-100 transition cursor-pointer border border-dashed border-emerald-300 p-1.5 rounded-xl bg-white/50 w-full sm:w-auto" />
                <button type="button" id="uploadExcelBtn" onclick="uploadExcelFile()" 
                        class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-5 py-3 rounded-xl transition duration-200 shadow-md hover:shadow-emerald-600/20 active:scale-[0.98] cursor-pointer whitespace-nowrap">
                    <i class="fas fa-cloud-upload-alt mr-1"></i> Xác nhận nạp dữ liệu
                </button>
            </div>
        </div>
    </div>
}

<section id="features" class="py-8 bg-slate-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-1 overflow-hidden">
            <partial name="~/Views/Drug/listdrug.cshtml" />
        </div>
    </div>
</section>

@if (isManager)
{
    <section id="features" class="py-12 bg-white border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <partial name="~/Views/Drug/adddrug.cshtml" />
        </div>
    </section>

    <div id="deleteModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 transition-all duration-300">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden border border-slate-100 transform scale-100 transition-transform">
            <div class="p-6 text-center">
                <div class="flex items-center justify-center w-14 h-14 mx-auto bg-red-50 text-red-600 rounded-full mb-4 shadow-inner">
                    <i class="fas fa-exclamation-triangle text-2xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Xác Nhận Xóa Hoạt Chất</h3>
                <p class="text-gray-500 text-sm leading-relaxed px-2">
                    Bạn chắc chắn muốn xóa biệt dược <span id="deleteItemName" class="font-semibold text-gray-800 underline decoration-red-500 decoration-2"></span>? Hành động này sẽ loại bỏ dữ liệu khỏi hệ thống và không thể hoàn tác.
                </p>
            </div>
            <div class="bg-slate-50 px-6 py-4 flex gap-3 justify-end border-t border-slate-100">
                <button onclick="closeDeleteModal()"
                        class="px-5 py-2.5 border border-slate-300 text-slate-700 bg-white rounded-xl font-semibold text-sm hover:bg-slate-50 hover:text-slate-900 transition-all duration-200 cursor-pointer">
                    Hủy Bỏ
                </button>
                <button onclick="deleteDrugConfirmed()" id="confirmDeleteBtn"
                        class="px-5 py-2.5 bg-red-600 text-white rounded-xl font-semibold text-sm hover:bg-red-700 hover:shadow-lg hover:shadow-red-600/20 transition-all duration-200 flex items-center gap-2 cursor-pointer">
                    <i class="fas fa-trash-alt text-xs"></i> Đồng Ý Xóa
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Cầu nối truyền trạng thái phân quyền từ Razor sang file JS độc lập 🌟
        // Sử dụng isManager để tệp Javascript biết tài khoản Dược sĩ cũng có quyền sửa/xóa
        window.IS_ADMIN = @(isManager ? "true" : "false");
    </script>
    <script src="~/js/drug-index.js" asp-append-version="true"></script>
}