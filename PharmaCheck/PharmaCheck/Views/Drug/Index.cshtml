@model PharmaCheck.Models.DrugPagedListViewModel

@{
    ViewData["Title"] = "Quản Lý Thuốc | PharmaCheck";
}

<div class="bg-gradient-to-r from-medical-700 to-medical-600 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold flex items-center gap-3">
                    <i class="fas fa-pills"></i>
                    Quản Lý Thuốc
                </h1>
                <p class="text-blue-100 mt-2">Tạo, sửa, xóa và quản lý thông tin thuốc trong cơ sở dữ liệu</p>
            </div>
            <button onclick="openDrugModal()"
                    class="bg-white text-medical-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors flex items-center gap-2">
                <i class="fas fa-plus"></i> Thêm Thuốc Mới
            </button>
        </div>
    </div>
</div>

<section id="features" class="py-12 bg-white border-t border-slate-200">
    <partial name="~/Views/Drug/listdrug.cshtml" />
</section>

<section id="features" class="py-12 bg-white border-t border-slate-200">
    <partial name="~/Views/Drug/adddrug.cshtml" />
</section>

<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full">
        <div class="p-6">
            <div class="flex items-center justify-center w-12 h-12 mx-auto bg-red-100 rounded-full mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
            </div>
            <h3 class="text-xl font-bold text-center text-gray-900 mb-2">Xác Nhận Xóa</h3>
            <p class="text-center text-gray-600 mb-6">
                Bạn chắc chắn muốn xóa <span id="deleteItemName" class="font-semibold"></span>? Hành động này không thể hoàn tác.
            </p>
        </div>
        <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex gap-3 justify-end">
            <button onclick="closeDeleteModal()"
                    class="px-6 py-2 border border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-50 transition-colors">
                Hủy
            </button>
            <button onclick="deleteDrugConfirmed()" id="confirmDeleteBtn"
                    class="px-6 py-2 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-colors flex items-center gap-2">
                <i class="fas fa-trash"></i> Xóa
            </button>
        </div>
    </div>
</div>

<script>
    // ==========================================
    // KHAI BÁO BIẾN TOÀN CỤC (GLOBAL VARIABLES)
    // ==========================================
    let currentDeleteId = 0;      // Lưu trữ ID của thuốc đang được chọn để chuẩn bị xóa
    let currentDeleteName = '';    // Lưu trữ tên của thuốc đang được chọn để chuẩn bị xóa
    let isSearching = false;       // Cờ trạng thái kiểm soát tiến trình tìm kiếm (nếu cần mở rộng)
    // Đã loại bỏ biến "searchTimeout" vì không dùng cơ chế tự động tìm kiếm (Debounce) nữa.

    // ==========================================
    // QUẢN LÝ MODAL THÊM/SỬA THUỐC
    // ==========================================
    
    /**
     * Mở modal để tạo mới một loại thuốc
     */
    function openDrugModal() {
        resetForm(); // Làm sạch form nhập liệu cũ
        document.getElementById('drugModal').classList.remove('hidden'); // Hiển thị Modal
        document.getElementById('modalTitle').textContent = 'Thêm Thuốc Mới'; // Đổi tiêu đề Modal
        document.getElementById('saveBtnText').textContent = 'Lưu'; // Đổi chữ nút Lưu
    }

    /**
     * Lấy dữ liệu thuốc từ Server và mở modal để chỉnh sửa
     */
    function editDrug(id) {
        if (!id || id === 0) return;

        // Gọi API lấy dữ liệu chi tiết của thuốc dựa vào ID
        fetch(`/Drug/GetDrugById?id=${id}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    fillFormWithData(data.data); // Đổ dữ liệu lấy được vào form nhập liệu
                    document.getElementById('drugModal').classList.remove('hidden'); // Hiện Modal
                    document.getElementById('modalTitle').textContent = 'Chỉnh Sửa Thuốc'; // Cập nhật tiêu đề Modal
                    document.getElementById('saveBtnText').textContent = 'Cập Nhật'; // Cập nhật nhãn nút bấm
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Lỗi khi lấy dữ liệu thuốc từ hệ thống');
            });
    }

    /**
     * Xem chi tiết thông tin thuốc (Hàm chờ phát triển)
     */
    function viewDrug(id) {
        if (!id || id === 0) return;
        alert('Chức năng xem chi tiết sẽ được triển khai trong phiên bản tiếp theo');
    }

    /**
     * Đóng modal thêm/sửa thuốc và dọn dẹp form nhập liệu
     */
    function closeDrugModal() {
        document.getElementById('drugModal').classList.add('hidden'); // Ẩn Modal bằng cách thêm class hidden
        resetForm(); // Đưa form về trạng thái trống ban đầu
    }

    // ==========================================
    // QUẢN LÝ MODAL XÁC NHẬN XÓA
    // ==========================================

    /**
     * Kích hoạt hiển thị Modal cảnh báo trước khi thực hiện xóa thuốc
     * param {number} id - ID của bản ghi thuốc cần xóa
     * param {string} drugName - Tên hiển thị của thuốc cần xóa
     */
    function confirmDeleteDrug(id, drugName) {
        if (!id || id === 0) return;
        currentDeleteId = id; // Gán ID vào biến toàn cục để hàm xác nhận xóa sử dụng
        currentDeleteName = drugName;
        document.getElementById('deleteItemName').textContent = drugName; // Hiển thị tên thuốc lên Modal giao diện
        document.getElementById('deleteModal').classList.remove('hidden'); // Hiển thị Modal xác nhận xóa
    }

    /**
     * Đóng modal xác nhận xóa và giải phóng thông tin tạm thời
     */
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden'); // Ẩn Modal xóa
        currentDeleteId = 0; // Khôi phục ID tạm thời về trạng thái mặc định
        currentDeleteName = '';
    }

    /**
     * Lắng nghe sự kiện click trên toàn bộ văn bản để đóng các Modal khi người dùng click ra vùng trống bên ngoài
     */
    document.addEventListener('click', function (e) {
        const drugModal = document.getElementById('drugModal');
        const deleteModal = document.getElementById('deleteModal');

        // Nếu phần tử click trúng chính là thẻ bọc nền mờ của modal thì thực hiện ẩn đi
        if (e.target === drugModal) {
            drugModal.classList.add('hidden');
            resetForm();
        }
        if (e.target === deleteModal) {
            deleteModal.classList.add('hidden');
        }
    });

    // ==========================================
    // QUẢN LÝ FORM VÀ ĐỒNG BỘ DỮ LIỆU
    // ==========================================

    /**
     * Làm mới toàn bộ các trường nhập liệu trong form về trạng thái ban đầu
     */
    function resetForm() {
        document.getElementById('drugForm').reset(); // Reset nhanh bằng hàm built-in của thẻ Form
        document.getElementById('drugId').value = '0'; // Đặt ID ẩn về 0 biểu thị cho hành động thêm mới
        document.getElementById('statusActive').checked = true; // Trạng thái mặc định là Đang hoạt động
        document.getElementById('formMessage').classList.add('hidden'); // Ẩn phân vùng thông báo lỗi/thành công
    }

    /**
     * Đổ dữ liệu từ Object nhận được từ API vào lại các ô nhập liệu trong form (dành cho Edit)
     * param {Object} data - Đối tượng chứa thông tin chi tiết thuốc
     */
    function fillFormWithData(data) {
        document.getElementById('drugId').value = data.id || 0;
        document.getElementById('drugName').value = data.name || '';
        document.getElementById('activeIngredient').value = data.activeIngredient || '';
        document.getElementById('dosage').value = data.dosage || '';
        document.getElementById('manufacturer').value = data.manufacturer || '';
        document.getElementById('function').value = data.function || '';
        document.getElementById('sideEffects').value = data.sideEffects || '';
        document.getElementById('contraindications').value = data.contraindications || '';
        document.getElementById('description').value = data.description || '';

        // Kiểm tra trạng thái hoạt động để check đúng radio button tương ứng
        if (data.isActive) {
            document.getElementById('statusActive').checked = true;
        } else {
            document.getElementById('statusInactive').checked = true;
        }
    }

    /**
     * Đọc thông tin từ form, validate dữ liệu đầu vào và gửi dữ liệu lên Server để Lưu hoặc Cập nhật
     */
    function saveDrug() {
        const form = document.getElementById('drugForm');

        // Kiểm tra tính hợp lệ của Form theo các ràng buộc HTML5 (như thuộc tính 'required')
        if (!form.checkValidity()) {
            form.reportValidity(); // Tự động hiển thị bong bóng cảnh báo của trình duyệt tại ô trống
            return;
        }

        // Tạo object chứa toàn bộ dữ liệu từ form chuẩn bị gửi đi JSON
        const drugData = {
            id: parseInt(document.getElementById('drugId').value) || 0,
            name: document.getElementById('drugName').value,
            activeIngredient: document.getElementById('activeIngredient').value,
            dosage: document.getElementById('dosage').value,
            manufacturer: document.getElementById('manufacturer').value,
            function: document.getElementById('function').value,
            sideEffects: document.getElementById('sideEffects').value,
            contraindications: document.getElementById('contraindications').value,
            description: document.getElementById('description').value,
            isActive: document.getElementById('statusActive').checked
        };

        // Khóa nút bấm lại nhằm tránh việc người dùng nhấp chuột liên tục (Spam click) tạo trùng lặp bản ghi
        const saveBtn = document.getElementById('saveDrugBtn');
        saveBtn.disabled = true;
        const originalText = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...'; // Thêm hiệu ứng quay tròn chờ tải

        // Tiến hành gọi API gửi dữ liệu lên Server xử lý
        fetch('/Drug/SaveDrug', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(drugData)
        })
            .then(response => response.json())
            .then(data => {
                // Khôi phục lại trạng thái ban đầu của nút bấm sau khi nhận phản hồi từ Server
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalText;

                if (data.success) {
                    showMessage(true, data.message); // Hiển thị thanh thông báo xanh thành công
                    setTimeout(() => {
                        closeDrugModal();
                        location.reload(); // Tải lại trang sau 1.5 giây để cập nhật dữ liệu mới nhất lên bảng hiển thị
                    }, 1500);
                } else {
                    showMessage(false, data.message || 'Lỗi không xác định xảy ra từ Server');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalText;
                showMessage(false, 'Mất kết nối tới máy chủ. Vui lòng thử lại sau.');
            });
    }

    /**
     * Gửi yêu cầu xóa bản ghi lên Server sau khi người dùng đã xác nhận đồng ý xóa
     */
    function deleteDrugConfirmed() {
        if (currentDeleteId === 0) return;

        const deleteBtn = document.getElementById('confirmDeleteBtn');
        deleteBtn.disabled = true; // Khóa nút xóa
        const originalText = deleteBtn.innerHTML;
        deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xóa...';

        // Gọi API xóa thực tế
        fetch(`/Drug/DeleteDrug?id=${currentDeleteId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
            .then(response => response.json())
            .then(data => {
                deleteBtn.disabled = false;
                deleteBtn.innerHTML = originalText;

                if (data.success) {
                    alert(data.message);
                    closeDeleteModal();
                    location.reload(); // Tải lại trang để cập nhật danh sách mất đi phần tử đã bị xóa
                } else {
                    alert('Lỗi hệ thống: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                deleteBtn.disabled = false;
                deleteBtn.innerHTML = originalText;
                alert('Không thể thực hiện kết nối máy chủ để xóa thuốc');
            });
    }

    /**
     * Hiển thị thanh thông báo trạng thái đẹp mắt ngay bên trong Form Modal
     * param {boolean} isSuccess - Đạt trạng thái thành công (true) hay thất bại (false)
     * param {string} message - Nội dung chuỗi thông báo hiển thị tới người dùng
     */
    function showMessage(isSuccess, message) {
        const messageDiv = document.getElementById('formMessage');
        messageDiv.textContent = message;
        messageDiv.classList.remove('hidden');

        if (isSuccess) {
            messageDiv.className = 'px-4 py-3 rounded-lg text-sm font-medium bg-green-100 text-green-800'; // Theme xanh lá
        } else {
            messageDiv.className = 'px-4 py-3 rounded-lg text-sm font-medium bg-red-100 text-red-800';     // Theme đỏ cảnh báo
        }
    }

    // ==========================================
    // LOGIC XỬ LÝ TÌM KIẾM VÀ BỘ LỌC (SEARCH & FILTER)
    // ==========================================

    /**
     * Điều hướng trang kèm theo các tham số tìm kiếm và bộ lọc trạng thái hiện tại
     * param {number} page - Số trang cần chuyển đến (Ví dụ: Trang 1, Trang 2...)
     */
    function goToPage(page) {
        if (page < 1) return;

        // Thu thập giá trị hiện có trong các ô input lọc ngoài giao diện tại thời điểm kích hoạt hàm
        const searchTerm = document.getElementById('drugSearch').value;
        const status = document.getElementById('statusFilter').value;

        // Thiết lập URL cơ sở điều hướng tới Action Index trong Controller Drug
        let url = `/Drug/Index?page=${page}`;
        
        // Nối chuỗi điều kiện tìm kiếm và mã hóa an toàn dữ liệu đầu vào tránh lỗi URL (encodeURIComponent)
        if (searchTerm) url += `&searchTerm=${encodeURIComponent(searchTerm.trim())}`;
        if (status) url += `&status=${encodeURIComponent(status)}`;

        // Thực hiện chuyển trang thực tế
        window.location.href = url;
    }

    /**
     * Hàm trung gian kích hoạt việc tìm kiếm, mặc định đưa người dùng quay trở lại trang 1
     */
    function searchAndFilter() {
        goToPage(1);
    }

    // --- ĐÃ THAY ĐỔI CƠ CHẾ LẮNG NGHE SỰ KIỆN TÌM KIẾM THEO YÊU CẦU ---

    /**
     * Lắng nghe sự kiện người dùng nhấn phím trong ô Input tìm kiếm thuốc mã hiệu 'drugSearch'
     * Thao tác: Ngừng theo dõi sự kiện liên tục gõ 'keyup' tự động chạy cũ, thay bằng chỉ kiểm tra phím Enter.
     */
    document.getElementById('drugSearch').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault(); // Ngăn chặn sự kiện submit form mặc định (tránh reload trang ngoài kiểm soát)
            searchAndFilter();  // Thực hiện tìm kiếm theo Keyword hiện tại
        }
    });

    /**
     * Lắng nghe sự kiện Thay đổi giá trị của bộ chọn Trạng Thái (dropdown list lọc hoạt động)
     * Thao tác: Tự động chạy lại tìm kiếm lọc ngay lập tức khi người dùng click chọn trạng thái khác để tiện trải nghiệm.
     */
    document.getElementById('statusFilter').addEventListener('change', function (e) {
        searchAndFilter();
    });
</script>