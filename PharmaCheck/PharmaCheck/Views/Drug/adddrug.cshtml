@model PharmaCheck.Models.DrugPagedListViewModel

<div id="drugModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-medical-700 text-white px-6 py-4 flex items-center justify-between border-b border-medical-600 z-10">
            <h2 class="text-2xl font-bold flex items-center gap-3">
                <i class="fas fa-pills"></i>
                <span id="modalTitle">Thêm Thuốc Mới</span>
            </h2>
            <button onclick="closeDrugModal()" class="text-white hover:bg-medical-600 p-2 rounded-lg transition-colors">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <form id="drugForm" class="p-6 space-y-4" onsubmit="event.preventDefault();">
            <input type="hidden" id="drugId" name="Id" value="0">

            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-pills text-medical-700 mr-2"></i>Tên Thuốc <span class="text-red-600">*</span>
                </label>
                <input type="text" id="drugName" name="Name" placeholder="VD: Paracetamol 500mg"
                       class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors" required>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-flask text-medical-700 mr-2"></i>Hoạt Chất <span class="text-red-600">*</span>
                    </label>
                    <input type="text" id="activeIngredient" name="ActiveIngredient" placeholder="VD: Paracetamol"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors" required>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-weight text-medical-700 mr-2"></i>Liều Lượng <span class="text-red-600">*</span>
                    </label>
                    <input type="text" id="dosage" name="Dosage" placeholder="VD: 500mg"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors" required>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-building text-medical-700 mr-2"></i>Nhà Sản Xuất <span class="text-red-600">*</span>
                    </label>
                    <input type="text" id="manufacturer" name="Manufacturer" placeholder="VD: Dược Hậu Giang"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors" required>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">
                        <i class="fas fa-heartbeat text-medical-700 mr-2"></i>Công Dụng <span class="text-red-600">*</span>
                    </label>
                    <input type="text" id="drugUse" name="drugUse" placeholder="VD: Giảm đau, hạ sốt"
                           class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors" required>
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-exclamation text-medical-700 mr-2"></i>Tác Dụng Phụ <span class="text-red-600">*</span>
                </label>
                <textarea rows="2" id="sideEffects" name="SideEffects" placeholder="Nhập các tác dụng phụ..."
                          class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none" required></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-ban text-medical-700 mr-2"></i>Chống Chỉ Định <span class="text-red-600">*</span>
                </label>
                <textarea rows="2" id="contraindications" name="Contraindications" placeholder="Nhập các trường hợp chống chỉ định..."
                          class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none" required></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-align-left text-medical-700 mr-2"></i>Mô Tả / Ghi Chú <span class="text-red-600">*</span>
                </label>
                <textarea rows="3" id="description" name="Description" placeholder="Nhập mô tả chi tiết hoặc hướng dẫn bảo quản..."
                          class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors resize-none" required></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">
                    <i class="fas fa-circle text-medical-700 mr-2"></i>Trạng Thái
                </label>
                <div class="flex gap-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="isActive" id="statusActive" value="true" checked class="w-4 h-4 text-medical-600 focus:ring-medical-500">
                        <span class="text-gray-700 font-medium">Đang Hoạt Động</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="isActive" id="statusInactive" value="false" class="w-4 h-4 text-medical-600 focus:ring-medical-500">
                        <span class="text-gray-700 font-medium">Ngừng Hoạt Động</span>
                    </label>
                </div>
            </div>

            <div id="formMessage" class="hidden px-4 py-3 rounded-lg text-sm font-medium border"></div>
        </form>

        <div class="sticky bottom-0 bg-slate-50 border-t border-slate-200 px-6 py-4 flex gap-3 justify-end z-10">
            <button onclick="closeDrugModal()"
                    class="px-6 py-3 border-2 border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-100 transition-colors">
                Hủy
            </button>
            <button onclick="saveDrug()" id="saveDrugBtn"
                    class="px-6 py-3 bg-medical-700 text-white rounded-lg font-semibold hover:bg-medical-800 transition-colors flex items-center gap-2">
                <i class="fas fa-save"></i> <span id="saveBtnText">Lưu</span>
            </button>
        </div>
    </div>
</div>