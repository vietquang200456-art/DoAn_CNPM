@model PharmaCheck.Models.DrugPagedListViewModel

<div id="drugModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4 transition-opacity duration-200">
    <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[85vh] flex flex-col border border-slate-200 transform scale-100 transition-transform duration-200">
        
        <div class="bg-slate-900 text-white px-6 py-4.5 flex items-center justify-between border-b border-slate-800 rounded-t-2xl">
            <div class="flex items-center gap-2.5">
                <i class="fas fa-pills text-emerald-400"></i>
                <h2 class="text-lg font-bold tracking-tight" id="modalTitle">Thêm Thuốc Mới</h2>
            </div>
            <button onclick="closeDrugModal()" class="text-slate-400 hover:text-white hover:bg-slate-800 w-8 h-8 rounded-lg flex items-center justify-center transition-colors cursor-pointer">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="drugForm" class="p-6 space-y-4 overflow-y-auto flex-1 text-sm">
            <input type="hidden" id="drugId" name="Id" value="0">

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tên Thuốc <span class="text-red-500">*</span></label>
                <input type="text" id="drugName" name="Name" placeholder="VD: Paracetamol 500mg..."
                       class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800" required>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Hoạt Chất <span class="text-red-500">*</span></label>
                    <input type="text" id="activeIngredient" name="ActiveIngredient" placeholder="VD: Paracetamol"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Liều Lượng <span class="text-red-500">*</span></label>
                    <input type="text" id="dosage" name="Dosage" placeholder="VD: 500mg"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800" required>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nhà Sản Xuất <span class="text-red-500">*</span></label>
                    <input type="text" id="manufacturer" name="Manufacturer" placeholder="VD: Dược Hậu Giang"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Công Dụng <span class="text-red-500">*</span></label>
                    <input type="text" id="drugUse" name="drugUse" placeholder="VD: Giảm đau, hạ sốt"
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800" required>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tác Dụng Phụ <span class="text-red-500">*</span></label>
                <textarea rows="2" id="sideEffects" name="SideEffects" placeholder="Nhập các tác dụng phụ..."
                          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none" required></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Chống Chỉ Định <span class="text-red-500">*</span></label>
                <textarea rows="2" id="contraindications" name="Contraindications" placeholder="Nhập trường hợp chống chỉ định..."
                          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none" required></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Mô Tả / Ghi Chú <span class="text-red-500">*</span></label>
                <textarea rows="3" id="description" name="Description" placeholder="Mô tả chi tiết hoặc hướng dẫn bảo quản..."
                          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 focus:bg-white font-medium text-slate-800 resize-none" required></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Trạng Thái</label>
                <div class="flex gap-6 mt-1">
                    <label class="flex items-center gap-2 cursor-pointer group font-medium text-slate-700">
                        <input type="radio" name="isActive" id="statusActive" value="true" checked class="w-4 h-4 accent-slate-900">
                        <span class="group-hover:text-slate-900 transition-colors">Đang Hoạt Động</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer group font-medium text-slate-700">
                        <input type="radio" name="isActive" id="statusInactive" value="false" class="w-4 h-4 accent-slate-900">
                        <span class="group-hover:text-slate-900 transition-colors">Ngừng Hoạt Động</span>
                    </label>
                </div>
            </div>

            <div id="formMessage" class="hidden px-4 py-3 rounded-xl font-semibold text-center"></div>
        </form>

        <div class="bg-slate-50 border-t border-slate-100 px-6 py-4 flex gap-2.5 justify-end rounded-b-2xl">
            <button onclick="closeDrugModal()"
                    class="px-5 py-2.5 border border-slate-200 text-slate-700 rounded-xl font-bold hover:bg-slate-100 transition-colors cursor-pointer">
                Hủy bỏ
            </button>
            <button onclick="saveDrug()" id="saveDrugBtn"
                    class="px-5 py-2.5 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-colors flex items-center gap-2 shadow-sm cursor-pointer">
                <i class="fas fa-check text-xs"></i> <span id="saveBtnText">Xác nhận</span>
            </button>
        </div>
    </div>
</div>