@model PharmaCheck.Models.DrugPagedListViewModel

@{
    // Kiểm tra quyền Admin tại tầng giao diện danh sách
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("Pharmacist");
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-4 mb-6">
        <div class="md:col-span-2">
            <div class="relative group">
                <input type="text" id="drugSearch" placeholder="Tìm kiếm thuốc (tên, hoạt chất, nhà sản xuất)..."
                       value="@Model.SearchTerm"
                       class="w-full pl-11 pr-4 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all duration-200 text-sm placeholder-slate-400 shadow-sm">
                <i class="fas fa-search absolute left-4 top-3.5 text-slate-400 group-focus-within:text-blue-600 transition-colors"></i>
            </div>
        </div>

        <div>
            <div class="relative">
                <select id="statusFilter"
                        class="w-full pl-4 pr-10 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all duration-200 text-sm text-slate-700 shadow-sm appearance-none cursor-pointer">
                    <option value="">Tất cả Trạng Thái</option>
                    <option value="active" selected="@(Model.StatusFilter?.ToLower() == "active")">Đang Hoạt Động</option>
                    <option value="inactive" selected="@(Model.StatusFilter?.ToLower() == "inactive")">Ngừng Hoạt Động</option>
                </select>
                <i class="fas fa-chevron-down absolute right-4 top-4 text-slate-400 pointer-events-none text-xs"></i>
            </div>
        </div>

        <div>
            <button onclick="searchAndFilter()"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-3 rounded-xl font-bold text-sm transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-md hover:shadow-blue-600/10 active:scale-[0.98]">
                <i class="fas fa-filter text-xs"></i>
                Lọc Kết Quả
            </button>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
                <thead class="bg-slate-900 border-b border-slate-800 text-slate-200">
                    <tr>
                        <th class="px-6 py-4.5 font-bold text-xs uppercase tracking-wider">
                            <div class="flex items-center gap-2 text-slate-400"><i class="fas fa-pills text-blue-400"></i> Tên Thuốc</div>
                        </th>
                        <th class="px-6 py-4.5 font-bold text-xs uppercase tracking-wider">
                            <div class="flex items-center gap-2 text-slate-400"><i class="fas fa-flask text-indigo-400"></i> Hoạt Chất</div>
                        </th>
                        <th class="px-6 py-4.5 font-bold text-xs uppercase tracking-wider">
                            <div class="flex items-center gap-2 text-slate-400"><i class="fas fa-vial text-amber-400"></i> Liều Dùng</div>
                        </th>
                        <th class="px-6 py-4.5 font-bold text-xs uppercase tracking-wider">
                            <div class="flex items-center gap-2 text-slate-400"><i class="fas fa-industry text-emerald-400"></i> Nhà sản xuất</div>
                        </th>
                        <th class="px-6 py-4.5 font-bold text-xs uppercase tracking-wider">
                            <div class="flex items-center gap-2 text-slate-400"><i class="fas fa-toggle-on text-purple-400"></i> Trạng Thái</div>
                        </th>
                        <th class="px-6 py-4.5 font-bold text-xs uppercase tracking-wider text-center w-40">
                            <div class="flex items-center justify-center gap-2 text-slate-400"><i class="fas fa-sliders-h"></i> Thao Tác</div>
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 text-sm">
                    @if (Model.Drugs != null && Model.Drugs.Any())
                    {
                        @foreach (var drug in Model.Drugs)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors duration-150">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-900 text-base">@drug.Name</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                                        @drug.ActiveIngredient
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-600 font-medium">@drug.Dosage</td>
                                <td class="px-6 py-4">
                                    <div class="text-slate-600">@drug.Manufacturer</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (drug.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full text-xs font-bold border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Hoạt Động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full text-xs font-bold border border-slate-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Tạm Khóa
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex justify-center items-center gap-1.5">
                                        <button onclick="viewDrug(@drug.Id)"
                                                class="text-slate-600 hover:text-blue-600 hover:bg-blue-50 p-2 rounded-lg transition-all duration-150 cursor-pointer"
                                                title="Xem Chi Tiết">
                                            <i class="fas fa-eye text-sm"></i>
                                        </button>

                                        @if (isAdmin)
                                        {
                                            <button onclick="editDrug(@drug.Id)"
                                                    class="text-slate-600 hover:text-amber-600 hover:bg-amber-50 p-2 rounded-lg transition-all duration-150 cursor-pointer"
                                                    title="Hiệu Chỉnh">
                                                <i class="fas fa-pen text-sm"></i>
                                            </button>
                                            
                                            <button onclick="confirmDeleteDrug(@drug.Id, '@drug.Name')"
                                                    class="text-slate-600 hover:text-red-600 hover:bg-red-50 p-2 rounded-lg transition-all duration-150 cursor-pointer"
                                                    title="Loại Bỏ">
                                                <i class="fas fa-trash-alt text-sm"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center text-slate-400 bg-slate-50/30">
                                <div class="max-w-sm mx-auto flex flex-col items-center justify-center">
                                    <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3">
                                        <i class="fas fa-box-open text-xl"></i>
                                    </div>
                                    <p class="font-medium text-slate-900 text-sm">Không tìm thấy thuốc tương thích</p>
                                    <p class="text-xs text-slate-400 mt-1">Vui lòng điều chỉnh từ khóa tìm kiếm hoặc bộ lọc trạng thái lâm sàng.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bg-slate-50/80 border-t border-slate-100 px-6 py-4 flex items-center justify-between flex-wrap gap-4">
            <div class="text-xs font-medium text-slate-500">
                Hiển thị <span class="font-bold text-slate-800">@((Model.CurrentPage - 1) * Model.PageSize + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</span> 
                trong tổng số <span class="font-bold text-slate-800">@Model.TotalRecords</span> bản ghi thuốc
            </div>
            
            <div class="flex gap-1 items-center">
                <button onclick="goToPage(@(Model.CurrentPage - 1))"
                        class="w-9 h-9 border border-slate-300 bg-white rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 flex items-center justify-center transition-colors disabled:opacity-40 disabled:hover:bg-white disabled:hover:text-slate-600 disabled:cursor-not-allowed cursor-pointer shadow-sm"
                        @(Model.CurrentPage <= 1 ? "disabled" : "")>
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <button class="w-9 h-9 bg-blue-600 text-white rounded-lg font-bold text-sm shadow-sm shadow-blue-600/10">@i</button>
                    }
                    else if (i <= 5 || i == Model.TotalPages || Math.Abs(i - Model.CurrentPage) <= 1)
                    {
                        if (i == Model.TotalPages && Model.TotalPages > 6 && Model.CurrentPage < Model.TotalPages - 2)
                        {
                            <span class="w-6 text-center text-slate-400 text-xs font-bold">...</span>
                        }
                        <button onclick="goToPage(@i)"
                                class="w-9 h-9 border border-slate-300 bg-white rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 font-semibold text-sm transition-colors cursor-pointer shadow-sm">@i</button>
                    }
                }

                <button onclick="goToPage(@(Model.CurrentPage + 1))"
                        class="w-9 h-9 border border-slate-300 bg-white rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 flex items-center justify-center transition-colors disabled:opacity-40 disabled:hover:bg-white disabled:hover:text-slate-600 disabled:cursor-not-allowed cursor-pointer shadow-sm"
                        @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>
    </div>
</div>