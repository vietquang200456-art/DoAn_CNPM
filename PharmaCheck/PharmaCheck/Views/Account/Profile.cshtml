@model PharmaCheck.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="max-w-5xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <!-- Header Page -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-800 tracking-tight">Quản lý tài khoản</h1>
        <p class="text-sm text-slate-500 mt-1">Cập nhật thông tin cá nhân và cấu hình bảo mật mật khẩu của bạn.</p>
    </div>

    <!-- Alert Thông báo thành công -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 rounded-xl shadow-sm flex items-start gap-3 transition-all">
            <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 text-lg"></i>
            <div>
                <p class="font-semibold text-sm">Hệ thống cập nhật thành công</p>
                <p class="text-xs text-emerald-700/90 mt-0.5">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    <!-- Tóm tắt lỗi Validation nếu có -->
    <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 text-rose-800 rounded-xl text-sm font-medium shadow-sm"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- LEFT COLUMN: CARD AVATAR & THÔNG TIN ĐỊNH DANH -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 text-center flex flex-col items-center h-fit sticky top-6">
            <div class="relative group">
                <div class="w-28 h-28 bg-gradient-to-tr from-blue-600 to-indigo-500 text-white rounded-full flex items-center justify-center text-4xl font-extrabold mb-4 shadow-md ring-4 ring-blue-50 transition duration-300 group-hover:scale-105">
                    @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                </div>
                <div class="absolute bottom-4 right-1 w-8 h-8 bg-white border border-slate-200 text-slate-500 rounded-full flex items-center justify-center shadow-sm cursor-pointer hover:text-blue-600 transition">
                    <i class="fa-solid fa-camera text-xs"></i>
                </div>
            </div>

            <h2 class="text-xl font-bold text-slate-800 tracking-tight">@Model.FullName</h2>
            <p class="text-sm font-medium text-slate-400 mb-4 flex items-center gap-1">
                <i class="fa-solid fa-circle-user text-xs"></i> @@Model.Username
            </p>
            
            @if (Model.Role == "Admin")
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                    Quản trị viên
                </span>
            }
            else if (Model.Role == "Pharmacist")
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-green-50 text-green-700 border border-green-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                    Dược sĩ
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                    Bác sĩ chuyên khoa
                </span>
            }

            <div class="w-full border-t border-slate-100 mt-6 pt-4 text-left space-y-3">
                <div class="flex items-center justify-between text-xs text-slate-500">
                    <span>Trạng thái hồ sơ</span>
                    <span class="text-emerald-600 font-medium">Đang hoạt động</span>
                </div>
                <div class="flex items-center justify-between text-xs text-slate-500">
                    <span>Quyền hạn</span>
                    <span class="font-mono text-slate-700">@Model.Role</span>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: CHỨA CÁC PHÂN KHU CẤU HÌNH FORM -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- BLOCK 1: THÔNG TIN CƠ BẢN -->
            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-100">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-3 mb-6">
                    <i class="fa-solid fa-id-card text-blue-500 text-lg"></i>
                    <h3 class="text-lg font-bold text-slate-800">Thông tin cơ bản</h3>
                </div>
                
                <form asp-action="UpdateProfile" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="Username" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5"></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-lock text-xs"></i>
                            </div>
                            <input asp-for="Username" class="w-full pl-9 p-2.5 border border-slate-200 rounded-xl bg-slate-50 text-slate-400 cursor-not-allowed text-sm focus:outline-none" readonly />
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Tên tài khoản hệ thống cố định, không thể tự sửa đổi.</p>
                    </div>

                    <div>
                        <label asp-for="FullName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                        <input asp-for="FullName" placeholder="Nhập họ và tên đầy đủ" 
                               class="w-full p-2.5 border border-slate-200 rounded-xl text-sm bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all duration-200" />
                        <span asp-validation-for="FullName" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                        <input asp-for="Email" placeholder="example@@pharmacheck.com" 
                               class="w-full p-2.5 border border-slate-200 rounded-xl text-sm bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all duration-200" />
                        <span asp-validation-for="Email" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition duration-150 cursor-pointer">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Lưu cấu hình
                        </button>
                    </div>
                </form>
            </div>

            <!-- BLOCK 2: ĐỔI MẬT KHẨU BẢO MẬT -->
            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-100">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-3 mb-6">
                    <i class="fa-solid fa-shield-halved text-rose-500 text-lg"></i>
                    <h3 class="text-lg font-bold text-slate-800">Đổi mật khẩu bảo mật</h3>
                </div>
                
                <form asp-action="ChangePassword" asp-controller="Account" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="CurrentPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                        <div class="relative">
                            <input asp-for="CurrentPassword" type="password" id="CurrentPassword" required
                                   class="w-full p-2.5 pr-10 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all duration-200" 
                                   placeholder="Nhập mật khẩu hiện tại bạn đang dùng" />
                            <button type="button" onclick="togglePasswordVisibility('CurrentPassword')" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-blue-600 transition">
                                <i class="fa-solid fa-eye text-sm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label asp-for="NewPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                            <div class="relative">
                                <input asp-for="NewPassword" type="password" id="NewPassword" required
                                       class="w-full p-2.5 pr-10 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all duration-200" 
                                       placeholder="Mật khẩu mới (Tối thiểu 6 ký tự)" />
                                <button type="button" onclick="togglePasswordVisibility('NewPassword')" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-blue-600 transition">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="ConfirmPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                            <div class="relative">
                                <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" required
                                       class="w-full p-2.5 pr-10 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 transition-all duration-200" 
                                       placeholder="Xác nhận lại mật khẩu mới" />
                                <button type="button" onclick="togglePasswordVisibility('ConfirmPassword')" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-blue-600 transition">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-xs font-medium text-rose-600 mt-1 block"></span>
                        </div>
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition duration-150 cursor-pointer">
                            <i class="fa-solid fa-key"></i>
                            Cập nhật mật khẩu
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId) {
        const input = document.getElementById(inputId);
        const icon = input.nextElementSibling.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}