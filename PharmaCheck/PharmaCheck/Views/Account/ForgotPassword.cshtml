@model PharmaCheck.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PharmaCheck</title>

    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }
    </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-md">

        <!-- Logo + Brand -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white shadow-2xl mb-4">
                <i class="fa-solid fa-shield-heart text-4xl text-blue-600"></i>
            </div>

            <h1 class="text-3xl font-bold text-white">
                PharmaCheck
            </h1>

            <p class="text-blue-100 text-sm mt-2">
                Hệ thống tra cứu tương tác thuốc & bệnh
            </p>
        </div>

        <!-- Main Card -->
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-8 text-center">

                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white shadow-lg mb-4">
                    <i class="fa-solid fa-key text-2xl text-blue-600"></i>
                </div>

                <h2 class="text-2xl font-bold text-white">
                    Quên Mật Khẩu
                </h2>

                <p class="text-blue-100 text-sm mt-2 leading-relaxed">
                    Nhập email của bạn để nhận liên kết đặt lại mật khẩu
                </p>
            </div>

            <!-- Body -->
            <div class="px-8 py-8">

                <!-- Success / Info Message -->
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="mb-6 rounded-2xl border border-blue-200 bg-blue-50 p-4">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-info text-blue-600 mt-0.5"></i>

                            <div class="text-sm text-blue-800 leading-relaxed">
                                @TempData["InfoMessage"]
                            </div>
                        </div>
                    </div>
                }

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly"
                         class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                    </div>
                }

                <!-- Form -->
                <form asp-action="ForgotPassword"
                      asp-controller="Account"
                      method="post"
                      class="space-y-6">

                    @Html.AntiForgeryToken()

                    <!-- Email -->
                    <div>

                        <label asp-for="Email"
                               class="block text-sm font-semibold text-slate-700 mb-2">
                            Địa Chỉ Email
                        </label>

                        <div class="relative">

                            <!-- Icon -->
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <i class="fa-solid fa-envelope"></i>
                            </span>

                            <!-- Input -->
                            <input asp-for="Email"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="example@gmail.com"
                                   class="w-full rounded-2xl border border-slate-300 bg-slate-50 py-3 pl-12 pr-4 text-sm text-slate-800 outline-none transition-all duration-200 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" />

                        </div>

                        <!-- Validation -->
                        <span asp-validation-for="Email"
                              class="mt-2 block text-xs font-medium text-red-500">
                        </span>

                        <!-- Hint -->
                        <p class="mt-3 text-xs leading-relaxed text-slate-500">
                            <i class="fa-solid fa-shield-halved text-blue-500"></i>
                            Vì lý do bảo mật, hệ thống sẽ không tiết lộ email có tồn tại hay không.
                        </p>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-700 px-4 py-3 font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-2xl">

                        <i class="fa-solid fa-paper-plane transition-transform duration-300 group-hover:translate-x-1"></i>

                        <span>
                            Gửi Liên Kết Khôi Phục
                        </span>
                    </button>

                </form>

                <!-- Divider -->
                <div class="my-7 flex items-center">
                    <div class="h-px flex-1 bg-slate-200"></div>

                    <span class="px-4 text-xs font-medium uppercase tracking-wider text-slate-400">
                        Điều hướng
                    </span>

                    <div class="h-px flex-1 bg-slate-200"></div>
                </div>

                <!-- Links -->
                <div class="flex items-center justify-center gap-4 text-sm">

                    <a asp-action="Login"
                       asp-controller="Account"
                       class="font-semibold text-blue-600 transition hover:text-blue-800">

                        <i class="fa-solid fa-arrow-left"></i>
                        Đăng nhập
                    </a>

                    <span class="text-slate-300">|</span>

                    <a asp-action="Register"
                       asp-controller="Account"
                       class="font-semibold text-blue-600 transition hover:text-blue-800">

                        <i class="fa-solid fa-user-plus"></i>
                        Tạo tài khoản
                    </a>

                </div>
            </div>

            <!-- Footer -->
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-5 text-center">

                <p class="text-xs leading-relaxed text-slate-500">
                    PharmaCheck hỗ trợ kiểm tra tương tác thuốc và chống chỉ định lâm sàng
                    dành cho phòng khám và cơ sở y tế.
                </p>

            </div>
        </div>

        <!-- Bottom -->
        <div class="mt-6 text-center text-xs text-blue-100">
            © 2026 PharmaCheck. All rights reserved.
        </div>

    </div>

    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />

</body>
</html>