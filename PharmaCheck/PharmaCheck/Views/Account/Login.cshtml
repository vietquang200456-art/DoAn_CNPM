@model PharmaCheck.Controllers.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - PharmaCheck</title>
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen font-sans">

    <div class="w-full max-w-md p-8 m-4 bg-white rounded-2xl shadow-xl shadow-blue-100/50 border border-slate-100">
        <!-- Logo & Title -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 bg-blue-50 text-blue-600 rounded-2xl mb-3">
                <i class="fa-solid fa-prescription-bottle-medical text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-800">PharmaCheck</h2>
            <p class="text-slate-500 text-sm mt-1">Hệ thống tra cứu tương tác thuốc & bệnh lý</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 mb-4 text-sm text-green-700 bg-green-50 rounded-xl border border-green-100 flex items-center gap-2">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <form asp-action="Login" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="p-3 text-sm text-red-600 bg-red-50 rounded-xl border border-red-100"></div>

            <!-- Username or Email Input -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tài khoản hoặc Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i class="fa-solid fa-user-md text-sm"></i>
                    </span>
                    <input asp-for="UsernameOrEmail" type="text" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100 transition-all text-slate-800" placeholder="Nhập tên đăng nhập hoặc email..." />
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Password Input -->
            <div>
                <div class="flex justify-between items-center mb-1.5">
                    <label class="block text-sm font-semibold text-slate-700">Mật khẩu</label>
                    <a asp-action="ForgotPassword" class="text-xs font-medium text-blue-600 hover:underline">Quên mật khẩu?</a>
                </div>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </span>
                    <input asp-for="Password" type="password" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100 transition-all text-slate-800" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center">
                <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 text-blue-600 border-slate-300 rounded-md focus:ring-blue-500 bg-slate-50">
                <label asp-for="RememberMe" class="ml-2 text-sm text-slate-600 select-none">Ghi nhớ đăng nhập</label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md shadow-blue-200 hover:shadow-none transition-all duration-200 text-sm flex items-center justify-center gap-2 cursor-pointer">
                <span>Đăng Nhập</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <!-- Footer Links -->
        <div class="text-center mt-6 pt-5 border-t border-slate-100">
            <p class="text-sm text-slate-600">
                Chưa có tài khoản? 
                <a asp-action="Register" class="font-semibold text-blue-600 hover:underline">Đăng ký ngay</a>
            </p>
        </div>
    </div>

</body>
</html>