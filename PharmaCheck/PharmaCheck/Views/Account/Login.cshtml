@model PharmaCheck.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng Nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PharmaCheck</title>

    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        .glass-effect {
            backdrop-filter: blur(10px);
        }
    </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-md">

        <!-- Logo / Brand -->
        <div class="text-center mb-6">

            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white shadow-2xl mb-4">
                <i class="fa-solid fa-prescription-bottle-medical text-4xl text-blue-600"></i>
            </div>

            <h1 class="text-4xl font-extrabold text-white tracking-wide">
                PharmaCheck
            </h1>

            <p class="text-blue-100 text-sm mt-2 leading-relaxed">
                Hệ thống tra cứu tương tác thuốc và chống chỉ định lâm sàng
            </p>
        </div>

        <!-- Main Card -->
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 via-blue-700 to-indigo-700 px-8 py-8 text-center">

                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white shadow-lg mb-4">
                    <i class="fa-solid fa-right-to-bracket text-2xl text-blue-600"></i>
                </div>

                <h2 class="text-2xl font-bold text-white">
                    Đăng Nhập Hệ Thống
                </h2>

                <p class="text-blue-100 text-sm mt-2">
                    Đăng nhập để sử dụng hệ thống PharmaCheck
                </p>
            </div>

            <!-- Body -->
            <div class="px-8 py-8">

                <!-- Success Message -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-6 rounded-2xl border border-green-200 bg-green-50 p-4">
                        <div class="flex items-start gap-3">

                            <i class="fa-solid fa-circle-check text-green-600 mt-0.5"></i>

                            <div class="text-sm text-green-700 leading-relaxed">
                                @TempData["SuccessMessage"]
                            </div>

                        </div>
                    </div>
                }

                <!-- Error Message -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly"
                         class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                    </div>
                }

                <!-- Login Form -->
                <form asp-action="Login"
                      asp-controller="Account"
                      method="post"
                      class="space-y-6">

                    @Html.AntiForgeryToken()

                    <!-- Username / Email -->
                    <div>

                        <label asp-for="UsernameOrEmail"
                               class="block text-sm font-semibold text-slate-700 mb-2">
                            Tên Đăng Nhập Hoặc Email
                        </label>

                        <div class="relative">

                            <!-- Icon -->
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <i class="fa-solid fa-user"></i>
                            </span>

                            <!-- Input -->
                            <input asp-for="UsernameOrEmail"
                                   type="text"
                                   autocomplete="username"
                                   placeholder="Nhập username hoặc email"
                                   class="w-full rounded-2xl border border-slate-300 bg-slate-50 py-3 pl-12 pr-4 text-sm text-slate-800 outline-none transition-all duration-200 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" />

                        </div>

                        <!-- Validation -->
                        <span asp-validation-for="UsernameOrEmail"
                              class="mt-2 block text-xs font-medium text-red-500">
                        </span>

                    </div>

                    <!-- Password -->
                    <div>

                        <div class="mb-2 flex items-center justify-between">

                            <label asp-for="Password"
                                   class="block text-sm font-semibold text-slate-700">
                                Mật Khẩu
                            </label>

                            <a asp-action="ForgotPassword"
                               asp-controller="Account"
                               class="text-xs font-semibold text-blue-600 transition hover:text-blue-800">

                                Quên mật khẩu?
                            </a>

                        </div>

                        <div class="relative">

                            <!-- Icon -->
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <i class="fa-solid fa-lock"></i>
                            </span>

                            <!-- Password Input -->
                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu"
                                   class="w-full rounded-2xl border border-slate-300 bg-slate-50 py-3 pl-12 pr-12 text-sm text-slate-800 outline-none transition-all duration-200 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" />

                            <!-- Toggle Password -->
                            <button type="button"
                                    onclick="togglePassword()"
                                    class="absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400 hover:text-blue-600 transition">

                                <i id="togglePasswordIcon" class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <!-- Validation -->
                        <span asp-validation-for="Password"
                              class="mt-2 block text-xs font-medium text-red-500">
                        </span>

                    </div>

                    <!-- Remember Me -->
                    <div class="flex items-center justify-between">

                        <label class="flex items-center gap-3 cursor-pointer">

                            <input asp-for="RememberMe"
                                   type="checkbox"
                                   class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />

                            <span class="text-sm text-slate-700">
                                Ghi nhớ đăng nhập
                            </span>

                        </label>

                    </div>

                    <!-- Submit Button -->
                    <button type="submit"
                            class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-blue-600 via-blue-700 to-indigo-700 px-4 py-3 font-bold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-2xl">

                        <i class="fa-solid fa-right-to-bracket transition-transform duration-300 group-hover:translate-x-1"></i>

                        <span>
                            Đăng Nhập
                        </span>

                    </button>

                </form>

                <!-- Divider -->
                <div class="my-7 flex items-center">

                    <div class="h-px flex-1 bg-slate-200"></div>

                    <span class="px-4 text-xs font-semibold uppercase tracking-wider text-slate-400">
                        Hoặc
                    </span>

                    <div class="h-px flex-1 bg-slate-200"></div>

                </div>

                <!-- Register -->
                <div class="text-center">

                    <p class="text-sm text-slate-600">

                        Chưa có tài khoản?

                        <a asp-action="Register"
                           asp-controller="Account"
                           class="font-bold text-blue-600 transition hover:text-blue-800">

                            Đăng ký ngay
                        </a>

                    </p>

                </div>

            </div>

            <!-- Footer -->
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-5 text-center">

                <p class="text-xs leading-relaxed text-slate-500">
                    PharmaCheck hỗ trợ kiểm tra tương tác thuốc, cảnh báo chống chỉ định
                    và rà soát đơn thuốc cho phòng khám và cơ sở y tế.
                </p>

            </div>

        </div>

        <!-- Bottom -->
        <div class="mt-6 text-center text-xs text-blue-100">
            © 2026 PharmaCheck. All rights reserved.
        </div>

    </div>

    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />

    <!-- Toggle Password Script -->
    <script>
        function togglePassword() {

            const passwordInput = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';

                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
            else {
                passwordInput.type = 'password';

                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>

</body>
</html>