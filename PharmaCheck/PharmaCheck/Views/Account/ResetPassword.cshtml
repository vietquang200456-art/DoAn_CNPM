@model PharmaCheck.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PharmaCheck</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .password-strength {
            height: 4px;
            border-radius: 2px;
            transition: all 0.3s ease;
            background: #e5e7eb;
        }
        .password-strength.weak { background: #ef4444; width: 33%; }
        .password-strength.fair { background: #f97316; width: 66%; }
        .password-strength.strong { background: #22c55e; width: 100%; }
        .fade-in {
            animation: fadeIn 0.3s ease-in;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Card chính -->
        <div class="bg-white/95 backdrop-blur rounded-3xl shadow-2xl overflow-hidden fade-in">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-8 text-center">
                <div class="flex justify-center mb-4">
                    <div class="bg-white rounded-full p-4 shadow-lg">
                        <i class="fas fa-lock-open text-blue-600 text-4xl"></i>
                    </div>
                </div>
                <h1 class="text-3xl font-bold text-white">Đặt Lại Mật Khẩu</h1>
                <p class="text-blue-100 text-sm mt-2">Tạo mật khẩu mới cho tài khoản của bạn</p>
            </div>

            <!-- Form -->
            <form method="post" asp-action="ResetPassword" class="px-8 py-8" novalidate>
                @Html.AntiForgeryToken()

                <!-- Hidden token và email -->
                <input type="hidden" name="Token" value="@Model.Token">
                <input type="hidden" name="Email" value="@Model.Email">

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="hidden" id="validationSummary">
                    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-lg flex items-start gap-3 fade-in">
                        <i class="fas fa-exclamation-triangle text-red-600 flex-shrink-0 mt-0.5"></i>
                        <div class="text-red-700 text-sm flex-1">
                            <p class="font-semibold mb-2">Có lỗi xảy ra:</p>
                            <ul class="list-disc list-inside space-y-1">
                                <li>@Html.ValidationSummary(true)</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Email (hiển thị, không cho chỉnh sửa) -->
                <div class="mb-5">
                    <label for="Email" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-envelope text-blue-500 mr-1"></i>Email
                    </label>
                    <div class="relative">
                        <input type="email" id="Email" value="@Model.Email"
                               disabled
                               class="w-full px-4 py-3 border-2 border-gray-300 rounded-2xl bg-gray-100 text-gray-700 cursor-not-allowed focus:outline-none">
                    </div>
                </div>

                <!-- Mật khẩu mới -->
                <div class="mb-5">
                    <label for="NewPassword" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-lock text-blue-500 mr-1"></i>Mật khẩu mới
                    </label>
                    <div class="relative">
                        <input type="password" id="NewPassword" name="NewPassword" asp-for="NewPassword"
                               class="w-full px-4 py-3 pr-12 border-2 border-gray-300 rounded-2xl focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition text-gray-700"
                               placeholder="Nhập mật khẩu mới..."
                               autocomplete="new-password"
                               onkeyup="checkPasswordStrength(this.value)">
                        <button type="button" class="absolute right-4 top-3.5 text-gray-400 hover:text-gray-600 transition" 
                                onclick="togglePasswordVisibility('NewPassword')">
                            <i class="fas fa-eye" id="eye-NewPassword"></i>
                        </button>
                    </div>
                    <div class="password-strength mt-2" id="strengthBar"></div>
                    <p class="text-gray-500 text-xs mt-2">
                        <i class="fas fa-info-circle"></i> 
                        Ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt
                    </p>
                    <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1 block font-medium"></span>
                </div>

                <!-- Xác nhận mật khẩu mới -->
                <div class="mb-6">
                    <label for="ConfirmNewPassword" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-check-circle text-blue-500 mr-1"></i>Xác nhận mật khẩu
                    </label>
                    <div class="relative">
                        <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" asp-for="ConfirmNewPassword"
                               class="w-full px-4 py-3 pr-12 border-2 border-gray-300 rounded-2xl focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition text-gray-700"
                               placeholder="Nhập lại mật khẩu..."
                               autocomplete="new-password">
                        <button type="button" class="absolute right-4 top-3.5 text-gray-400 hover:text-gray-600 transition" 
                                onclick="togglePasswordVisibility('ConfirmNewPassword')">
                            <i class="fas fa-eye" id="eye-ConfirmNewPassword"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-red-500 text-xs mt-1 block font-medium"></span>
                </div>

                <!-- Nút đặt lại -->
                <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-bold py-3 rounded-2xl hover:shadow-lg hover:shadow-blue-400/50 transform hover:-translate-y-0.5 transition duration-200 flex items-center justify-center gap-2 active:scale-95">
                    <i class="fas fa-check-circle"></i>
                    <span>Đặt Lại Mật Khẩu</span>
                </button>

                <!-- Liên kết hỗ trợ -->
                <div class="mt-6 flex justify-center">
                    <a asp-action="Login" class="text-blue-600 hover:text-blue-800 hover:underline text-sm font-semibold transition">
                        <i class="fas fa-arrow-left mr-1"></i>Quay lại đăng nhập
                    </a>
                </div>
            </form>

            <!-- Footer -->
            <div class="bg-gray-50 px-8 py-5 text-center border-t border-gray-200">
                <p class="text-gray-600 text-xs flex items-center justify-center gap-2">
                    <i class="fas fa-shield-alt text-green-500"></i>
                    Mật khẩu của bạn được bảo mật và mã hóa
                </p>
            </div>
        </div>

        <!-- Thông tin bản quyền -->
        <div class="mt-8 text-center text-white text-xs">
            <p>&copy; 2026 PharmaCheck. Tất cả các quyền được bảo lưu.</p>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        function togglePasswordVisibility(inputId) {
            const input = document.getElementById(inputId);
            const eyeIcon = document.getElementById('eye-' + inputId);
            
            if (input.type === 'password') {
                input.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }

        function checkPasswordStrength(password) {
            const strengthBar = document.getElementById('strengthBar');
            let strength = 0;
            
            if (password.length >= 8) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[^a-zA-Z0-9]/.test(password)) strength++;
            
            strengthBar.classList.remove('weak', 'fair', 'strong');
            
            if (strength <= 2) {
                strengthBar.classList.add('weak');
            } else if (strength === 3 || strength === 4) {
                strengthBar.classList.add('fair');
            } else {
                strengthBar.classList.add('strong');
            }
        }

        // Show validation summary if there are errors
        document.addEventListener('DOMContentLoaded', function() {
            const validationSummary = document.getElementById('validationSummary');
            if (validationSummary && validationSummary.innerText.trim()) {
                validationSummary.classList.remove('hidden');
            }
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
