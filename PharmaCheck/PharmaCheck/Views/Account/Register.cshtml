@model PharmaCheck.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PharmaCheck</title>

    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Validation -->
    <partial name="_ValidationScriptsPartial" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        .input-focus {
            transition: all 0.25s ease;
        }

            .input-focus:focus {
                transform: translateY(-1px);
            }
    </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 flex items-center justify-center px-4 py-8">

    <div class="w-full max-w-lg">

        <!-- Logo / Brand -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white shadow-xl mb-4">
                <i class="fa-solid fa-shield-heart text-3xl text-blue-600"></i>
            </div>

            <h1 class="text-4xl font-bold text-white tracking-wide">
                PharmaCheck
            </h1>

            <p class="text-blue-100 mt-2 text-sm">
                Hệ thống tra cứu tương tác thuốc và chống chỉ định lâm sàng
            </p>
        </div>

        <!-- Main Card -->
        <div class="bg-white/95 backdrop-blur rounded-3xl shadow-2xl overflow-hidden border border-white/20">

            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-7 text-center">
                <h2 class="text-2xl font-bold text-white">
                    Tạo Tài Khoản Mới
                </h2>

                <p class="text-blue-100 text-sm mt-2">
                    Đăng ký để sử dụng hệ thống PharmaCheck
                </p>
            </div>

            <!-- Form -->
            <form asp-action="Register"
                  asp-controller="Account"
                  method="post"
                  class="px-8 py-8 space-y-5">

                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                </div>

                <!-- Username -->
                <div>
                    <label asp-for="Username"
                           class="block text-sm font-semibold text-slate-700 mb-2">
                    </label>

                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                            <i class="fa-solid fa-at text-sm"></i>
                        </span>

                        <input asp-for="Username"
                               type="text"
                               autocomplete="username"
                               placeholder="Nhập tên đăng nhập"
                               class="input-focus w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-2xl text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
                    </div>

                    <span asp-validation-for="Username"
                          class="text-xs text-red-500 mt-1 block font-medium">
                    </span>
                </div>

                <!-- Full Name -->
                <div>
                    <label asp-for="FullName"
                           class="block text-sm font-semibold text-slate-700 mb-2">
                    </label>

                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </span>

                        <input asp-for="FullName"
                               type="text"
                               autocomplete="name"
                               placeholder="Nguyễn Văn A"
                               class="input-focus w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-2xl text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
                    </div>

                    <span asp-validation-for="FullName"
                          class="text-xs text-red-500 mt-1 block font-medium">
                    </span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email"
                           class="block text-sm font-semibold text-slate-700 mb-2">
                    </label>

                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                            <i class="fa-solid fa-envelope text-sm"></i>
                        </span>

                        <input asp-for="Email"
                               type="email"
                               autocomplete="email"
                               placeholder="example@gmail.com"
                               class="input-focus w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-2xl text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
                    </div>

                    <span asp-validation-for="Email"
                          class="text-xs text-red-500 mt-1 block font-medium">
                    </span>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Password"
                           class="block text-sm font-semibold text-slate-700 mb-2">
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input asp-for="Password"
                               type="password"
                               autocomplete="new-password"
                               placeholder="••••••••"
                               class="input-focus w-full pl-11 pr-12 py-3 bg-slate-50 border border-slate-300 rounded-2xl text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />

                        <button type="button"
                                onclick="togglePassword('Password', 'passwordIcon1')"
                                class="absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400 hover:text-blue-600 transition">
                            <i id="passwordIcon1" class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <div class="mt-2 text-xs text-slate-500 leading-5">
                        <p>
                            <i class="fa-solid fa-circle-info text-blue-500"></i>
                            Mật khẩu nên có ít nhất 8 ký tự bao gồm chữ hoa, chữ thường và số.
                        </p>
                    </div>

                    <span asp-validation-for="Password"
                          class="text-xs text-red-500 mt-1 block font-medium">
                    </span>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label asp-for="ConfirmPassword"
                           class="block text-sm font-semibold text-slate-700 mb-2">
                    </label>

                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Nhập lại mật khẩu"
                               class="input-focus w-full pl-11 pr-12 py-3 bg-slate-50 border border-slate-300 rounded-2xl text-sm text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />

                        <button type="button"
                                onclick="togglePassword('ConfirmPassword', 'passwordIcon2')"
                                class="absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400 hover:text-blue-600 transition">
                            <i id="passwordIcon2" class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-xs text-red-500 mt-1 block font-medium">
                    </span>
                </div>

                <!-- Agree Terms -->
                <div class="pt-1">
                    <div class="flex items-start gap-3">
                        <input asp-for="AcceptTerms"
                               type="checkbox"
                               class="mt-1 w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />

                        <label asp-for="AcceptTerms"
                               class="text-sm text-slate-600 leading-6">
                            Tôi đồng ý với
                            <a href="#"
                               class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">
                                Điều khoản sử dụng
                            </a>
                            và
                            <a href="#"
                               class="text-blue-600 hover:text-blue-800 font-semibold hover:underline">
                                Chính sách bảo mật
                            </a>
                            của PharmaCheck.
                        </label>
                    </div>

                    <span asp-validation-for="AcceptTerms"
                          class="text-xs text-red-500 mt-1 block font-medium">
                    </span>
                </div>

                <!-- Submit -->
                <button type="submit"
                        class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-semibold shadow-lg shadow-blue-200 hover:shadow-none hover:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-user-plus"></i>
                    <span>Đăng Ký Tài Khoản</span>
                </button>

            </form>

            <!-- Footer -->
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-5 text-center">
                <p class="text-sm text-slate-600">
                    Đã có tài khoản?
                    <a asp-action="Login"
                       asp-controller="Account"
                       class="text-blue-600 hover:text-blue-800 font-bold hover:underline">
                        Đăng nhập ngay
                    </a>
                </p>
            </div>
        </div>

        <!-- Copyright -->
        <div class="mt-6 text-center">
            <p class="text-xs text-blue-100">
                © 2026 PharmaCheck System. All rights reserved.
            </p>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        function togglePassword(inputId, iconId) {

            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            }
            else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>

</body>
</html>