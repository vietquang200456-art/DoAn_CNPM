@model CreateInteractionViewModel

@{
    ViewData["Title"] = "Thêm Mới Tương Tác Thuốc | PharmaCheck";
}

<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.tailwind.min.css" rel="stylesheet">
<style>
    /* Custom nhẹ cho Tom Select đồng bộ với bo góc tròn của form */
    .ts-control {
        border-radius: 0.75rem !important;
        padding: 0.75rem 1rem !important;
    }
    .ts-wrapper.single .ts-control::after {
        right: 15px !important;
    }
</style>

<div class="bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-800 text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-4">
            <a href="@Url.Action("Index", "Interaction")" class="bg-white/10 hover:bg-white/20 p-2.5 rounded-lg transition-colors text-white" title="Quay lại">
                <i class="fas fa-arrow-left text-lg"></i>
            </a>
            <div>
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-flask-vial"></i>
                    Thêm Mới Tương Tác Thuốc
                </h1>
                <p class="text-blue-100 mt-1">Cấu hình rủi ro và khuyến nghị khi kết hợp hai loại thuốc với nhau</p>
            </div>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8">
            
            <form asp-action="CreateInteraction" asp-controller="Interaction" method="post" id="create-interaction-form">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-lg text-sm text-red-700">
                        <div class="flex items-center gap-2 mb-2 font-semibold">
                            <i class="fas fa-exclamation-triangle"></i> Vui lòng kiểm tra lại thông tin nhập vào:
                        </div>
                        <div asp-validation-summary="All" class="list-disc pl-5"></div>
                    </div>
                }

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <label asp-for="SourceDrugId" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-pills mr-1.5 text-blue-600"></i> Thuốc Nguồn (Thuốc A) <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="SourceDrugId" asp-items="Model.DrugList" class="searchable-select w-full" placeholder="Gõ tên thuốc để tìm kiếm...">
                            <option value="">-- Chọn thuốc nguồn --</option>
                        </select>
                        <span asp-validation-for="SourceDrugId" class="text-xs text-red-500 mt-1 block font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="TargetDrugId" class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-pills mr-1.5 text-indigo-600"></i> Thuốc Tương Tác (Thuốc B) <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="TargetDrugId" asp-items="Model.DrugList" class="searchable-select w-full" placeholder="Gõ tên thuốc để tìm kiếm...">
                            <option value="">-- Chọn thuốc tương tác --</option>
                        </select>
                        <span asp-validation-for="TargetDrugId" class="text-xs text-red-500 mt-1 block font-medium"></span>
                        <span id="duplicate-drug-error" class="text-xs text-red-500 mt-1 hidden font-medium"></span>
                    </div>
                </div>

                <div class="mb-6 p-4 rounded-xl transition-all duration-300" id="severity-container">
                    <label asp-for="SeverityLevel" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-sliders-h mr-1.5 text-blue-600"></i> Mức Độ Nghiêm Trọng <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="SeverityLevel" id="severity-select" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white transition-shadow">
                        <option value="">-- Chọn mức độ nghiêm trọng --</option>
                        <option value="1">1 - Nhẹ (Cần theo dõi thêm)</option>
                        <option value="2">2 - Vừa (Có tác động nhỏ)</option>
                        <option value="3">3 - Trung bình (Cân nhắc đổi liều hoặc thuốc)</option>
                        <option value="4">4 - Nặng (Nguy cơ biến chứng nguy hiểm)</option>
                        <option value="5">5 - Rất nặng (Chống chỉ định tuyệt đối phối hợp)</option>
                    </select>
                    <span asp-validation-for="SeverityLevel" class="text-xs text-red-500 mt-1 block font-medium"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-align-left mr-1.5 text-blue-600"></i> Cơ Chế / Mô Tả Tương Tác <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Description" rows="4" placeholder="Nhập chi tiết cơ chế tương tác, phản ứng sinh hóa nếu có..." 
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-1 block font-medium"></span>
                </div>

                <div class="mb-8">
                    <label asp-for="Recommendation" class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-comment-medical mr-1.5 text-blue-600"></i> Hướng Dẫn Xử Lý / Khuyến Nghị Lâm Sàng <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Recommendation" rows="3" placeholder="Ví dụ: Giãn cách thời gian uống 2 tiếng, giảm nửa liều Thuốc B, hoặc tuyệt đối không dùng chung..." 
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow resize-none"></textarea>
                    <span asp-validation-for="Recommendation" class="text-xs text-red-500 mt-1 block font-medium"></span>
                </div>

                <div class="flex items-center justify-end gap-3 border-t border-gray-100 pt-6">
                    <a href="@Url.Action("Index", "Interaction")" 
                       class="px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition-colors flex items-center gap-2">
                        <i class="fas fa-times"></i> Hủy Bỏ
                    </a>
                    <button type="submit" id="btn-submit"
                            class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors shadow-md flex items-center gap-2">
                        <i class="fas fa-save"></i> Lưu Cấu Hình
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    
    <script>
        // 1. Khởi tạo lưu trữ Tab hoạt động
        localStorage.setItem('pharmaCheck_activeTab', 'interactions');

        // 2. Tích hợp Tìm kiếm thông minh cho Thẻ Chọn Thuốc bằng Tom Select
        var sourceSelect, targetSelect;
        document.querySelectorAll('.searchable-select').forEach(function(el, index) {
            let ts = new TomSelect(el, {
                create: false,
                sortField: { field: "text", direction: "asc" },
                placeholder: el.getAttribute('placeholder')
            });
            if (index === 0) sourceSelect = ts;
            if (index === 1) targetSelect = ts;
        });

        // 3. Logic chặn chọn trùng lặp Thuốc A và Thuốc B
        const form = document.getElementById('create-interaction-form');
        const duplicateError = document.getElementById('duplicate-drug-error');
        const btnSubmit = document.getElementById('btn-submit');

        function validateDuplicateDrugs() {
            const valA = sourceSelect.getValue();
            const valB = targetSelect.getValue();

            if (valA && valB && valA === valB) {
                duplicateError.textContent = "Thuốc tương tác không được trùng với thuốc nguồn!";
                duplicateError.classList.remove('hidden');
                btnSubmit.disabled = true;
                btnSubmit.classList.add('opacity-50', 'cursor-not-allowed');
                return false;
            } else {
                duplicateError.classList.add('hidden');
                btnSubmit.disabled = false;
                btnSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
                return true;
            }
        }

        sourceSelect.on('change', validateDuplicateDrugs);
        targetSelect.on('change', validateDuplicateDrugs);
        form.addEventListener('submit', function(e) {
            if (!validateDuplicateDrugs()) {
                e.preventDefault();
            }
        });

        // 4. Động hóa màu nền theo mức độ nghiêm trọng (Severity Level)
        const severitySelect = document.getElementById('severity-select');
        const severityContainer = document.getElementById('severity-container');

        const severityStyles = {
            '1': { bg: 'bg-green-50', border: 'border-l-4 border-green-500' },
            '2': { bg: 'bg-yellow-50', border: 'border-l-4 border-yellow-400' },
            '3': { bg: 'bg-orange-50', border: 'border-l-4 border-orange-400' },
            '4': { bg: 'bg-red-50', border: 'border-l-4 border-red-500' },
            '5': { bg: 'bg-purple-50', border: 'border-l-4 border-purple-600' }
        };

        severitySelect.addEventListener('change', function() {
            const level = this.value;
            
            // Reset class cũ
            severityContainer.className = "mb-6 p-4 rounded-xl transition-all duration-300";
            
            // Áp dụng class mới nếu có lựa chọn mức độ
            if(severityStyles[level]) {
                severityContainer.classList.add(severityStyles[level].bg);
                // Biến đổi chuỗi class border tách biệt để Tailwind nhận diện chuẩn
                severityStyles[level].border.split(' ').forEach(c => severityContainer.classList.add(c));
            }
        });
    </script>
}