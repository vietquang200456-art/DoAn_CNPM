@model InteractionManagementViewModel

@{
    ViewData["Title"] = "Quản Lý Tương Tác & Chống Chỉ Định | PharmaCheck";
    // Kiểm tra quyền Admin một lần để tái sử dụng hiệu quả
    bool isAdmin = User.IsInRole("Admin");
}

<div class="bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-800 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold flex items-center gap-3">
                    <i class="fas fa-exchange-alt"></i>
                    Quản Lý Cấu Hình Tương Tác
                </h1>
                <p class="text-blue-100 mt-2">Quản lý tương tác giữa các thuốc và chống chỉ định thuốc-bệnh</p>
            </div>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex gap-4 mb-6 border-b border-gray-200">
            <button type="button" 
                    onclick="switchTab('interactions')" 
                    id="tab-interactions"
                    class="tab-btn active px-6 py-3 font-semibold text-blue-700 border-b-2 border-blue-700 hover:text-blue-900 transition-colors">
                <i class="fas fa-pills mr-2"></i>Tương Tác Thuốc - Thuốc
            </button>
            <button type="button" 
                    onclick="switchTab('contraindications')" 
                    id="tab-contraindications"
                    class="tab-btn px-6 py-3 font-semibold text-gray-600 border-b-2 border-transparent hover:text-gray-900 hover:border-gray-300 transition-colors">
                <i class="fas fa-ban mr-2"></i>Chống Chỉ Định Thuốc - Bệnh
            </button>
        </div>

        <div id="interactions-tab" class="tab-content block">
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                        <i class="fas fa-flask-vial text-blue-600"></i>
                        Tương Tác Giữa Hai Loại Thuốc
                    </h2>
                    @if (isAdmin)
                    {
                        <a href="@Url.Action("CreateInteraction", "Interaction")" 
                           class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors flex items-center gap-2 shadow-md">
                            <i class="fas fa-plus"></i> Thêm Tương Tác Mới
                        </a>
                    }
                </div>

                <form id="interactions-filter-form" onsubmit="handleInteractionSearch(event)" class="mb-8 p-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl border border-blue-200">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-search mr-2 text-blue-600"></i>Tìm kiếm (Tên thuốc/Hoạt chất)
                            </label>
                            <input type="text" 
                                   id="interaction-search-term"
                                   name="searchTerm"
                                   placeholder="Nhập tên thuốc hoặc hoạt chất..."
                                   value="@Model.InteractionSearchTerm"
                                   class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
                                   />
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-sliders-h mr-2 text-blue-600"></i>Mức Độ Nghiêm Trọng
                            </label>
                            <select id="interaction-severity-level"
                                    name="severityLevel"
                                    class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                                <option value="">-- Tất cả mức độ --</option>
                                <option value="1" @@(Model.InteractionSeverityLevel == 1 ? "selected" : "")>1 - Nhẹ</option>
                                <option value="2" @@(Model.InteractionSeverityLevel == 2 ? "selected" : "")>2 - Vừa</option>
                                <option value="3" @@(Model.InteractionSeverityLevel == 3 ? "selected" : "")>3 - Trung bình</option>
                                <option value="4" @@(Model.InteractionSeverityLevel == 4 ? "selected" : "")>4 - Nặng</option>
                                <option value="5" @@(Model.InteractionSeverityLevel == 5 ? "selected" : "")>5 - Rất nặng</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" 
                                class="flex-1 md:flex-none bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors flex items-center justify-center gap-2 shadow-md">
                            <i class="fas fa-search"></i>Tìm Kiếm & Lọc
                        </button>
                        <button type="button" 
                                onclick="resetInteractionFilters()"
                                class="flex-1 md:flex-none bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-3 px-8 rounded-lg transition-colors flex items-center justify-center gap-2 shadow-md">
                            <i class="fas fa-redo"></i>Đặt Lại
                        </button>
                    </div>
                </form>

                <div class="mb-6 p-4 bg-blue-100 border-l-4 border-blue-600 rounded">
                    <p class="text-blue-900 font-semibold">
                        <i class="fas fa-info-circle mr-2"></i>Tổng cộng: <span id="interaction-total-records">@Model.InteractionTotalRecords</span> bản ghi
                        | Trang @Model.InteractionCurrentPage / @Model.InteractionTotalPages
                    </p>
                </div>

                <div id="interactions-table-container" class="overflow-x-auto">
                    @if (Model.DrugInteractions.Any())
                    {
                        <table class="w-full text-sm border-collapse">
                            <thead>
                                <tr class="bg-gradient-to-r from-blue-600 to-blue-700 text-white">
                                    <th class="px-6 py-4 text-left font-semibold">#</th>
                                    <th class="px-6 py-4 text-left font-semibold">Thuốc Nguồn</th>
                                    <th class="px-6 py-4 text-left font-semibold">Thuốc Tương Tác</th>
                                    <th class="px-6 py-4 text-center font-semibold">Mức Độ</th>
                                    <th class="px-6 py-4 text-left font-semibold">Mô Tả</th>
                                    <th class="px-6 py-4 text-left font-semibold">Khuyến Nghị</th>
                                    <th class="px-6 py-4 text-center font-semibold">Ngày Tạo</th>
                                    @if (isAdmin)
                                    {
                                        <th class="px-6 py-4 text-center font-semibold">Hành Động</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var interaction in Model.DrugInteractions)
                                {
                                    <tr class="border-b border-gray-200 hover:bg-blue-50 transition-colors">
                                        <td class="px-6 py-4 font-semibold text-gray-700">@(Model.DrugInteractions.IndexOf(interaction) + 1 + (Model.InteractionCurrentPage - 1) * 10)</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-block bg-blue-100 text-blue-900 px-3 py-1 rounded-full font-medium text-sm">
                                                @interaction.SourceDrugName
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-block bg-indigo-100 text-indigo-900 px-3 py-1 rounded-full font-medium text-sm">
                                                @interaction.TargetDrugName
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="inline-block px-3 py-1 rounded-full font-semibold text-sm @interaction.SeverityBadgeClass">
                                                @interaction.SeverityLevelName (@interaction.SeverityLevel)
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-gray-700 max-w-xs">
                                            <div class="truncate" title="@interaction.Description">
                                                @interaction.Description
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-gray-700 max-w-xs">
                                            <div class="truncate" title="@interaction.Recommendation">
                                                @interaction.Recommendation
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-center text-gray-600 text-sm">
                                            @interaction.CreatedAt.ToString("dd/MM/yyyy")
                                        </td>
                                        @if (isAdmin)
                                        {
                                            <td class="px-6 py-4 text-center whitespace-nowrap">
                                                <div class="flex items-center justify-center gap-2">
                                                    <a href="@Url.Action("EditInteraction", "Interaction", new { id = interaction.Id })" 
                                                       class="text-blue-600 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 p-2 rounded-lg transition-colors" 
                                                       title="Sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" 
                                                            onclick="deleteInteraction('@interaction.Id', '@interaction.SourceDrugName', '@interaction.TargetDrugName')" 
                                                            class="text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 p-2 rounded-lg transition-colors" 
                                                            title="Xóa">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-12">
                            <i class="fas fa-inbox text-6xl text-gray-300 mb-4 block"></i>
                            <p class="text-gray-500 text-lg font-semibold">Không có dữ liệu tương tác thuốc nào</p>
                            <p class="text-gray-400">Hãy thêm tương tác thuốc mới hoặc thử lại với tiêu chí tìm kiếm khác</p>
                        </div>
                    }
                </div>

                @if (Model.InteractionTotalPages > 1)
                {
                    <div class="mt-8 flex justify-center gap-2 flex-wrap">
                        @for (int page = 1; page <= Model.InteractionTotalPages; page++)
                        {
                            if (page == Model.InteractionCurrentPage)
                            {
                                <button class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow-md">@@page</button>
                            }
                            else
                            {
                                <button type="button"
                                        onclick="goToInteractionPage(@@page)"
                                        class="px-4 py-2 bg-white border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors">
                                    @@page
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <div id="contraindications-tab" class="tab-content hidden">
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                        <i class="fas fa-exclamation-circle text-red-600"></i>
                        Chống Chỉ Định Giữa Thuốc và Bệnh
                    </h2>
                    @if (isAdmin)
                    {
                        <a href="@Url.Action("CreateContraindication", "Interaction")" 
                           class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors flex items-center gap-2 shadow-md">
                            <i class="fas fa-plus"></i> Thêm Chống Chỉ Định Mới
                        </a>
                    }
                </div>

                <form id="contraindications-filter-form" onsubmit="handleContraindicationSearch(event)" class="mb-8 p-6 bg-gradient-to-br from-red-50 to-pink-50 rounded-xl border border-red-200">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-search mr-2 text-red-600"></i>Tìm kiếm (Thuốc/Bệnh)
                            </label>
                            <input type="text" 
                                   id="contraindication-search-term"
                                   name="searchTerm"
                                   placeholder="Nhập tên thuốc hoặc tên bệnh..."
                                   value="@Model.ContraindicationSearchTerm"
                                   class="w-full px-4 py-3 border border-red-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 bg-white"
                                   />
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-sliders-h mr-2 text-red-600"></i>Mức Độ Rủi Ro
                            </label>
                            <select id="contraindication-risk-level"
                                    name="riskLevel"
                                    class="w-full px-4 py-3 border border-red-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 bg-white">
                                <option value="">-- Tất cả mức độ --</option>
                                <option value="1" @@(Model.ContraindicationRiskLevel == 1 ? "selected" : "")>1 - Thấp</option>
                                <option value="2" @@(Model.ContraindicationRiskLevel == 2 ? "selected" : "")>2 - Vừa</option>
                                <option value="3" @@(Model.ContraindicationRiskLevel == 3 ? "selected" : "")>3 - Trung bình</option>
                                <option value="4" @@(Model.ContraindicationRiskLevel == 4 ? "selected" : "")>4 - Cao</option>
                                <option value="5" @@(Model.ContraindicationRiskLevel == 5 ? "selected" : "")>5 - Rất cao</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" 
                                class="flex-1 md:flex-none bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors flex items-center justify-center gap-2 shadow-md">
                            <i class="fas fa-search"></i>Tìm Kiếm & Lọc
                        </button>
                        <button type="button" 
                                onclick="resetContraindicationFilters()"
                                class="flex-1 md:flex-none bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-3 px-8 rounded-lg transition-colors flex items-center justify-center gap-2 shadow-md">
                            <i class="fas fa-redo"></i>Đặt Lại
                        </button>
                    </div>
                </form>

                <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-600 rounded">
                    <p class="text-red-900 font-semibold">
                        <i class="fas fa-info-circle mr-2"></i>Tổng cộng: <span id="contraindication-total-records">@Model.ContraindicationTotalRecords</span> bản ghi
                        | Trang @Model.ContraindicationCurrentPage / @Model.ContraindicationTotalPages
                    </p>
                </div>

                <div id="contraindications-table-container" class="overflow-x-auto">
                    @if (Model.DrugDiseaseContraindications.Any())
                    {
                        <table class="w-full text-sm border-collapse">
                            <thead>
                                <tr class="bg-gradient-to-r from-red-600 to-pink-600 text-white">
                                    <th class="px-6 py-4 text-left font-semibold">#</th>
                                    <th class="px-6 py-4 text-left font-semibold">Tên Thuốc</th>
                                    <th class="px-6 py-4 text-left font-semibold">Tên Bệnh</th>
                                    <th class="px-6 py-4 text-center font-semibold">Mức Độ Rủi Ro</th>
                                    <th class="px-6 py-4 text-left font-semibold">Cảnh Báo</th>
                                    <th class="px-6 py-4 text-left font-semibold">Rủi Ro</th>
                                    <th class="px-6 py-4 text-center font-semibold">Ngày Tạo</th>
                                    @if (isAdmin)
                                    {
                                        <th class="px-6 py-4 text-center font-semibold">Hành Động</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contraindication in Model.DrugDiseaseContraindications)
                                {
                                    <tr class="border-b border-gray-200 hover:bg-red-50 transition-colors">
                                        <td class="px-6 py-4 font-semibold text-gray-700">@(Model.DrugDiseaseContraindications.IndexOf(contraindication) + 1 + (Model.ContraindicationCurrentPage - 1) * 10)</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-block bg-red-100 text-red-900 px-3 py-1 rounded-full font-medium text-sm">
                                                @contraindication.DrugName
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-block bg-pink-100 text-pink-900 px-3 py-1 rounded-full font-medium text-sm">
                                                @contraindication.DiseaseName
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="inline-block px-3 py-1 rounded-full font-semibold text-sm @contraindication.RiskBadgeClass">
                                                @contraindication.RiskLevelName (@contraindication.RiskLevel)
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-gray-700 max-w-xs">
                                            <div class="truncate" title="@contraindication.Warning">
                                                @contraindication.Warning
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-gray-700 max-w-xs">
                                            <div class="truncate" title="@contraindication.Risk">
                                                @contraindication.Risk
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-center text-gray-600 text-sm">
                                            @contraindication.CreatedAt.ToString("dd/MM/yyyy")
                                        </td>
                                        @if (isAdmin)
                                        {
                                            <td class="px-6 py-4 text-center whitespace-nowrap">
                                                <div class="flex items-center justify-center gap-2">
                                                    <a href="@Url.Action("EditContraindication", "Interaction", new { id = contraindication.Id })" 
                                                       class="text-blue-600 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 p-2 rounded-lg transition-colors" 
                                                       title="Sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" 
                                                            onclick="deleteContraindication('@contraindication.Id', '@contraindication.DrugName', '@contraindication.DiseaseName')" 
                                                            class="text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 p-2 rounded-lg transition-colors" 
                                                            title="Xóa">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-12">
                            <i class="fas fa-inbox text-6xl text-gray-300 mb-4 block"></i>
                            <p class="text-gray-500 text-lg font-semibold">Không có dữ liệu chống chỉ định nào</p>
                            <p class="text-gray-400">Hãy thêm chống chỉ định mới hoặc thử lại với tiêu chí tìm kiếm khác</p>
                        </div>
                    }
                </div>

                @if (Model.ContraindicationTotalPages > 1)
                {
                    <div class="mt-8 flex justify-center gap-2 flex-wrap">
                        @for (int page = 1; page <= Model.ContraindicationTotalPages; page++)
                        {
                            if (page == Model.ContraindicationCurrentPage)
                            {
                                <button class="px-4 py-2 bg-red-600 text-white font-semibold rounded-lg shadow-md">@@page</button>
                            }
                            else
                            {
                                <button type="button"
                                        onclick="goToContraindicationPage(@@page)"
                                        class="px-4 py-2 bg-white border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors">
                                    @@page
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    /**
     * Hàm chuyển đổi giữa các tab
     */
    function switchTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(tab => {
            tab.classList.add('hidden');
        });
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('active', 'border-b-2', 'border-blue-700', 'text-blue-700', 'border-red-600', 'text-red-700');
            btn.classList.add('border-transparent', 'text-gray-600');
        });

        if (tabName === 'interactions') {
            document.getElementById('interactions-tab').classList.remove('hidden');
            document.getElementById('tab-interactions').classList.add('active', 'border-b-2', 'border-blue-700', 'text-blue-700');
            document.getElementById('tab-interactions').classList.remove('border-transparent', 'text-gray-600');
        } else if (tabName === 'contraindications') {
            document.getElementById('contraindications-tab').classList.remove('hidden');
            document.getElementById('tab-contraindications').classList.add('border-b-2', 'border-red-600', 'text-red-700');
            document.getElementById('tab-contraindications').classList.remove('border-transparent', 'text-gray-600');
        }
    }

    /**
     * Hàm tìm kiếm tương tác thuốc
     */
    function handleInteractionSearch(event) {
        event.preventDefault();
        const searchTerm = document.getElementById('interaction-search-term').value.trim();
        const severityLevel = document.getElementById('interaction-severity-level').value;

        fetch('@Url.Action("SearchAndFilterInteractions", "Interaction")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                searchTerm: searchTerm || '',
                severityLevel: severityLevel || '',
                pageNumber: 1
            })
        })
        .then(response => response.text())
        .then(html => { document.getElementById('interactions-table-container').innerHTML = html; })
        .catch(error => { console.error('Lỗi:', error); });
    }

    /**
     * Hàm tìm kiếm chống chỉ định
     */
    function handleContraindicationSearch(event) {
        event.preventDefault();
        const searchTerm = document.getElementById('contraindication-search-term').value.trim();
        const riskLevel = document.getElementById('contraindication-risk-level').value;

        fetch('@Url.Action("SearchAndFilterContraindications", "Interaction")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                searchTerm: searchTerm || '',
                riskLevel: riskLevel || '',
                pageNumber: 1
            })
        })
        .then(response => response.text())
        .then(html => { document.getElementById('contraindications-table-container').innerHTML = html; })
        .catch(error => { console.error('Lỗi:', error); });
    }

    /**
     * Hàm chuyển trang tương tác thuốc
     */
    function goToInteractionPage(pageNumber) {
        const searchTerm = document.getElementById('interaction-search-term').value.trim();
        const severityLevel = document.getElementById('interaction-severity-level').value;

        fetch('@Url.Action("SearchAndFilterInteractions", "Interaction")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                searchTerm: searchTerm || '',
                severityLevel: severityLevel || '',
                pageNumber: pageNumber
            })
        })
        .then(response => response.text())
        .then(html => {
            document.getElementById('interactions-table-container').innerHTML = html;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        })
        .catch(error => console.error('Lỗi:', error));
    }

    /**
     * Hàm chuyển trang chống chỉ định
     */
    function goToContraindicationPage(pageNumber) {
        const searchTerm = document.getElementById('contraindication-search-term').value.trim();
        const riskLevel = document.getElementById('contraindication-risk-level').value;

        fetch('@Url.Action("SearchAndFilterContraindications", "Interaction")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                searchTerm: searchTerm || '',
                riskLevel: riskLevel || '',
                pageNumber: pageNumber
            })
        })
        .then(response => response.text())
        .then(html => {
            document.getElementById('contraindications-table-container').innerHTML = html;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        })
        .catch(error => console.error('Lỗi:', error));
    }

    /**
     * Hàm ĐẶT LẠI bộ lọc
     */
    function resetInteractionFilters() {
        document.getElementById('interaction-search-term').value = '';
        document.getElementById('interaction-severity-level').value = '';
        document.getElementById('interactions-filter-form').dispatchEvent(new Event('submit'));
    }

    function resetContraindicationFilters() {
        document.getElementById('contraindication-search-term').value = '';
        document.getElementById('contraindication-risk-level').value = '';
        document.getElementById('contraindications-filter-form').dispatchEvent(new Event('submit'));
    }

    /* =======================================================
       HÀM XỬ LÝ XOÁ AJAX DÀNH CHO ADMIN
    ======================================================= */
    @if (isAdmin)
    {
        <text>
        function deleteInteraction(id, sourceDrug, targetDrug) {
            if (confirm(`Bạn có chắc chắn muốn xoá tương tác giữa "${sourceDrug}" và "${targetDrug}" không?`)) {
                fetch(`@Url.Action("DeleteInteraction", "Interaction")/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Xoá tương tác thuốc thành công!');
                        // Reload lại danh sách hiện tại
                        document.getElementById('interactions-filter-form').dispatchEvent(new Event('submit'));
                    } else {
                        alert(data.message || 'Xoá thất bại!');
                    }
                })
                .catch(error => console.error('Lỗi khi xoá:', error));
            }
        }

        function deleteContraindication(id, drug, disease) {
            if (confirm(`Bạn có chắc chắn muốn xoá chống chỉ định giữa thuốc "${drug}" và bệnh "${disease}" không?`)) {
                fetch(`@Url.Action("DeleteContraindication", "Interaction")/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Xoá chống chỉ định thành công!');
                        // Reload lại danh sách hiện tại
                        document.getElementById('contraindications-filter-form').dispatchEvent(new Event('submit'));
                    } else {
                        alert(data.message || 'Xoá thất bại!');
                    }
                })
                .catch(error => console.error('Lỗi khi xoá:', error));
            }
        }
        </text>
    }
</script>