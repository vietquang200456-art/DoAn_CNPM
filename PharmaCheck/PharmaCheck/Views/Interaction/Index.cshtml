@model InteractionManagementViewModel

@{
    ViewData["Title"] = "Quản Lý Tương Tác & Chống Chỉ Định | PharmaCheck";
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("Pharmacist");
}

<div class="bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-800 text-white py-8 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-extrabold flex items-center gap-3 tracking-tight">
                    <i class="fas fa-exchange-alt text-blue-200 animate-pulse"></i>
                    Quản Lý Cấu Hình Tương Tác
                </h1>
                <p class="text-blue-100 mt-2 text-sm md:text-base">
                    Hệ thống cấu hình tương tác thuốc - thuốc và danh mục chống chỉ định thuốc - bệnh lý.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="bg-gray-50 min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex gap-2 mb-6 border-b border-gray-200 bg-white p-2 rounded-xl shadow-sm">
            <button type="button" 
                    onclick="switchTab('interactions')" 
                    id="tab-interactions"
                    class="tab-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 py-3 font-bold text-sm rounded-lg transition-all duration-200">
                <i class="fas fa-pills text-base"></i> Tương Tác Thuốc - Thuốc
            </button>
            <button type="button" 
                    onclick="switchTab('contraindications')" 
                    id="tab-contraindications"
                    class="tab-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 py-3 font-bold text-sm rounded-lg transition-all duration-200">
                <i class="fas fa-ban text-base"></i> Chống Chỉ Định Thuốc - Bệnh
            </button>
        </div>

        <div id="interactions-tab" class="tab-content hidden animate-fadeIn">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-gray-100">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                            <span class="w-2 h-6 bg-blue-600 rounded-full"></span>
                            Danh Sách Tương Tác Giữa Các Loại Thuốc
                        </h2>
                    </div>
                    @if (isAdmin)
                    {
                        <a href="@Url.Action("CreateInteraction", "Interaction")" 
                           class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-all shadow-sm hover:shadow flex items-center justify-center gap-2 text-sm">
                            <i class="fas fa-plus-circle"></i> Thêm Tương Tác Mới
                        </a>
                    }
                </div>

                <form id="interactions-filter-form" onsubmit="handleInteractionSearch(event)" class="mb-6 p-5 bg-gray-50 rounded-xl border border-gray-200/80 shadow-inner">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Tìm kiếm (Tên thuốc / Hoạt chất)</label>
                            <div class="relative rounded-lg shadow-sm">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                    <i class="fas fa-search"></i>
                                </div>
                                <input type="text" id="interaction-search-term" name="searchTerm" placeholder="Nhập tên thuốc hoặc hoạt chất cần tra cứu..." value="@Model.InteractionSearchTerm"
                                       class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-sm transition-all"/>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Mức Độ Nghiêm Trọng (5 Mức độ)</label>
                            <select id="interaction-severity-level" name="severityLevel" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white text-sm transition-all">
                                <option value="">-- Tất cả mức độ --</option>
                                <option value="1" selected="@(Model.InteractionSeverityLevel == 1)">Mức độ 1 - Nhẹ</option>
                                <option value="2" selected="@(Model.InteractionSeverityLevel == 2)">Mức độ 2 - Vừa</option>
                                <option value="3" selected="@(Model.InteractionSeverityLevel == 3)">Mức độ 3 - Trung bình</option>
                                <option value="4" selected="@(Model.InteractionSeverityLevel == 4)">Mức độ 4 - Nặng</option>
                                <option value="5" selected="@(Model.InteractionSeverityLevel == 5)">Mức độ 5 - Rất nghiêm trọng</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex justify-end gap-3">
                        <button type="button" onclick="resetInteractionFilters()" class="px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg text-sm transition-all flex items-center gap-2">
                            <i class="fas fa-undo-alt"></i> Đặt lại
                        </button>
                        <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-sm transition-all flex items-center gap-2 shadow-sm">
                            <i class="fas fa-filter"></i> Lọc dữ liệu
                        </button>
                    </div>
                </form>

                <div class="mb-4 px-4 py-3 bg-blue-50 border-l-4 border-blue-500 rounded-r-lg flex flex-col sm:flex-row justify-between text-sm text-blue-800 font-medium shadow-sm">
                    <span class="flex items-center gap-2"><i class="fas fa-info-circle"></i> Tổng kết quả: <strong>@Model.InteractionTotalRecords</strong> bản ghi được tìm thấy</span>
                    <span>Trang <strong>@Model.InteractionCurrentPage</strong> / @Model.InteractionTotalPages</span>
                </div>

                <div id="interactions-table-container" class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
                    @if (Model.DrugInteractions?.Any() == true)
                    {
                        <table class="w-full text-sm border-collapse bg-white">
                            <thead>
                                <tr class="bg-gray-100 text-gray-700 border-b border-gray-200 font-semibold">
                                    <th class="px-4 py-3.5 text-center w-12">STT</th>
                                    <th class="px-5 py-3.5 text-left">Thuốc Nguồn (A)</th>
                                    <th class="px-5 py-3.5 text-left">Thuốc Tương Tác (B)</th>
                                    <th class="px-4 py-3.5 text-center w-48">Mức Độ Lâm Sàng</th>
                                    <th class="px-5 py-3.5 text-left">Cơ Chế / Mô Tả</th>
                                    <th class="px-5 py-3.5 text-left">Xử Trí & Khuyến Nghị</th>
                                    <th class="px-4 py-3.5 text-center w-28">Ngày Cập Nhật</th>
                                    @if (isAdmin) { <th class="px-4 py-3.5 text-center w-24">Thao tác</th> }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                @foreach (var interaction in Model.DrugInteractions)
                                {
                                    <tr class="hover:bg-blue-50/40 transition-colors">
                                        <td class="px-4 py-4 text-center text-gray-500 font-medium">@(Model.DrugInteractions.IndexOf(interaction) + 1 + (Model.InteractionCurrentPage - 1) * 10)</td>
                                        <td class="px-5 py-4">
                                            <span class="inline-flex items-center gap-1.5 font-semibold text-gray-900 bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md text-xs border border-blue-100">
                                                <i class="fas fa-capsules"></i> @interaction.SourceDrugName
                                            </span>
                                        </td>
                                        <td class="px-5 py-4">
                                            <span class="inline-flex items-center gap-1.5 font-semibold text-gray-900 bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-md text-xs border border-indigo-100">
                                                <i class="fas fa-capsules"></i> @interaction.TargetDrugName
                                            </span>
                                        </td>
                                        <td class="px-4 py-4 text-center">
                                            <span class="inline-block px-3 py-1 rounded-full font-bold text-xs shadow-sm border @interaction.SeverityBadgeClass">
                                                @interaction.SeverityLevelName
                                            </span>
                                        </td>
                                        <td class="px-5 py-4 text-gray-600 max-w-xs">
                                            <p class="truncate text-xs" title="@interaction.Description">@interaction.Description</p>
                                        </td>
                                        <td class="px-5 py-4 text-gray-600 max-w-xs">
                                            <p class="truncate text-xs font-medium text-emerald-700" title="@interaction.Recommendation">@interaction.Recommendation</p>
                                        </td>
                                        <td class="px-4 py-4 text-center text-gray-500 text-xs">@interaction.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        @if (isAdmin)
                                        {
                                            <td class="px-4 py-4 text-center">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <a href="@Url.Action("EditInteraction", "Interaction", new { id = interaction.Id })" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-200 p-1.5 rounded-lg transition-all" title="Sửa thông tin"><i class="fas fa-edit text-xs"></i></a>
                                                    <button type="button" onclick="deleteInteraction('@interaction.Id', '@interaction.SourceDrugName', '@interaction.TargetDrugName')" class="text-red-600 hover:text-white hover:bg-red-600 border border-red-200 p-1.5 rounded-lg transition-all" title="Xóa cấu hình"><i class="fas fa-trash-alt text-xs"></i></button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-12 bg-white">
                            <i class="fas fa-folder-open text-5xl text-gray-300 mb-3 block"></i>
                            <p class="text-gray-500 font-bold">Không tìm thấy dữ liệu tương tác thuốc</p>
                            <p class="text-gray-400 text-xs mt-1">Vui lòng điều chỉnh lại bộ lọc hoặc từ khóa tìm kiếm của bạn.</p>
                        </div>
                    }
                </div>

                @if (Model.InteractionTotalPages > 1)
                {
                    <div class="mt-6 flex justify-center items-center gap-1">
                        <button type="button" onclick="goToInteractionPage(1)" disabled="@(Model.InteractionCurrentPage == 1)" class="px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs font-bold bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-40"><i class="fas fa-angle-double-left"></i></button>
                        @for (int page = 1; page <= Model.InteractionTotalPages; page++)
                        {
                            if (page == Model.InteractionCurrentPage) {
                                <span class="px-3 py-1.5 bg-blue-600 text-white font-bold rounded-lg text-xs shadow-sm">@@page</span>
                            } else {
                                <button type="button" onclick="goToInteractionPage(@@page)" class="px-3 py-1.5 border border-gray-300 rounded-lg text-xs font-semibold bg-white text-gray-700 hover:bg-gray-50">@@page</button>
                            }
                        }
                        <button type="button" onclick="goToInteractionPage(@@Model.InteractionTotalPages)" disabled="@(Model.InteractionCurrentPage == Model.InteractionTotalPages)" class="px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs font-bold bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-40"><i class="fas fa-angle-double-right"></i></button>
                    </div>
                }
            </div>
        </div>

        <div id="contraindications-tab" class="tab-content hidden animate-fadeIn">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 pb-4 border-b border-gray-100">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                            <span class="w-2 h-6 bg-red-600 rounded-full"></span>
                            Danh Sách Chống Chỉ Định Thuốc và Bệnh Lý
                        </h2>
                    </div>
                    @if (isAdmin)
                    {
                        <a href="@Url.Action("CreateContraindication", "Interaction")" 
                           class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 px-5 rounded-xl transition-all shadow-sm hover:shadow flex items-center justify-center gap-2 text-sm">
                            <i class="fas fa-plus-circle"></i> Thêm Chống Chỉ Định Mới
                        </a>
                    }
                </div>

                <form id="contraindications-filter-form" onsubmit="handleContraindicationSearch(event)" class="mb-6 p-5 bg-gray-50 rounded-xl border border-gray-200/80 shadow-inner">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Tìm kiếm (Thuốc / Tên bệnh lý)</label>
                            <div class="relative rounded-lg shadow-sm">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                    <i class="fas fa-search"></i>
                                </div>
                                <input type="text" id="contraindication-search-term" name="searchTerm" placeholder="Nhập tên thuốc hoặc tên bệnh lý lâm sàng..." value="@Model.ContraindicationSearchTerm"
                                       class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-white text-sm transition-all"/>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Mức Độ Rủi Ro (5 Mức độ)</label>
                            <select id="contraindication-risk-level" name="riskLevel" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-white text-sm transition-all">
                                <option value="">-- Tất cả mức độ --</option>
                                <option value="1" selected="@(Model.ContraindicationRiskLevel == 1)">Mức độ 1 - Rủi ro thấp</option>
                                <option value="2" selected="@(Model.ContraindicationRiskLevel == 2)">Mức độ 2 - Nhẹ / Theo dõi</option>
                                <option value="3" selected="@(Model.ContraindicationRiskLevel == 3)">Mức độ 3 - Trung bình</option>
                                <option value="4" selected="@(Model.ContraindicationRiskLevel == 4)">Mức độ 4 - Nguy cơ cao</option>
                                <option value="5" selected="@(Model.ContraindicationRiskLevel == 5)">Mức độ 5 - Tuyệt đối chống chỉ định</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex justify-end gap-3">
                        <button type="button" onclick="resetContraindicationFilters()" class="px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg text-sm transition-all flex items-center gap-2">
                            <i class="fas fa-undo-alt"></i> Đặt lại
                        </button>
                        <button type="submit" class="px-6 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg text-sm transition-all flex items-center gap-2 shadow-sm">
                            <i class="fas fa-filter"></i> Lọc dữ liệu
                        </button>
                    </div>
                </form>

                <div class="mb-4 px-4 py-3 bg-red-50 border-l-4 border-red-500 rounded-r-lg flex flex-col sm:flex-row justify-between text-sm text-red-800 font-medium shadow-sm">
                    <span class="flex items-center gap-2"><i class="fas fa-info-circle"></i> Tổng kết quả: <strong>@Model.ContraindicationTotalRecords</strong> bản ghi chống chỉ định</span>
                    <span>Trang <strong>@Model.ContraindicationCurrentPage</strong> / @Model.ContraindicationTotalPages</span>
                </div>

                <div id="contraindications-table-container" class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
                    @if (Model.DrugDiseaseContraindications?.Any() == true)
                    {
                        <table class="w-full text-sm border-collapse bg-white">
                            <thead>
                                <tr class="bg-gray-100 text-gray-700 border-b border-gray-200 font-semibold">
                                    <th class="px-4 py-3.5 text-center w-12">STT</th>
                                    <th class="px-5 py-3.5 text-left">Tên Biệt Dược / Hoạt Chất</th>
                                    <th class="px-5 py-3.5 text-left">Bệnh Lý Chống Chỉ Định</th>
                                    <th class="px-4 py-3.5 text-center w-48">Mức Độ Cảnh Báo</th>
                                    <th class="px-5 py-3.5 text-left">Chi Tiết Cảnh Báo</th>
                                    <th class="px-5 py-3.5 text-left">Hệ Lụy / Rủi Ro</th>
                                    <th class="px-4 py-3.5 text-center w-28">Ngày Cập Nhật</th>
                                    @if (isAdmin) { <th class="px-4 py-3.5 text-center w-24">Thao tác</th> }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                @foreach (var contraindication in Model.DrugDiseaseContraindications)
                                {
                                    <tr class="hover:bg-red-50/30 transition-colors">
                                        <td class="px-4 py-4 text-center text-gray-500 font-medium">@(Model.DrugDiseaseContraindications.IndexOf(contraindication) + 1 + (Model.ContraindicationCurrentPage - 1) * 10)</td>
                                        <td class="px-5 py-4">
                                            <span class="inline-flex items-center gap-1.5 font-semibold text-gray-900 bg-red-50 text-red-700 px-2.5 py-1 rounded-md text-xs border border-red-100">
                                                <i class="fas fa-capsules"></i> @contraindication.DrugName
                                            </span>
                                        </td>
                                        <td class="px-5 py-4">
                                            <span class="inline-flex items-center gap-1.5 font-semibold text-gray-900 bg-amber-50 text-amber-800 px-2.5 py-1 rounded-md text-xs border border-amber-100">
                                                <i class="fas fa-heartbeat"></i> @contraindication.DiseaseName
                                            </span>
                                        </td>
                                        <td class="px-4 py-4 text-center">
                                            <span class="inline-block px-3 py-1 rounded-full font-bold text-xs shadow-sm border @contraindication.RiskBadgeClass">
                                                @contraindication.RiskLevelName
                                            </span>
                                        </td>
                                        <td class="px-5 py-4 text-gray-600 max-w-xs">
                                            <p class="truncate text-xs" title="@contraindication.Warning">@contraindication.Warning</p>
                                        </td>
                                        <td class="px-5 py-4 text-gray-600 max-w-xs">
                                            <p class="truncate text-xs text-red-700 font-medium" title="@contraindication.Risk">@contraindication.Risk</p>
                                        </td>
                                        <td class="px-4 py-4 text-center text-gray-500 text-xs">@contraindication.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        @if (isAdmin)
                                        {
                                            <td class="px-4 py-4 text-center">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <a href="@Url.Action("EditContraindication", "Interaction", new { id = contraindication.Id })" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-200 p-1.5 rounded-lg transition-all" title="Sửa thông tin"><i class="fas fa-edit text-xs"></i></a>
                                                    <button type="button" onclick="deleteContraindication('@contraindication.Id', '@contraindication.DrugName', '@contraindication.DiseaseName')" class="text-red-600 hover:text-white hover:bg-red-600 border border-red-200 p-1.5 rounded-lg transition-all" title="Xóa cấu hình"><i class="fas fa-trash-alt text-xs"></i></button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-12 bg-white">
                            <i class="fas fa-folder-open text-5xl text-gray-300 mb-3 block"></i>
                            <p class="text-gray-500 font-bold">Không tìm thấy dữ liệu chống chỉ định</p>
                            <p class="text-gray-400 text-xs mt-1">Vui lòng điều chỉnh lại bộ lọc hoặc từ khóa tìm kiếm của bạn.</p>
                        </div>
                    }
                </div>

                @if (Model.ContraindicationTotalPages > 1)
                {
                    <div class="mt-6 flex justify-center items-center gap-1">
                        <button type="button" onclick="goToContraindicationPage(1)" disabled="@(Model.ContraindicationCurrentPage == 1)" class="px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs font-bold bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-40"><i class="fas fa-angle-double-left"></i></button>
                        @for (int page = 1; page <= Model.ContraindicationTotalPages; page++)
                        {
                            if (page == Model.ContraindicationCurrentPage) {
                                <span class="px-3 py-1.5 bg-red-600 text-white font-bold rounded-lg text-xs shadow-sm">@@page</span>
                            } else {
                                <button type="button" onclick="goToContraindicationPage(@@page)" class="px-3 py-1.5 border border-gray-300 rounded-lg text-xs font-semibold bg-white text-gray-700 hover:bg-gray-50">@@page</button>
                            }
                        }
                        <button type="button" onclick="goToContraindicationPage(@Model.ContraindicationTotalPages)" disabled="@(Model.ContraindicationCurrentPage == Model.ContraindicationTotalPages)" class="px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs font-bold bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-40"><i class="fas fa-angle-double-right"></i></button>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<style>
    .animate-fadeIn {
        animation: fadeIn 0.2s ease-out forwards;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
    <script>
        window.InteractionApp = {
            urls: {
                searchInteractions: '@Url.Action("SearchAndFilterInteractions", "Interaction")',
                searchContraindications: '@Url.Action("SearchAndFilterContraindications", "Interaction")',
                deleteInteraction: '@Url.Action("DeleteInteraction", "Interaction")',
                deleteContraindication: '@Url.Action("DeleteContraindication", "Interaction")'
            },
            isAdmin: @(isAdmin ? "true" : "false")
        };

        // Hàm điều khiển bật tắt tab nâng cấp (đồng bộ URL params)
        function switchTab(tabName) {
            const tabs = ['interactions', 'contraindications'];
            
            tabs.forEach(t => {
                const contentEl = document.getElementById(`${t}-tab`);
                const btnEl = document.getElementById(`tab-${t}`);
                
                if (t === tabName) {
                    contentEl.classList.remove('hidden');
                    contentEl.classList.add('block');
                    // Giao diện nút khi ACTIVE
                    if(t === 'interactions') {
                        btnEl.className = "tab-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 py-3 font-bold text-sm rounded-lg bg-blue-600 text-white shadow-sm transition-all duration-200";
                    } else {
                        btnEl.className = "tab-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 py-3 font-bold text-sm rounded-lg bg-red-600 text-white shadow-sm transition-all duration-200";
                    }
                } else {
                    contentEl.classList.remove('block');
                    contentEl.classList.add('hidden');
                    // Giao diện nút khi INACTIVE
                    btnEl.className = "tab-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 py-3 font-bold text-sm rounded-lg bg-transparent text-gray-500 hover:text-gray-800 hover:bg-gray-100 transition-all duration-200";
                }
            });

            // Đồng bộ trạng thái vào QueryString của URL không gây lag reload trang
            const url = new URL(window.location);
            url.searchParams.set('tab', tabName);
            window.history.pushState({}, '', url);
        }

        // Tự động nhận diện tab cũ từ URL khi người dùng F5 reload lại trang
        document.addEventListener("DOMContentLoaded", function() {
            const urlParams = new URLSearchParams(window.location.search);
            const activeTab = urlParams.get('tab') || 'interactions'; 
            switchTab(activeTab);
        });
    </script>
    
    <script src="~/js/interaction.js" asp-append-version="true"></script>
}