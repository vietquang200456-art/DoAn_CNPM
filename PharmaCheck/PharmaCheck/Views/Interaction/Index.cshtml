<!-- JavaScript Functions -->
<script>
// Tab switching
function switchTab(tab) {
    const drugdrug = document.getElementById('drugdrug-content');
    const drugdisease = document.getElementById('drugdisease-content');
    const tabDrugDrug = document.getElementById('tab-drugdrug');
    const tabDrugDisease = document.getElementById('tab-drugdisease');

    if (tab === 'drugdrug') {
        drugdrug.classList.remove('hidden');
        drugdisease.classList.add('hidden');
        tabDrugDrug.classList.add('border-amber-600', 'text-amber-700');
        tabDrugDrug.classList.remove('border-transparent', 'text-gray-600');
        tabDrugDisease.classList.remove('border-red-600', 'text-red-700');
        tabDrugDisease.classList.add('border-transparent', 'text-gray-600');
    } else {
        drugdrug.classList.add('hidden');
        drugdisease.classList.remove('hidden');
        tabDrugDrug.classList.remove('border-amber-600', 'text-amber-700');
        tabDrugDrug.classList.add('border-transparent', 'text-gray-600');
        tabDrugDisease.classList.add('border-red-600', 'text-red-700');
        tabDrugDisease.classList.remove('border-transparent', 'text-gray-600');
    }
}

// Modal functions
function openInteractionModal() {
    document.getElementById('interactionModal').classList.remove('hidden');
    document.getElementById('interactionModalTitle').textContent = 'Thêm Tương Tác Mới';
}

function closeInteractionModal() {
    document.getElementById('interactionModal').classList.add('hidden');
}

function editInteraction() {
    document.getElementById('interactionModal').classList.remove('hidden');
    document.getElementById('interactionModalTitle').textContent = 'Chỉnh Sửa Tương Tác';
}

function editContraindication() {
    document.getElementById('interactionModal').classList.remove('hidden');
    document.getElementById('interactionModalTitle').textContent = 'Chỉnh Sửa Chống Chỉ Định';
}

function viewInteractionDetail() {
    alert('Xem chi tiết tương tác - Chưa triển khai');
}

function viewContraindicationDetail() {
    alert('Xem chi tiết chống chỉ định - Chưa triển khai');
}

function deleteInteraction(name) {
    alert('Xóa: ' + name + ' - Chưa triển khai');
}

function deleteContraindication(name) {
    alert('Xóa: ' + name + ' - Chưa triển khai');
}

// Close modal when clicking outside
document.addEventListener('click', function(e) {
    const modal = document.getElementById('interactionModal');
    if (e.target === modal) {
        modal.classList.add('hidden');
    }
});
</script>
