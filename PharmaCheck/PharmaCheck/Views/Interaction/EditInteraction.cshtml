@model PharmaCheck.Models.ViewModels.EditInteractionViewModel

@{
    ViewData["Title"] = "Cập Nhật Cấu Hình Tương Tác | PharmaCheck";
}

<div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white py-6 shadow-md mb-8">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h1 class="text-2xl font-bold flex items-center gap-3">
            <i class="fas fa-edit text-blue-200"></i>
            Chỉnh Sửa Tương Tác Thuốc - Thuốc
        </h1>
        <p class="text-blue-100 text-xs mt-1">Cập nhật thông tin lâm sàng về tương tác giữa hai hoạt chất/biệt dược.</p>
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 mb-12">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
        <form asp-action="EditInteraction" asp-controller="Interaction" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200 shadow-inner">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Thuốc Nguồn (A)</label>
                    <div class="text-sm font-semibold text-blue-700 flex items-center gap-1.5 py-1">
                        <i class="fas fa-capsules"></i> @Model.SourceDrugName
                    </div>
                    <input type="hidden" asp-for="SourceDrugId" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Thuốc Tương Tác (B)</label>
                    <div class="text-sm font-semibold text-indigo-700 flex items-center gap-1.5 py-1">
                        <i class="fas fa-capsules"></i> @Model.TargetDrugName
                    </div>
                    <input type="hidden" asp-for="TargetDrugId" />
                </div>
            </div>

            <div>
                <label asp-for="SeverityLevel" class="block text-sm font-bold text-gray-700 mb-2">Mức Độ Nghiêm Trọng Lâm Sàng</label>
                <select asp-for="SeverityLevel" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white text-sm">
                    <option value="1">Mức độ 1 - Nhẹ</option>
                    <option value="2">Mức độ 2 - Vừa</option>
                    <option value="3">Mức độ 3 - Trung bình</option>
                    <option value="4">Mức độ 4 - Nặng</option>
                    <option value="5">Mức độ 5 - Rất nghiêm trọng</option>
                </select>
                <span asp-validation-for="SeverityLevel" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-bold text-gray-700 mb-2">Cơ Chế / Mô Tả Tương Tác</label>
                <textarea asp-for="Description" rows="4" placeholder="Nhập chi tiết về cơ chế dược động học, dược lực học xảy ra..." 
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Recommendation" class="block text-sm font-bold text-gray-700 mb-2">Biện Pháp Xử Trí & Khuyến Nghị Lâm Sàng</label>
                <textarea asp-for="Recommendation" rows="4" placeholder="Ví dụ: Giãn cách thời gian uống 2 giờ, điều chỉnh liều hoặc thay thế bằng..." 
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all"></textarea>
                <span asp-validation-for="Recommendation" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl text-sm transition-all flex items-center gap-2">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-sm transition-all shadow-sm flex items-center gap-2">
                    <i class="fas fa-save"></i> Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}