@model PharmaCheck.Controllers.PaginatedResult<DrugDiseaseContraindicationDisplayDto>

<!-- ===== BẢNG DỮ LIỆU CHỐNG CHỈ ĐỊNH ===== -->
@if (Model.Items.Any())
{
    <table class="w-full text-sm border-collapse">
        <thead>
            <tr class="bg-gradient-to-r from-red-600 to-pink-600 text-white">
                <th class="px-6 py-4 text-left font-semibold">#</th>
                <th class="px-6 py-4 text-left font-semibold">Tên Thuốc</th>
                <th class="px-6 py-4 text-left font-semibold">Tên Bệnh</th>
                <th class="px-6 py-4 text-center font-semibold">Mức Độ Rủi Ro</th>
                <th class="px-6 py-4 text-left font-semibold">Cảnh Báo</th>
                <th class="px-6 py-4 text-left font-semibold">Rủi Ro</th>
                <th class="px-6 py-4 text-center font-semibold">Ngày Tạo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contraindication in Model.Items)
            {
                <tr class="border-b border-gray-200 hover:bg-red-50 transition-colors">
                    <td class="px-6 py-4 font-semibold text-gray-700">@(Model.Items.IndexOf(contraindication) + 1 + (Model.CurrentPage - 1) * Model.PageSize)</td>
                    <td class="px-6 py-4">
                        <span class="inline-block bg-red-100 text-red-900 px-3 py-1 rounded-full font-medium text-sm">
                            @contraindication.DrugName
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="inline-block bg-pink-100 text-pink-900 px-3 py-1 rounded-full font-medium text-sm">
                            @contraindication.DiseaseName
                        </span>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="inline-block px-3 py-1 rounded-full font-semibold text-sm @contraindication.RiskBadgeClass">
                            @contraindication.RiskLevelName (@contraindication.RiskLevel)
                        </span>
                    </td>
                    <td class="px-6 py-4 text-gray-700 max-w-xs">
                        <div class="truncate" title="@contraindication.Warning">
                            @contraindication.Warning
                        </div>
                    </td>
                    <td class="px-6 py-4 text-gray-700 max-w-xs">
                        <div class="truncate" title="@contraindication.Risk">
                            @contraindication.Risk
                        </div>
                    </td>
                    <td class="px-6 py-4 text-center text-gray-600 text-sm">
                        @contraindication.CreatedAt.ToString("dd/MM/yyyy")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Thống kê và phân trang -->
    <div class="mt-6 flex justify-between items-center flex-wrap gap-4">
        <div class="text-sm text-gray-600">
            Hiển thị <span class="font-semibold">@Model.Items.Count()</span> của <span class="font-semibold">@Model.TotalRecords</span> bản ghi
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="flex gap-2 flex-wrap">
                @for (int page = 1; page <= Model.TotalPages; page++)
                {
                    if (page == Model.CurrentPage)
                    {
                        <button class="px-4 py-2 bg-red-600 text-white font-semibold rounded-lg shadow-md">@@page</button>
                    }
                    else
                    {
                        <button type="button"
                                onclick="goToContraindicationPage(@@page)"
                                class="px-4 py-2 bg-white border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors">
                            @@page
                        </button>
                    }
                }
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-12">
        <i class="fas fa-inbox text-6xl text-gray-300 mb-4 block"></i>
        <p class="text-gray-500 text-lg font-semibold">Không có dữ liệu chống chỉ định nào</p>
        <p class="text-gray-400">Hãy thêm chống chỉ định mới hoặc thử lại với tiêu chí tìm kiếm khác</p>
    </div>
}
