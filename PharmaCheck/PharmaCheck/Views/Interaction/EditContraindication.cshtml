@model PharmaCheck.Models.ViewModels.EditContraindicationViewModel

@{
    ViewData["Title"] = "Cập Nhật Cấu Hình Chống Chỉ Định | PharmaCheck";
}

<div class="bg-gradient-to-r from-red-700 to-rose-800 text-white py-6 shadow-md mb-8">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h1 class="text-2xl font-bold flex items-center gap-3">
            <i class="fas fa-edit text-red-200"></i>
            Chỉnh Sửa Chống Chỉ Định Thuốc - Bệnh Lý
        </h1>
        <p class="text-red-100 text-xs mt-1">Cập nhật thông tin rủi ro lâm sàng khi chỉ định thuốc cho bệnh nhân có bệnh nền đi kèm.</p>
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 mb-12">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
        <form asp-action="EditContraindication" asp-controller="Interaction" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100"></div>
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200 shadow-inner">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Tên Thuốc / Hoạt Chất</label>
                    <div class="text-sm font-semibold text-red-700 flex items-center gap-1.5 py-1">
                        <i class="fas fa-capsules"></i> @Model.DrugName
                    </div>
                    <input type="hidden" asp-for="DrugId" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Bệnh Lý Chống Chỉ Định</label>
                    <div class="text-sm font-semibold text-amber-800 flex items-center gap-1.5 py-1">
                        <i class="fas fa-heartbeat"></i> @Model.DiseaseName
                    </div>
                    <input type="hidden" asp-for="DiseaseId" />
                </div>
            </div>

            <div>
                <label asp-for="RiskLevel" class="block text-sm font-bold text-gray-700 mb-2">Mức Độ Rủi Ro Lâm Sàng</label>
                <select asp-for="RiskLevel" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 bg-white text-sm">
                    <option value="1">Mức độ 1 - Rủi ro thấp</option>
                    <option value="2">Mức độ 2 - Nhẹ / Theo dõi</option>
                    <option value="3">Mức độ 3 - Trung bình</option>
                    <option value="4">Mức độ 4 - Nguy cơ cao</option>
                    <option value="5">Mức độ 5 - Tuyệt đối chống chỉ định</option>
                </select>
                <span asp-validation-for="RiskLevel" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Warning" class="block text-sm font-bold text-gray-700 mb-2">Chi Tiết Nội Dung Cảnh Báo</label>
                <textarea asp-for="Warning" rows="4" placeholder="Nhập hướng dẫn cụ thể cho bác sĩ/dược sĩ khi kê đơn gặp trường hợp này..." 
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-sm transition-all"></textarea>
                <span asp-validation-for="Warning" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Risk" class="block text-sm font-bold text-gray-700 mb-2">Hệ Lụy & Nguy Cơ Sức Khỏe</label>
                <textarea asp-for="Risk" rows="4" placeholder="Ví dụ: Nguy cơ gây suy thận cấp, làm tăng độc tính của thuốc lên gan, kéo dài khoảng QT..." 
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-sm transition-all"></textarea>
                <span asp-validation-for="Risk" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl text-sm transition-all flex items-center gap-2">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-sm transition-all shadow-sm flex items-center gap-2">
                    <i class="fas fa-save"></i> Cập Nhật Cấu Hình
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}