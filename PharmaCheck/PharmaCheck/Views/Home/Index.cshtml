@model IEnumerable<PharmaCheck.Models.Drug>

@{
    ViewData["Title"] = "Trang Chủ | PharmaCheck - Hệ Thống An Toàn Đơn Thuốc";
}

<!-- 1. HERO SECTION (Giao diện mở màn chuyên nghiệp) -->
<section class="relative bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 text-white py-20 overflow-hidden">
    <!-- Các hiệu ứng vòng tròn background mờ hiện đại -->
    <div class="absolute top-0 right-0 -mt-12 -mr-12 w-96 h-96 bg-white opacity-5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-blue-400 opacity-10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6 text-center md:text-left">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-blue-100 uppercase tracking-wider border border-white/10">
                    <i class="fas fa-shield-alt text-emerald-400"></i> Tiêu chuẩn lâm sàng 2026
                </span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none">
                    PharmaCheck
                </h1>
                <p class="text-lg sm:text-xl text-blue-100 max-w-xl mx-auto md:mx-0 font-light leading-relaxed">
                    Giải pháp hỗ trợ quyết định lâm sàng, tự động rà soát tương tác thuốc và chống chỉ định bệnh lý chỉ trong vài giây cho phòng khám và bệnh viện.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start pt-2">
                    <a asp-controller="Home" asp-action="Check"
                       class="inline-flex items-center justify-center gap-2 bg-white text-blue-700 px-8 py-4 rounded-xl font-bold hover:bg-blue-50 transition-all duration-300 transform hover:-translate-y-0.5 shadow-xl hover:shadow-white/10">
                        <i class="fas fa-search-plus text-lg"></i> Bắt Đầu Tra Cứu Ngay
                    </a>
                    <a href="#benefits" 
                       class="inline-flex items-center justify-center gap-2 border-2 border-white/30 bg-white/5 backdrop-blur-sm text-white px-8 py-4 rounded-xl font-semibold hover:bg-white/10 hover:border-white transition-all duration-300">
                        Tìm Hiểu Tính Năng
                    </a>
                </div>
            </div>
            
            <!-- Graphic minh họa thiết kế 3D mềm mại tinh giản -->
            <div class="hidden md:flex justify-center relative">
                <div class="w-80 h-80 bg-white/10 rounded-3xl backdrop-blur-md border border-white/20 p-8 flex flex-col justify-between shadow-2xl relative animate-float">
                    <div class="flex justify-between items-center">
                        <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-blue-600 shadow-md">
                            <i class="fas fa-heartbeat text-2xl animate-pulse text-red-500"></i>
                        </div>
                        <span class="text-xs font-mono bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded-full border border-emerald-500/30">Live System</span>
                    </div>
                    <div class="space-y-3">
                        <div class="h-3 bg-white/30 rounded-full w-2/3"></div>
                        <div class="h-3 bg-white/20 rounded-full w-full"></div>
                        <div class="h-3 bg-white/20 rounded-full w-4/5"></div>
                    </div>
                    <div class="bg-white text-gray-900 p-4 rounded-xl shadow-lg border-l-4 border-amber-500 flex items-start gap-3">
                        <i class="fas fa-exclamation-triangle text-amber-500 text-lg mt-0.5"></i>
                        <div>
                            <p class="text-xs font-bold">Cảnh báo tương tác!</p>
                            <p class="text-[10px] text-gray-500">Mức độ trung bình giữa các hoạt chất được chọn.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. STATS SECTION (Báo cáo số liệu tạo độ tin cậy) -->
<section class="bg-gray-50 py-10 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="p-4 bg-white rounded-xl shadow-sm border border-gray-100">
                <p class="text-3xl font-extrabold text-blue-600 mb-1">10,000+</p>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Danh mục biệt dược</p>
            </div>
            <div class="p-4 bg-white rounded-xl shadow-sm border border-gray-100">
                <p class="text-3xl font-extrabold text-blue-600 mb-1">2,500+</p>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Cơ chế tương tác</p>
            </div>
            <div class="p-4 bg-white rounded-xl shadow-sm border border-gray-100">
                <p class="text-3xl font-extrabold text-blue-600 mb-1">ICD-10</p>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Chuẩn mã hóa bệnh lý</p>
            </div>
            <div class="p-4 bg-white rounded-xl shadow-sm border border-gray-100">
                <p class="text-3xl font-extrabold text-blue-600 mb-1">&lt; 0.5s</p>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Tốc độ phản hồi</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. BENEFITS SECTION (Lý do chọn hệ thống này) -->
<section id="benefits" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl font-bold text-gray-900 tracking-tight sm:text-4xl mb-4">
                Tại Sao Nên Sử Dụng Hệ Thống PharmaCheck?
            </h2>
            <p class="text-lg text-gray-500 font-light">
                Hỗ trợ đắc lực cho Y - Bác sĩ tối ưu hóa phác đồ điều trị, giảm thiểu sai sót y khoa không đáng có trong quá trình kê đơn thuốc.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            <!-- Lợi ích 1 -->
            <div class="p-8 rounded-2xl border border-gray-200 hover:border-blue-500 hover:shadow-xl transition-all duration-300 group">
                <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                    <i class="fas fa-shield-virus text-xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">Phòng tránh rủi ro chéo</h3>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Kiểm tra xung đột đa thuốc (Drug-Drug) và các cảnh báo chống chỉ định nghiêm ngặt liên quan đến bệnh nền của bệnh nhân.
                </p>
            </div>
            <!-- Lợi ích 2 -->
            <div class="p-8 rounded-2xl border border-gray-200 hover:border-blue-500 hover:shadow-xl transition-all duration-300 group">
                <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                    <i class="fas fa-bolt text-xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">Tối ưu thời gian lâm sàng</h3>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Thay vì tra cứu sách hướng dẫn thủ công dày cộm, hệ thống trả kết quả phân tích mức độ tương tác chỉ với 1 click chuột.
                </p>
            </div>
            <!-- Lợi ích 3 -->
            <div class="p-8 rounded-2xl border border-gray-200 hover:border-blue-500 hover:shadow-xl transition-all duration-300 group">
                <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                    <i class="fas fa-sticky-note text-xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">Khuyến cáo rõ ràng</h3>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Không chỉ cảnh báo, hệ thống cung cấp chi tiết giải thích cơ chế sinh lý học và đưa ra đề xuất thay thế lâm sàng an toàn.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 4. WORKFLOW SECTION (Quy trình 3 bước trực quan) -->
<section class="py-20 bg-gray-50 border-t border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Quy Trình Hoạt Động Đơn Giản</h2>
            <p class="text-gray-500">Quy trình xử lý dữ liệu thông minh diễn ra hoàn toàn khép kín và bảo mật.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 relative">
            <!-- Bước 1 -->
            <div class="text-center relative space-y-4">
                <div class="w-16 h-16 bg-white border-2 border-blue-600 text-blue-600 rounded-full flex items-center justify-center font-bold text-xl mx-auto shadow-md">
                    1
                </div>
                <h4 class="text-lg font-bold text-gray-900">Chọn Thuốc & Bệnh Lý</h4>
                <p class="text-gray-500 text-sm max-w-xs mx-auto">Nhập tên biệt dược, hoạt chất gốc hoặc nhập mã chuẩn bệnh lý danh mục ICD-10.</p>
            </div>
            <!-- Bước 2 -->
            <div class="text-center relative space-y-4">
                <div class="w-16 h-16 bg-white border-2 border-blue-600 text-blue-600 rounded-full flex items-center justify-center font-bold text-xl mx-auto shadow-md">
                    2
                </div>
                <h4 class="text-lg font-bold text-gray-900">Đối Chiếu Thuật Toán</h4>
                <p class="text-gray-500 text-sm max-w-xs mx-auto">Hệ thống quét dữ liệu quan hệ, phân tích chéo ma trận xung đột sinh hóa học.</p>
            </div>
            <!-- Bước 3 -->
            <div class="text-center relative space-y-4">
                <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto shadow-md">
                    3
                </div>
                <h4 class="text-lg font-bold text-gray-900">Xem Kết Quả Lâm Sàng</h4>
                <p class="text-gray-500 text-sm max-w-xs mx-auto">Nhận báo cáo phân màu mức độ nguy hiểm kèm lời khuyên y khoa tương ứng.</p>
            </div>
        </div>
    </div>
</section>

<!-- 5. DANH SÁCH THUỐC PARTIAL SECTION -->
<section id="features" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Cơ Sở Dữ Liệu Thuốc Hiện Hành</h2>
                <p class="text-gray-500 mt-2">Tra cứu danh sách các nhóm thuốc có sẵn trong hệ thống quản lý.</p>
            </div>
        </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <partial name="~/Views/Home/dsthuoc.cshtml" />
    </div>
</section>

<!-- 6. TÍNH NĂNG CHÍNH PARTIAL SECTION -->
<section class="py-20 bg-gray-50 border-t border-b border-gray-200">
    <partial name="~/Views/Home/tinhnangchinh.cshtml" />
</section>

<!-- 7. CALL TO ACTION (CTA cuối trang thôi thúc hành động) -->
<section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl p-8 sm:p-12 text-white text-center space-y-6 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent"></div>
            <h3 class="text-3xl font-bold tracking-tight">Sẵn sàng tối ưu hóa quy trình kê đơn?</h3>
            <p class="text-blue-100 max-w-2xl mx-auto font-light">
                Bảo vệ sức khỏe bệnh nhân toàn diện và chuyên nghiệp hóa quy trình thăm khám ngay hôm nay cùng PharmaCheck.
            </p>
            <a asp-controller="Home" asp-action="Check"
                class="inline-flex items-center gap-2 bg-white text-blue-700 px-8 py-4 rounded-xl font-bold text-lg hover:bg-blue-50 hover:scale-105 transition-all duration-300 shadow-lg">
                <i class="fas fa-stethoscope"></i> Truy Cập Phòng Tra Cứu
            </a>
            
        </div>
    </div>
</section>

<!-- Thêm cụm CSS Animation tùy biến nhỏ để làm mượt giao diện -->
<style>
    @Html.Raw("@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }")
    .animate-float {
        animation: float 4s ease-in-out infinite;
    }
</style>