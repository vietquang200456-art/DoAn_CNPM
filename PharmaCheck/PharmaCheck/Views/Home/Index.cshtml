@model IEnumerable<PharmaCheck.Models.Drug>

@{
    ViewData["Title"] = "Tra Cứu Tương Tác Thuốc - Bệnh | PharmaCheck";
}

<section class="bg-gradient-to-r from-medical-700 to-medical-600 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
                <h1 class="text-4xl md:text-5xl font-bold mb-4 flex items-center gap-3">
                    <i class="fas fa-stethoscope"></i>
                    PharmaCheck
                </h1>
                <p class="text-xl text-blue-100 mb-6">
                    Hệ thống tra cứu tương tác thuốc - bệnh an toàn, nhanh chóng dành cho phòng khám chuyên nghiệp.
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <button onclick="document.getElementById('searchSection').scrollIntoView({behavior: 'smooth'})"
                            class="bg-white text-medical-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors flex items-center justify-center gap-2">
                        <i class="fas fa-search"></i> Bắt Đầu Tra Cứu
                    </button>
                    <a href="#features" class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-medical-700 transition-colors flex items-center justify-center gap-2">
                        <i class="fas fa-arrow-down"></i> Tìm Hiểu Thêm
                    </a>
                </div>
            </div>
            <div class="hidden md:flex justify-center">
                <div class="relative w-64 h-64">
                    <div class="absolute inset-0 bg-white rounded-full opacity-10 animate-pulse"></div>
                    <div class="absolute inset-8 bg-white rounded-full opacity-20"></div>
                    <i class="fas fa-pills text-9xl text-white opacity-70 flex items-center justify-center absolute inset-0"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="searchSection" class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">
                <i class="fas fa-search text-medical-700 mr-3"></i>Tra Cứu Tương Tác Thuốc & Bệnh
            </h2>
            <div class="bg-white rounded-xl shadow-lg border border-slate-200 p-8">
                <div x-data="searchApp()" class="space-y-6">
                    <div class="relative">
                        <label class="block text-lg font-semibold text-gray-900 mb-3">
                            <i class="fas fa-pills text-medical-700 mr-2"></i>Danh Sách Thuốc (Hoạt Chất)
                        </label>
                        <div class="relative">
                            <input type="text" 
                                   x-model="drugSearch"
                                   @@input.debounce.300ms="filterDrugs()"
                                   placeholder="Nhập tên thuốc, hoạt chất... (VD: Amoxicillin, Paracetamol)"
                                   class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                            <i class="fas fa-pills absolute right-4 top-4 text-medical-600"></i>
                        </div>
                        <div x-show="selectedDrugs.length > 0" class="mt-4 flex flex-wrap gap-2">
                            <template x-for="drug in selectedDrugs" :key="drug.id">
                                <span class="inline-flex items-center gap-2 bg-medical-100 text-medical-800 px-4 py-2 rounded-full text-sm font-medium">
                                    <i class="fas fa-check-circle"></i>
                                    <span x-text="drug.name"></span>
                                    <button type="button" @@click="removeDrug(drug)" class="hover:text-medical-600 transition-colors">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </span>
                            </template>
                        </div>
                        <div x-show="showDrugDropdown && filteredDrugs.length > 0" 
                             class="absolute left-0 right-0 mt-2 bg-white border-2 border-medical-300 rounded-lg shadow-lg z-20 max-h-64 overflow-y-auto"
                             x-on:click.outside="showDrugDropdown = false">
                            <template x-for="drug in filteredDrugs" :key="drug.id">
                                <button type="button"
                                        @@click="selectDrug(drug)"
                                        class="w-full text-left px-4 py-3 hover:bg-medical-50 transition-colors border-b border-slate-100 last:border-b-0 flex flex-col">
                                    <span class="font-medium text-gray-900">
                                        <i class="fas fa-pills text-medical-600 mr-2"></i><span x-text="drug.name"></span>
                                    </span>
                                    <span class="text-xs text-gray-500 pl-6" x-text="'Hoạt chất: ' + drug.activeIngredient"></span>
                                </button>
                            </template>
                        </div>
                    </div>

                    <div class="relative">
                        <label class="block text-lg font-semibold text-gray-900 mb-3">
                            <i class="fas fa-heartbeat text-danger mr-2"></i>Danh Sách Bệnh Lý (ICD-10 / Tên Bệnh)
                        </label>
                        <div class="relative">
                            <input type="text"
                                   x-model="diseaseSearch"
                                   @@input.debounce.300ms="filterDiseases()"
                                   placeholder="Nhập tên bệnh hoặc mã... (VD: Tăng huyết áp, Đái tháo đường)"
                                   class="w-full px-4 py-3 border-2 border-slate-300 rounded-lg focus:outline-none focus:border-medical-600 transition-colors">
                            <i class="fas fa-heartbeat absolute right-4 top-4 text-medical-600"></i>
                        </div>
                        <div x-show="selectedDiseases.length > 0" class="mt-4 flex flex-wrap gap-2">
                            <template x-for="disease in selectedDiseases" :key="disease.id">
                                <span class="inline-flex items-center gap-2 bg-amber-100 text-amber-900 px-4 py-2 rounded-full text-sm font-medium">
                                    <i class="fas fa-check-circle"></i>
                                    <span x-text="disease.name"></span>
                                    <button type="button" @@click="removeDisease(disease)" class="hover:text-amber-700 transition-colors">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </span>
                            </template>
                        </div>
                        <div x-show="showDiseaseDropdown && filteredDiseases.length > 0"
                             class="absolute left-0 right-0 mt-2 bg-white border-2 border-medical-300 rounded-lg shadow-lg z-20 max-h-64 overflow-y-auto"
                             x-on:click.outside="showDiseaseDropdown = false">
                            <template x-for="disease in filteredDiseases" :key="disease.id">
                                <button type="button"
                                        @@click="selectDisease(disease)"
                                        class="w-full text-left px-4 py-3 hover:bg-medical-50 transition-colors border-b border-slate-100 last:border-b-0">
                                    <i class="fas fa-heartbeat text-danger mr-2"></i>
                                    <span x-text="disease.name"></span>
                                </button>
                            </template>
                        </div>
                    </div>

                    <div class="flex gap-3 pt-4 border-t border-slate-200">
                        <button @@click="checkInteractions()"
                                :disabled="selectedDrugs.length === 0 && selectedDiseases.length === 0"
                                class="flex-1 bg-medical-700 text-white px-6 py-3 rounded-lg font-semibold hover:bg-medical-800 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-check-circle"></i> Kiểm Tra Tương Tác
                        </button>
                        <button @@click="clearAll()"
                                class="px-6 py-3 border-2 border-slate-300 text-gray-700 rounded-lg font-semibold hover:bg-slate-50 transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-redo"></i> Xóa Tất Cả
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="resultsSection" class="py-12 bg-slate-50" x-show="showResults" x-cloak>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold mb-8 text-gray-900">
            <i class="fas fa-chart-bar text-medical-700 mr-3"></i>Kết Quả Kiểm Tra
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden card-hover">
                <div class="bg-medical-700 text-white px-6 py-4 flex items-center gap-3">
                    <i class="fas fa-exchange-alt text-xl"></i>
                    <h3 class="text-xl font-semibold">Tương Tác Thuốc - Thuốc</h3>
                </div>
                <div class="p-6 space-y-4">
                    <template x-for="interaction in drugDrugInteractions" :key="interaction.id">
                        <div class="p-4 rounded-lg border-l-4" 
                             :class="{
                                 'border-red-500 bg-red-50 text-red-950': interaction.level === 3,
                                 'border-amber-500 bg-amber-50 text-amber-950': interaction.level === 2,
                                 'border-blue-500 bg-blue-50 text-blue-950': interaction.level === 1
                             }">
                            <div class="flex items-start gap-3">
                                <i :class="'fas ' + interaction.icon + ' text-xl mt-1'"></i>
                                <div class="flex-1">
                                    <h4 class="font-bold" x-text="interaction.title"></h4>
                                    <p class="text-sm mt-1" x-text="interaction.description"></p>
                                    <div class="mt-3 p-3 bg-white bg-opacity-60 rounded border text-sm">
                                        <strong>Khuyến cáo: </strong>
                                        <span x-text="interaction.recommendation"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div x-show="drugDrugInteractions.length === 0" class="text-center py-8 text-gray-500">
                        <i class="fas fa-check-circle text-3xl text-green-500 mb-2"></i>
                        <p>Không có tương tác nguy hiểm giữa các thuốc đã chọn</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden card-hover">
                <div class="bg-danger px-6 py-4 text-white flex items-center gap-3">
                    <i class="fas fa-exclamation-triangle text-xl"></i>
                    <h3 class="text-xl font-semibold">Chống Chỉ Định - Bệnh</h3>
                </div>

                <div class="p-6 space-y-4">
                    <template x-for="contraindication in drugDiseaseContraindications" :key="contraindication.id">
                        <div class="p-4 rounded-lg border-l-4"
                             :class="{
                                 'border-red-500 bg-red-50 text-red-950': contraindication.level === 3,
                                 'border-amber-500 bg-amber-50 text-amber-950': contraindication.level === 2,
                                 'border-green-500 bg-green-50 text-green-950': contraindication.level === 1
                             }">
                            <div class="flex items-start gap-3">
                                <i :class="'fas ' + contraindication.icon + ' text-xl mt-1'"></i>
                                <div class="flex-1">
                                    <h4 class="font-bold" x-text="contraindication.title"></h4>
                                    <p class="text-sm mt-1" x-text="contraindication.description"></p>
                                    <div class="mt-3 p-3 bg-white bg-opacity-60 rounded border text-sm">
                                        <strong>Khuyến cáo: </strong>
                                        <span x-text="contraindication.recommendation"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div x-show="drugDiseaseContraindications.length === 0" class="text-center py-8 text-gray-500">
                        <i class="fas fa-check-circle text-3xl text-green-500 mb-2"></i>
                        <p>Không có chống chỉ định giữa thuốc và bệnh đã chọn</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-8 p-6 rounded-xl text-center border-2" :class="overallStatus.class">
            <i :class="'fas ' + overallStatus.icon + ' text-4xl mb-3'"></i>
            <h3 class="text-2xl font-bold mb-2" x-text="overallStatus.message"></h3>
            <p x-text="overallStatus.detail"></p>
        </div>
    </div>
</section>
<!-- danh sách thuốc nổi bật -->
<section id="features" class="py-12 bg-white border-t border-slate-200">
    <partial name="~/Views/Home/dsthuoc.cshtml" />
</section>

<section class="py-12 bg-slate-50 border-t border-slate-200">
    <partial name ="~/Views/Home/tinhnangchinh.cshtml" />
</section>

@Html.AntiForgeryToken()

<script>
    function searchApp() {
        return {
            drugSearch: '',
            diseaseSearch: '',
            showDrugDropdown: false,
            showDiseaseDropdown: false,
            filteredDrugs: [],
            filteredDiseases: [],
            selectedDrugs: [],
            selectedDiseases: [],
            showResults: false,
            drugDrugInteractions: [],
            drugDiseaseContraindications: [],
            overallStatus: { class: 'border-green-500 bg-green-50 text-green-900', icon: 'fa-check-circle', message: 'Hệ thống sẵn sàng', detail: 'Vui lòng chọn thuốc hoặc bệnh lý để thực hiện kiểm tra.' },

            filterDrugs() {
                if (this.drugSearch.trim().length < 2) {
                    this.filteredDrugs = [];
                    this.showDrugDropdown = false;
                    return;
                }
                fetch(`/Home/SearchDrugs?term=${encodeURIComponent(this.drugSearch)}`)
                    .then(res => res.json())
                    .then(data => {
                        this.filteredDrugs = data;
                        this.showDrugDropdown = true;
                    });
            },

            selectDrug(drug) {
                if (!this.selectedDrugs.some(d => d.id === drug.id)) {
                    this.selectedDrugs.push(drug);
                }
                this.drugSearch = '';
                this.showDrugDropdown = false;
            },

            removeDrug(drug) {
                this.selectedDrugs = this.selectedDrugs.filter(d => d.id !== drug.id);
            },

            filterDiseases() {
                if (this.diseaseSearch.trim().length < 2) {
                    this.filteredDiseases = [];
                    this.showDiseaseDropdown = false;
                    return;
                }
                fetch(`/Home/SearchDiseases?term=${encodeURIComponent(this.diseaseSearch)}`)
                    .then(res => res.json())
                    .then(data => {
                        this.filteredDiseases = data;
                        this.showDiseaseDropdown = true;
                    });
            },

            selectDisease(disease) {
                if (!this.selectedDiseases.some(d => d.id === disease.id)) {
                    this.selectedDiseases.push(disease);
                }
                this.diseaseSearch = '';
                this.showDiseaseDropdown = false;
            },

            removeDisease(disease) {
                this.selectedDiseases = this.selectedDiseases.filter(d => d.id !== disease.id);
            },

            checkInteractions() {
                const payload = {
                    drugIds: this.selectedDrugs.map(d => d.id),
                    diseaseIds: this.selectedDiseases.map(d => d.id)
                };

                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : '';

                fetch('/Home/CheckInteractions', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(res => {
                    if (!res.ok) {
                        throw new Error(`Server trả về mã lỗi: ${res.status}`);
                    }
                    return res.json();
                })
                .then(data => {
                    this.drugDrugInteractions = data.drugDrugInteractions || [];
                    this.drugDiseaseContraindications = data.drugDiseaseContraindications || [];
                    this.showResults = true;

                    this.calculateOverallStatus();

                    setTimeout(() => {
                        document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
                    }, 150);
                })
                .catch(err => {
                    console.error("Lỗi kiểm tra tương tác:", err);
                    alert("Không thể kết nối hoặc xử lý dữ liệu với hệ thống máy chủ.");
                });
            },

            // ĐÃ CẬP NHẬT: Thay đổi logic kiểm tra tổng quát dựa trên thuộc tính .level số (1, 2, 3)
            calculateOverallStatus() {
                const blueprints = this.drugDrugInteractions || [];
                const contraprints = this.drugDiseaseContraindications || [];

                const hasDanger = blueprints.some(i => i.level === 3) || contraprints.some(c => c.level === 3);
                const hasWarning = blueprints.some(i => i.level === 2) || contraprints.some(c => c.level === 2);

                if (hasDanger) {
                    this.overallStatus = {
                        class: 'border-red-500 bg-red-50 text-red-900',
                        icon: 'fa-ban',
                        message: 'Cảnh báo nguy hiểm xảy ra!',
                        detail: 'Phát hiện chống chỉ định hoặc tương tác mức độ nghiêm trọng cao. Cân nhắc đổi đơn thuốc.'
                    };
                } else if (hasWarning) {
                    this.overallStatus = {
                        class: 'border-amber-500 bg-amber-50 text-amber-950',
                        icon: 'fa-exclamation-triangle',
                        message: 'Cần chú ý theo dõi!',
                        detail: 'Phát hiện tương tác trung bình hoặc các lưu ý cần thận trọng lâm sàng khi sử dụng đồng thời.'
                    };
                } else {
                    this.overallStatus = {
                        class: 'border-green-500 bg-green-50 text-green-900',
                        icon: 'fa-check-circle',
                        message: 'An toàn kiểm nghiệm thành công',
                        detail: 'Không tìm thấy tương tác nguy hại chéo giữa các thuốc và tình trạng bệnh lý đã chọn.'
                    };
                }
            },

            clearAll() {
                this.selectedDrugs = [];
                this.selectedDiseases = [];
                this.drugSearch = '';
                this.diseaseSearch = '';
                this.showResults = false;
                this.drugDrugInteractions = [];
                this.drugDiseaseContraindications = [];
                this.overallStatus = { class: 'border-green-500 bg-green-50 text-green-900', icon: 'fa-check-circle', message: 'Hệ thống sẵn sàng', detail: 'Vui lòng chọn thuốc hoặc bệnh lý để thực hiện kiểm tra.' };
            }
        }
    }
</script>

<style>
    [x-cloak] { display: none !important; }
</style>