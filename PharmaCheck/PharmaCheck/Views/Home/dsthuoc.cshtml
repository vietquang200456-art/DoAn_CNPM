@model List<PharmaCheck.Models.Drug>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">
            <i class="fas fa-chart-line text-medical-700 mr-3"></i>Danh Sách Thuốc Xem Nhiều Nhất
        </h2>
        <div class="grid md:grid-cols-3 gap-6 mb-12">
            @if (Model != null && Model.Any())
            {
                foreach (var drug in Model)
                {
                    <div class="bg-gradient-to-br from-medical-50 to-medical-100 p-6 rounded-xl shadow-md border border-medical-200 card-hover flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <i class="fas fa-pills text-3xl text-medical-700"></i>
                                <span class="text-xs bg-medical-200 text-medical-800 font-bold px-2 py-1 rounded-full flex items-center gap-1">
                                    <i class="fas fa-eye"></i> @drug.ViewCount
                                </span>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 mb-1">@drug.Name</h3>
                            <p class="text-xs text-slate-600 font-semibold mb-2">Hoạt chất: @drug.ActiveIngredient</p>
                            <p class="text-sm text-gray-600 line-clamp-2">@drug.Function</p>
                        </div>
                        <div class="text-xs text-gray-400 mt-4 text-right">NX: @drug.Manufacturer</div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-3 text-center text-gray-500 py-4">
                    Không có thuốc nổi bật nào được tìm thấy.
                </div>
            }
        </div>
    </div>
