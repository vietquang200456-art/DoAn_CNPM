@model IEnumerable<PharmaCheck.Models.Drug>

@{
    ViewData["Title"] = "Phòng Lâm Sàng | PharmaCheck - Tra Cứu Tương Tác";
}

<section class="relative bg-slate-900 text-white py-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-blue-900/50 to-indigo-900/50"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold bg-blue-500/20 text-blue-300 uppercase tracking-widest mb-3 border border-blue-500/30">
                    <i class="fas fa-stethoscope"></i> Không gian làm việc bác sĩ
                </span>
                <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-2">Phòng Lâm Sàng</h1>
                <p class="text-slate-300 max-w-xl text-lg font-light leading-relaxed">
                    Kiểm tra xung đột đa thuốc và chống chỉ định bệnh lý theo thời gian thực dựa trên thuật toán ma trận sinh hóa.
                </p>
            </div>
            <div class="hidden md:flex items-center gap-3 px-5 py-3 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl">
                <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <span class="text-xs font-mono text-slate-300">V.2026.4.12</span>
            </div>
        </div>
    </div>
</section>

<div x-data="searchApp()" class="min-h-screen bg-slate-50 py-12">
    
    <section id="searchSection" class="mb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-slate-100 p-8 sm:p-10">
                <div class="space-y-10">
                    
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-3 uppercase tracking-wider flex items-center gap-2">
                            <span class="w-1.5 h-6 bg-blue-600 rounded-full"></span>
                            Danh Sách Thuốc / Hoạt Chất
                        </label>
                        <div class="relative group">
                            <input type="text" x-model="drugSearch" @@input.debounce.300ms="filterDrugs()"
                                   placeholder="Nhập tên thương mại hoặc hoạt chất..."
                                   class="w-full pl-5 pr-14 py-4 bg-slate-50 border-2 border-slate-200 rounded-2xl focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all text-slate-900 placeholder-slate-400">
                            <div class="absolute right-5 top-5 text-slate-400 group-focus-within:text-blue-600 transition-colors">
                                <i class="fas fa-pills text-lg"></i>
                            </div>
                        </div>
                        
                        <div x-show="showDrugDropdown && filteredDrugs.length > 0" 
                             class="absolute left-0 right-0 mt-2 bg-white border border-slate-100 rounded-2xl shadow-2xl z-30 max-h-64 overflow-y-auto divide-y divide-slate-50"
                             x-on:click.outside="showDrugDropdown = false" x-cloak>
                            <template x-for="drug in filteredDrugs" :key="drug.id">
                                <button type="button" @@click="selectDrug(drug)"
                                        class="w-full text-left px-5 py-4 hover:bg-blue-50 transition-colors flex flex-col gap-1">
                                    <span class="font-bold text-slate-800" x-text="drug.name"></span>
                                    <span class="text-xs text-slate-400" x-text="drug.activeIngredient"></span>
                                </button>
                            </template>
                        </div>

                        <div x-show="selectedDrugs.length > 0" class="mt-4 flex flex-wrap gap-2" x-cloak>
                            <template x-for="drug in selectedDrugs" :key="drug.id">
                                <span class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-4 py-2 rounded-xl text-sm font-medium border border-blue-100 shadow-sm">
                                    <i class="fas fa-check-circle text-blue-500"></i>
                                    <span x-text="drug.name"></span>
                                    <button type="button" @@click="removeDrug(drug)" class="hover:text-red-500 ml-1"><i class="fas fa-times"></i></button>
                                </span>
                            </template>
                        </div>
                    </div>

                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-3 uppercase tracking-wider flex items-center gap-2">
                            <span class="w-1.5 h-6 bg-indigo-600 rounded-full"></span>
                            Danh Sách Bệnh Lý (ICD-10)
                        </label>
                        <div class="relative group">
                            <input type="text" x-model="diseaseSearch" @@input.debounce.300ms="filterDiseases()"
                                   placeholder="Nhập tên bệnh hoặc mã ICD-10..."
                                   class="w-full pl-5 pr-14 py-4 bg-slate-50 border-2 border-slate-200 rounded-2xl focus:outline-none focus:bg-white focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/10 transition-all text-slate-900 placeholder-slate-400">
                            <div class="absolute right-5 top-5 text-slate-400 group-focus-within:text-indigo-600 transition-colors">
                                <i class="fas fa-heartbeat text-lg"></i>
                            </div>
                        </div>
                        
                        <div x-show="showDiseaseDropdown && filteredDiseases.length > 0"
                             class="absolute left-0 right-0 mt-2 bg-white border border-slate-100 rounded-2xl shadow-2xl z-30 max-h-64 overflow-y-auto"
                             x-on:click.outside="showDiseaseDropdown = false" x-cloak>
                            <template x-for="disease in filteredDiseases" :key="disease.id">
                                <button type="button" @@click="selectDisease(disease)"
                                        class="w-full text-left px-5 py-4 hover:bg-indigo-50 font-medium text-slate-700">
                                    <i class="fas fa-notes-medical text-indigo-400 mr-2"></i><span x-text="disease.name"></span>
                                </button>
                            </template>
                        </div>

                        <div x-show="selectedDiseases.length > 0" class="mt-4 flex flex-wrap gap-2" x-cloak>
                            <template x-for="disease in selectedDiseases" :key="disease.id">
                                <span class="inline-flex items-center gap-2 bg-indigo-50 text-indigo-700 px-4 py-2 rounded-xl text-sm font-medium border border-indigo-100">
                                    <i class="fas fa-heartbeat text-indigo-500"></i>
                                    <span x-text="disease.name"></span>
                                    <button type="button" @@click="removeDisease(disease)" class="hover:text-red-500 ml-1"><i class="fas fa-times"></i></button>
                                </span>
                            </template>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-slate-100">
                        <button @@click="checkInteractions()" :disabled="(selectedDrugs.length === 0 && selectedDiseases.length === 0) || isChecking"
                                class="flex-[2] bg-slate-900 text-white px-8 py-4 rounded-2xl font-bold hover:bg-slate-800 disabled:bg-slate-300 transition-all flex items-center justify-center gap-3 shadow-lg">
                            <i :class="isChecking ? 'fas fa-spinner fa-spin' : 'fas fa-shield-alt'"></i> 
                            <span x-text="isChecking ? 'Đang phân tích...' : 'Kích Hoạt Rà Soát'"></span>
                        </button>
                        <button @@click="clearAll()" :disabled="isChecking"
                                class="flex-1 border-2 border-slate-200 text-slate-600 rounded-2xl font-bold hover:bg-slate-50 transition-all">
                            Làm trống
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="resultsSection" x-show="showResults" x-cloak>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
            <div class="grid md:grid-cols-2 gap-8">
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
                    <h3 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2"><i class="fas fa-exchange-alt text-blue-500"></i> Tương tác Thuốc</h3>
                    <template x-for="interaction in drugDrugInteractions" :key="interaction.id">
                        <div class="p-5 bg-slate-50 rounded-2xl border border-slate-100 mb-4">
                            <h4 class="font-bold text-slate-900 mb-1" x-text="interaction.title"></h4>
                            <p class="text-sm text-slate-600 mb-3" x-text="interaction.description"></p>
                            <div class="bg-white p-3 rounded-lg border border-slate-200 text-xs text-slate-500 italic" x-text="interaction.recommendation"></div>
                        </div>
                    </template>
                </div>
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
                    <h3 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2"><i class="fas fa-exclamation-triangle text-red-500"></i> Chống chỉ định</h3>
                    <template x-for="contraindication in drugDiseaseContraindications" :key="contraindication.id">
                        <div class="p-5 bg-red-50/50 rounded-2xl border border-red-100 mb-4">
                            <h4 class="font-bold text-red-900 mb-1" x-text="contraindication.title"></h4>
                            <p class="text-sm text-red-800 mb-3" x-text="contraindication.description"></p>
                            <div class="bg-white/50 p-3 rounded-lg border border-red-100 text-xs text-red-700 italic" x-text="contraindication.recommendation"></div>
                        </div>
                    </template>
                </div>
            </div>
            
            <div class="mt-8 p-8 rounded-3xl text-center border-2 shadow-lg" :class="overallStatus.class">
                <i :class="'fas ' + overallStatus.icon + ' text-5xl mb-4'"></i>
                <h3 class="text-2xl font-black mb-2" x-text="overallStatus.message"></h3>
                <p class="text-lg opacity-90" x-text="overallStatus.detail"></p>
            </div>
        </div>
    </section>
</div>

@Html.AntiForgeryToken()

<!-- Logic Giữ Nguyên Cấu Trúc Khối Code JS Cũ Để Đảm Bảo Hoạt Động Mượt Mà -->
<script>
    function searchApp() {
        return {
            drugSearch: '',
            diseaseSearch: '',
            showDrugDropdown: false,
            showDiseaseDropdown: false,
            filteredDrugs: [],
            filteredDiseases: [],
            selectedDrugs: [],
            selectedDiseases: [],
            showResults: false,
            isChecking: false,
            drugDrugInteractions: [],
            drugDiseaseContraindications: [],
            overallStatus: { class: 'border-green-400 bg-green-50 text-green-900', icon: 'fa-check-circle', message: 'Hệ thống sẵn sàng', detail: 'Vui lòng chọn các danh mục y khoa để tiến hành kiểm chứng.' },

            filterDrugs() {
                if (this.drugSearch.trim().length < 2) {
                    this.filteredDrugs = [];
                    this.showDrugDropdown = false;
                    return;
                }
                fetch(`/Home/SearchDrugs?term=${encodeURIComponent(this.drugSearch)}`)
                    .then(res => res.json())
                    .then(data => {
                        this.filteredDrugs = data;
                        this.showDrugDropdown = true;
                    });
            },
            selectDrug(drug) {
                if (!this.selectedDrugs.some(d => d.id === drug.id)) {
                    this.selectedDrugs.push(drug);
                }
                this.drugSearch = '';
                this.showDrugDropdown = false;
            },
            removeDrug(drug) {
                this.selectedDrugs = this.selectedDrugs.filter(d => d.id !== drug.id);
            },
            filterDiseases() {
                if (this.diseaseSearch.trim().length < 2) {
                    this.filteredDiseases = [];
                    this.showDiseaseDropdown = false;
                    return;
                }
                fetch(`/Home/SearchDiseases?term=${encodeURIComponent(this.diseaseSearch)}`)
                    .then(res => res.json())
                    .then(data => {
                        this.filteredDiseases = data;
                        this.showDiseaseDropdown = true;
                    });
            },
            selectDisease(disease) {
                if (!this.selectedDiseases.some(d => d.id === disease.id)) {
                    this.selectedDiseases.push(disease);
                }
                this.diseaseSearch = '';
                this.showDiseaseDropdown = false;
            },
            removeDisease(disease) {
                this.selectedDiseases = this.selectedDiseases.filter(d => d.id !== disease.id);
            },
            checkInteractions() {
                if (this.isChecking) return;
                this.isChecking = true;

                const payload = {
                    drugIds: this.selectedDrugs.map(d => d.id),
                    diseaseIds: this.selectedDiseases.map(d => d.id)
                };

                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : '';

                fetch('/Home/CheckInteractions', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(res => {
                    if (!res.ok) throw new Error("Lỗi kết nối máy chủ.");
                    return res.json();
                })
                .then(data => {
                    this.drugDrugInteractions.splice(0, this.drugDrugInteractions.length, ...(data.drugDrugInteractions || []));
                    this.drugDiseaseContraindications.splice(0, this.drugDiseaseContraindications.length, ...(data.drugDiseaseContraindications || []));
                    this.calculateOverallStatus();
                    this.showResults = true;
                    setTimeout(() => {
                        document.getElementById('resultsSection')?.scrollIntoView({ behavior: 'smooth' });
                    }, 150);
                })
                .catch(err => { alert("Lỗi: " + err.message); })
                .finally(() => { this.isChecking = false; });
            },
            calculateOverallStatus() {
    const blueprints = this.drugDrugInteractions || [];
    const contraprints = this.drugDiseaseContraindications || [];
    
    // Sử dụng toán tử == để tránh lỗi lệch kiểu dữ liệu (chuỗi "5" vs số 5)
    const hasLevel5 = blueprints.some(i => i.level == 5) || contraprints.some(c => c.level == 5);
    const hasLevel4 = blueprints.some(i => i.level == 4) || contraprints.some(c => c.level == 4);
    const hasLevel3 = blueprints.some(i => i.level == 3) || contraprints.some(c => c.level == 3);
    const hasLevel2 = blueprints.some(i => i.level == 2) || contraprints.some(c => c.level == 2);
    const hasLevel1 = blueprints.some(i => i.level == 1) || contraprints.some(c => c.level == 1);

    if (hasLevel5) {
        // MỨC 5: RẤT NẶNG - CHỐNG CHỈ ĐỊNH TUYỆT ĐỐI (Màu đỏ sẫm báo động)
        this.overallStatus = { 
            class: 'border-red-600 bg-red-100 text-red-950 font-bold', 
            icon: 'fa-ban', 
            message: 'ĐƠN THUỐC BỊ CHỐNG CHỈ ĐỊNH TUYỆT ĐỐI!', 
            detail: 'Phát hiện tác nhân nguy hại tính mạng. Yêu cầu dừng kê đơn và thay thế thuốc hoặc phác đồ điều trị ngay lập tức.' 
        };
    } else if (hasLevel4) {
        // MỨC 4: NẶNG - NGUY CƠ BIẾN CHỨNG NGHIÊM TRỌNG (Màu đỏ tươi)
        this.overallStatus = { 
            class: 'border-red-400 bg-red-50 text-red-900', 
            icon: 'fa-exclamation-triangle', 
            message: 'Cảnh báo: Nguy cơ biến chứng nghiêm trọng!', 
            detail: 'Đơn thuốc xuất hiện các cặp tương tác có thể gây biến chứng lâm sàng nặng. Cần rà soát kỹ lại danh mục.' 
        };
    } else if (hasLevel3) {
        // MỨC 3: TRUNG BÌNH - CÂN NHẮC ĐỔI LIỀU HOẶC THUỐC (Màu cam)
        this.overallStatus = { 
            class: 'border-orange-400 bg-orange-50 text-orange-950', 
            icon: 'fa-exchange-alt', 
            message: 'Chú ý: Cân nhắc điều chỉnh liều hoặc đổi thuốc!', 
            detail: 'Phát hiện tương tác ảnh hưởng đến dược động học thuốc. Khuyến nghị tính toán lại hàm lượng hoặc thay thế hoạt chất tương đương.' 
        };
    } else if (hasLevel2) {
        // MỨC 2: VỪA - CÓ TƯƠNG TÁC NHỎ (Màu vàng)
        this.overallStatus = { 
            class: 'border-amber-400 bg-amber-50 text-amber-900', 
            icon: 'fa-exclamation-circle', 
            message: 'Khuyến cáo: Có tương tác nhỏ xảy ra', 
            detail: 'Hệ thống ghi nhận ảnh hưởng lâm sàng nhẹ giữa các thành phần. Bác sĩ cần lưu ý ghi chú thêm cho bệnh nhân.' 
        };
    } else if (hasLevel1) {
        // MỨC 1: NHẸ - CẦN THEO DÕI THÊM (Màu xanh dương / Thông tin)
        this.overallStatus = { 
            class: 'border-blue-400 bg-blue-50 text-blue-900', 
            icon: 'fa-info-circle', 
            message: 'Lưu ý điều trị: Cần theo dõi thêm', 
            detail: 'Xuất hiện tương tác xa hoặc cơ địa nhẹ. Không cần đổi thuốc nhưng cần dặn dò theo dõi phản ứng phụ.' 
        };
    } else {
        // AN TOÀN TUYỆT ĐỐI (Chỉ khi không dính bất kỳ mức nào từ 1 -> 5)
        this.overallStatus = { 
            class: 'border-emerald-400 bg-emerald-50 text-emerald-950', 
            icon: 'fa-check-circle', 
            message: 'Rà soát thành công - Đơn thuốc an toàn', 
            detail: 'Hệ thống không tìm thấy tương tác bất lợi hoặc chống chỉ định nào giữa thuốc và tình trạng bệnh hiện tại.' 
        };
    }
},
            clearAll() {
                this.selectedDrugs = [];
                this.selectedDiseases = [];
                this.drugSearch = '';
                this.diseaseSearch = '';
                this.showResults = false;
                this.drugDrugInteractions = [];
                this.drugDiseaseContraindications = [];
                this.overallStatus = { class: 'border-green-400 bg-green-50 text-green-900', icon: 'fa-check-circle', message: 'Hệ thống sẵn sàng', detail: 'Vui lòng chọn các danh mục y khoa để tiến hành kiểm chứng.' };
            }
        }
    }
</script>