@model IEnumerable<PharmaCheck.Models.Drug>

@{
    ViewData["Title"] = "Phòng Lâm Sàng | PharmaCheck - Tra Cứu Tương Tác";
}

<!-- 1. HEADER BANNER (Đồng bộ với Hero Section của Trang Chủ) -->
<section class="relative bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 text-white py-12 overflow-hidden shadow-inner">
    <div class="absolute top-0 right-0 -mt-6 -mr-6 w-64 h-64 bg-white opacity-5 rounded-full blur-xl pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-white/10 text-blue-100 uppercase tracking-wider mb-2 border border-white/5">
                    <i class="fas fa-stethoscope text-emerald-400"></i> Không gian làm việc bác sĩ
                </span>
                <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl flex items-center gap-3">
                    Phòng Lâm Sàng
                </h1>
                <p class="text-blue-100/90 font-light text-sm sm:text-base mt-1">
                    Kiểm tra xung đột đa thuốc và chống chỉ định bệnh lý theo thời gian thực dựa trên thuật toán ma trận sinh hóa.
                </p>
            </div>
            <div class="hidden md:block">
                <div class="px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl text-xs text-blue-100 font-mono">
                    <i class="fas fa-database text-emerald-400 mr-1.5"></i> V.2026.4.12
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. WORKSPACE CONTEXT -->
<div x-data="searchApp()" class="min-h-screen bg-gray-50 py-12">
    
    <!-- KHU VỰC NHẬP LIỆU (SEARCH PANEL) -->
    <section id="searchSection" class="mb-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-2xl shadow-xl border border-gray-200/80 p-6 sm:p-8 relative">
                    <div class="space-y-8">
                        
                        <!-- Ô nhập 1: Danh sách thuốc -->
                        <div class="relative">
                            <label class="block text-base font-bold text-gray-900 mb-2.5 flex items-center gap-2">
                                <span class="w-2 h-5 bg-blue-600 rounded-full"></span>
                                <span>Danh Sách Thuốc / Hoạt Chất</span>
                            </label>
                            <div class="relative">
                                <input type="text" 
                                       x-model="drugSearch"
                                       @@input.debounce.300ms="filterDrugs()"
                                       placeholder="Nhập tên thương mại hoặc hoạt chất gốc... (Ví dụ: Paracetamol, Amoxicillin)"
                                       class="w-full pl-4 pr-12 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl focus:outline-none focus:bg-white focus:border-blue-600 focus:shadow-md transition-all duration-200 text-gray-900 placeholder-gray-400">
                                <div class="absolute right-4 top-4 text-blue-500">
                                    <i class="fas fa-pills text-lg"></i>
                                </div>
                            </div>
                            
                            <!-- Hộp gợi ý Thuốc kết quả thả xuống -->
                            <div x-show="showDrugDropdown && filteredDrugs.length > 0" 
                                 class="absolute left-0 right-0 mt-2 bg-white border border-gray-200 rounded-xl shadow-2xl z-30 max-h-64 overflow-y-auto divide-y divide-gray-100"
                                 x-on:click.outside="showDrugDropdown = false" x-cloak>
                                <template x-for="drug in filteredDrugs" :key="drug.id">
                                    <button type="button"
                                            @@click="selectDrug(drug)"
                                            class="w-full text-left px-4 py-3 hover:bg-blue-50/60 transition-colors flex flex-col gap-0.5 group">
                                        <span class="font-semibold text-gray-800 group-hover:text-blue-700 flex items-center gap-2">
                                            <i class="fas fa-pills text-blue-500 text-xs"></i>
                                            <span x-text="drug.name"></span>
                                        </span>
                                        <span class="text-xs text-gray-400 pl-4" x-text="'Thành phần hoạt chất: ' + drug.activeIngredient"></span>
                                    </button>
                                </template>
                            </div>

                            <!-- Thẻ Thuốc Đã Chọn -->
                            <div x-show="selectedDrugs.length > 0" class="mt-4 flex flex-wrap gap-2" x-cloak>
                                <template x-for="drug in selectedDrugs" :key="drug.id">
                                    <span class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-3 py-1.5 rounded-xl text-sm font-semibold border border-blue-100 shadow-sm transition-all animate-fadeIn">
                                        <i class="fas fa-check text-xs text-emerald-500"></i>
                                        <span x-text="drug.name"></span>
                                        <button type="button" @@click="removeDrug(drug)" class="text-blue-400 hover:text-red-500 transition-colors ml-1">
                                            <i class="fas fa-times-circle"></i>
                                        </button>
                                    </span>
                                </template>
                            </div>
                        </div>

                        <!-- Ô nhập 2: Danh sách Bệnh lý -->
                        <div class="relative">
                            <label class="block text-base font-bold text-gray-900 mb-2.5 flex items-center gap-2">
                                <span class="w-2 h-5 bg-indigo-600 rounded-full"></span>
                                <span>Danh Sách Bệnh Lý (ICD-10 / Tên Bệnh)</span>
                            </label>
                            <div class="relative">
                                <input type="text"
                                       x-model="diseaseSearch"
                                       @@input.debounce.300ms="filterDiseases()"
                                       placeholder="Nhập tên bệnh hoặc mã chuẩn hóa... (Ví dụ: Tăng huyết áp, E11)"
                                       class="w-full pl-4 pr-12 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl focus:outline-none focus:bg-white focus:border-indigo-600 focus:shadow-md transition-all duration-200 text-gray-900 placeholder-gray-400">
                                <div class="absolute right-4 top-4 text-indigo-500">
                                    <i class="fas fa-heartbeat text-lg"></i>
                                </div>
                            </div>
                            
                            <!-- Hộp gợi ý Bệnh lý kết quả thả xuống -->
                            <div x-show="showDiseaseDropdown && filteredDiseases.length > 0"
                                 class="absolute left-0 right-0 mt-2 bg-white border border-gray-200 rounded-xl shadow-2xl z-30 max-h-64 overflow-y-auto divide-y divide-gray-100"
                                 x-on:click.outside="showDiseaseDropdown = false" x-cloak>
                                <template x-for="disease in filteredDiseases" :key="disease.id">
                                    <button type="button"
                                            @@click="selectDisease(disease)"
                                            class="w-full text-left px-4 py-3 hover:bg-indigo-50/60 transition-colors flex items-center gap-2.5 group">
                                        <i class="fas fa-notes-medical text-indigo-400 group-hover:text-indigo-600"></i>
                                        <span class="font-semibold text-gray-800 group-hover:text-indigo-700" x-text="disease.name"></span>
                                    </button>
                                </template>
                            </div>

                            <!-- Thẻ Bệnh Lý Đã Chọn -->
                            <div x-show="selectedDiseases.length > 0" class="mt-4 flex flex-wrap gap-2" x-cloak>
                                <template x-for="disease in selectedDiseases" :key="disease.id">
                                    <span class="inline-flex items-center gap-2 bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-xl text-sm font-semibold border border-indigo-100 shadow-sm transition-all animate-fadeIn">
                                        <i class="fas fa-heartbeat text-xs text-red-400"></i>
                                        <span x-text="disease.name"></span>
                                        <button type="button" @@click="removeDisease(disease)" class="text-indigo-400 hover:text-red-500 transition-colors ml-1">
                                            <i class="fas fa-times-circle"></i>
                                        </button>
                                    </span>
                                </template>
                            </div>
                        </div>

                        <!-- Các nút tương tác hành động -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-100">
                            <button @@click="checkInteractions()"
                                    :disabled="(selectedDrugs.length === 0 && selectedDiseases.length === 0) || isChecking"
                                    class="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-4 rounded-xl font-bold hover:from-blue-700 hover:to-indigo-800 disabled:from-gray-300 disabled:to-gray-400 disabled:cursor-not-allowed transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-base">
                                <i :class="isChecking ? 'fas fa-circle-notch fa-spin' : 'fas fa-shield-alt'"></i> 
                                <span x-text="isChecking ? 'Hệ thống đang rà soát...' : 'Kích Hoạt Rà Soát Đơn Thuốc'"></span>
                            </button>
                            <button @@click="clearAll()"
                                    :disabled="isChecking"
                                    class="px-6 py-4 border-2 border-gray-200 bg-white text-gray-700 rounded-xl font-bold hover:bg-gray-50 hover:border-gray-300 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200 flex items-center justify-center gap-2">
                                <i class="fas fa-trash-alt text-sm text-gray-400"></i> Làm Trống Đơn
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- KHU VỰC HIỂN THỊ KẾT QUẢ (RESULTS SECTION) -->
    <section id="resultsSection" class="py-4" x-show="showResults" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-2 gap-8 items-start">
                
                <!-- Bảng Cột 1: Tương Tác Thuốc - Thuốc -->
                <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-blue-700 to-blue-600 text-white px-6 py-4 flex items-center gap-3">
                        <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center">
                            <i class="fas fa-exchange-alt"></i>
                        </div>
                        <h3 class="text-lg font-bold tracking-tight">Xung Đột Thuốc - Thuốc (Chéo)</h3>
                    </div>
                    <div class="p-6 space-y-4">
                        <div x-show="drugDrugInteractions.length > 0">
                            <template x-for="interaction in drugDrugInteractions" :key="interaction.id">
                                <div class="p-4 rounded-xl border-l-4 mb-3 transition-all" 
                                     :class="{
                                         'border-red-500 bg-red-50/60 text-red-950': interaction.level === 3,
                                         'border-amber-500 bg-amber-50/60 text-amber-950': interaction.level === 2,
                                         'border-blue-500 bg-blue-50/60 text-blue-950': interaction.level === 1
                                     }">
                                    <div class="flex items-start gap-3">
                                        <i :class="'fas ' + interaction.icon + ' text-lg mt-0.5'"
                                           :class="{
                                               'text-red-600': interaction.level === 3,
                                               'text-amber-600': interaction.level === 2,
                                               'text-blue-600': interaction.level === 1
                                           }"></i>
                                        <div class="flex-1 space-y-1">
                                            <h4 class="font-bold text-base" x-text="interaction.title"></h4>
                                            <p class="text-sm opacity-90 leading-relaxed" x-text="interaction.description"></p>
                                            <div class="mt-3 p-3 bg-white border border-gray-100 rounded-lg text-xs leading-relaxed shadow-sm">
                                                <strong class="text-gray-900 font-bold uppercase tracking-wider text-[10px] block mb-0.5">Khuyến cáo lâm sàng:</strong> 
                                                <span class="text-gray-700" x-text="interaction.recommendation"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </template>
                        </div>
                        <div x-show="drugDrugInteractions.length === 0" class="text-center py-10 text-gray-500">
                            <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-emerald-100">
                                <i class="fas fa-check-circle text-2xl text-emerald-500"></i>
                            </div>
                            <p class="text-sm font-medium">Không phát hiện tương tác nguy hiểm chéo.</p>
                        </div>
                    </div>
                </div>

                <!-- Bảng Cột 2: Chống Chỉ Định Thuốc - Bệnh -->
                <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-red-600 to-rose-700 text-white px-6 py-4 flex items-center gap-3">
                        <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <h3 class="text-lg font-bold tracking-tight">Chống Chỉ Định Thuốc - Bệnh Lý</h3>
                    </div>
                    <div class="p-6 space-y-4">
                        <div x-show="drugDiseaseContraindications.length > 0">
                            <template x-for="contraindication in drugDiseaseContraindications" :key="contraindication.id">
                                <div class="p-4 rounded-xl border-l-4 mb-3 transition-all"
                                     :class="{
                                         'border-red-500 bg-red-50/60 text-red-950': contraindication.level === 3,
                                         'border-amber-500 bg-amber-50/60 text-amber-950': contraindication.level === 2,
                                         'border-green-500 bg-green-50/60 text-green-950': contraindication.level === 1
                                     }">
                                    <div class="flex items-start gap-3">
                                        <i :class="'fas ' + contraindication.icon + ' text-lg mt-0.5'"
                                           :class="{
                                               'text-red-600': contraindication.level === 3,
                                               'text-amber-600': contraindication.level === 2,
                                               'text-green-600': contraindication.level === 1
                                           }"></i>
                                        <div class="flex-1 space-y-1">
                                            <h4 class="font-bold text-base" x-text="contraindication.title"></h4>
                                            <p class="text-sm opacity-90 leading-relaxed" x-text="contraindication.description"></p>
                                            <div class="mt-3 p-3 bg-white border border-gray-100 rounded-lg text-xs leading-relaxed shadow-sm">
                                                <strong class="text-gray-900 font-bold uppercase tracking-wider text-[10px] block mb-0.5">Khuyến cáo lâm sàng:</strong> 
                                                <span class="text-gray-700" x-text="contraindication.recommendation"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </template>
                        </div>
                        <div x-show="drugDiseaseContraindications.length === 0" class="text-center py-10 text-gray-500">
                            <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-emerald-100">
                                <i class="fas fa-check-circle text-2xl text-emerald-500"></i>
                            </div>
                            <p class="text-sm font-medium">Không có chống chỉ định với hồ sơ bệnh lý hiện tại.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Khối Đánh Giá Tổng Quan Bên Dưới (Overall Status Banner) -->
            <div class="mt-10 p-6 rounded-2xl text-center border-2 shadow-sm transition-all" :class="overallStatus.class">
                <i :class="'fas ' + overallStatus.icon + ' text-4xl mb-3'"></i>
                <h3 class="text-xl font-bold mb-1" x-text="overallStatus.message"></h3>
                <p class="text-sm opacity-90 font-light" x-text="overallStatus.detail"></p>
            </div>
        </div>
    </section>
</div>

@Html.AntiForgeryToken()

<!-- Logic Giữ Nguyên Cấu Trúc Khối Code JS Cũ Để Đảm Bảo Hoạt Động Mượt Mà -->
<script>
    function searchApp() {
        return {
            drugSearch: '',
            diseaseSearch: '',
            showDrugDropdown: false,
            showDiseaseDropdown: false,
            filteredDrugs: [],
            filteredDiseases: [],
            selectedDrugs: [],
            selectedDiseases: [],
            showResults: false,
            isChecking: false,
            drugDrugInteractions: [],
            drugDiseaseContraindications: [],
            overallStatus: { class: 'border-green-400 bg-green-50 text-green-900', icon: 'fa-check-circle', message: 'Hệ thống sẵn sàng', detail: 'Vui lòng chọn các danh mục y khoa để tiến hành kiểm chứng.' },

            filterDrugs() {
                if (this.drugSearch.trim().length < 2) {
                    this.filteredDrugs = [];
                    this.showDrugDropdown = false;
                    return;
                }
                fetch(`/Home/SearchDrugs?term=${encodeURIComponent(this.drugSearch)}`)
                    .then(res => res.json())
                    .then(data => {
                        this.filteredDrugs = data;
                        this.showDrugDropdown = true;
                    });
            },
            selectDrug(drug) {
                if (!this.selectedDrugs.some(d => d.id === drug.id)) {
                    this.selectedDrugs.push(drug);
                }
                this.drugSearch = '';
                this.showDrugDropdown = false;
            },
            removeDrug(drug) {
                this.selectedDrugs = this.selectedDrugs.filter(d => d.id !== drug.id);
            },
            filterDiseases() {
                if (this.diseaseSearch.trim().length < 2) {
                    this.filteredDiseases = [];
                    this.showDiseaseDropdown = false;
                    return;
                }
                fetch(`/Home/SearchDiseases?term=${encodeURIComponent(this.diseaseSearch)}`)
                    .then(res => res.json())
                    .then(data => {
                        this.filteredDiseases = data;
                        this.showDiseaseDropdown = true;
                    });
            },
            selectDisease(disease) {
                if (!this.selectedDiseases.some(d => d.id === disease.id)) {
                    this.selectedDiseases.push(disease);
                }
                this.diseaseSearch = '';
                this.showDiseaseDropdown = false;
            },
            removeDisease(disease) {
                this.selectedDiseases = this.selectedDiseases.filter(d => d.id !== disease.id);
            },
            checkInteractions() {
                if (this.isChecking) return;
                this.isChecking = true;

                const payload = {
                    drugIds: this.selectedDrugs.map(d => d.id),
                    diseaseIds: this.selectedDiseases.map(d => d.id)
                };

                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : '';

                fetch('/Home/CheckInteractions', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(res => {
                    if (!res.ok) throw new Error("Lỗi kết nối máy chủ.");
                    return res.json();
                })
                .then(data => {
                    this.drugDrugInteractions.splice(0, this.drugDrugInteractions.length, ...(data.drugDrugInteractions || []));
                    this.drugDiseaseContraindications.splice(0, this.drugDiseaseContraindications.length, ...(data.drugDiseaseContraindications || []));
                    this.calculateOverallStatus();
                    this.showResults = true;
                    setTimeout(() => {
                        document.getElementById('resultsSection')?.scrollIntoView({ behavior: 'smooth' });
                    }, 150);
                })
                .catch(err => { alert("Lỗi: " + err.message); })
                .finally(() => { this.isChecking = false; });
            },
            calculateOverallStatus() {
    const blueprints = this.drugDrugInteractions || [];
    const contraprints = this.drugDiseaseContraindications || [];
    
    // Sử dụng toán tử == để tránh lỗi lệch kiểu dữ liệu (chuỗi "5" vs số 5)
    const hasLevel5 = blueprints.some(i => i.level == 5) || contraprints.some(c => c.level == 5);
    const hasLevel4 = blueprints.some(i => i.level == 4) || contraprints.some(c => c.level == 4);
    const hasLevel3 = blueprints.some(i => i.level == 3) || contraprints.some(c => c.level == 3);
    const hasLevel2 = blueprints.some(i => i.level == 2) || contraprints.some(c => c.level == 2);
    const hasLevel1 = blueprints.some(i => i.level == 1) || contraprints.some(c => c.level == 1);

    if (hasLevel5) {
        // MỨC 5: RẤT NẶNG - CHỐNG CHỈ ĐỊNH TUYỆT ĐỐI (Màu đỏ sẫm báo động)
        this.overallStatus = { 
            class: 'border-red-600 bg-red-100 text-red-950 font-bold', 
            icon: 'fa-ban', 
            message: 'ĐƠN THUỐC BỊ CHỐNG CHỈ ĐỊNH TUYỆT ĐỐI!', 
            detail: 'Phát hiện tác nhân nguy hại tính mạng. Yêu cầu dừng kê đơn và thay thế thuốc hoặc phác đồ điều trị ngay lập tức.' 
        };
    } else if (hasLevel4) {
        // MỨC 4: NẶNG - NGUY CƠ BIẾN CHỨNG NGHIÊM TRỌNG (Màu đỏ tươi)
        this.overallStatus = { 
            class: 'border-red-400 bg-red-50 text-red-900', 
            icon: 'fa-exclamation-triangle', 
            message: 'Cảnh báo: Nguy cơ biến chứng nghiêm trọng!', 
            detail: 'Đơn thuốc xuất hiện các cặp tương tác có thể gây biến chứng lâm sàng nặng. Cần rà soát kỹ lại danh mục.' 
        };
    } else if (hasLevel3) {
        // MỨC 3: TRUNG BÌNH - CÂN NHẮC ĐỔI LIỀU HOẶC THUỐC (Màu cam)
        this.overallStatus = { 
            class: 'border-orange-400 bg-orange-50 text-orange-950', 
            icon: 'fa-exchange-alt', 
            message: 'Chú ý: Cân nhắc điều chỉnh liều hoặc đổi thuốc!', 
            detail: 'Phát hiện tương tác ảnh hưởng đến dược động học thuốc. Khuyến nghị tính toán lại hàm lượng hoặc thay thế hoạt chất tương đương.' 
        };
    } else if (hasLevel2) {
        // MỨC 2: VỪA - CÓ TƯƠNG TÁC NHỎ (Màu vàng)
        this.overallStatus = { 
            class: 'border-amber-400 bg-amber-50 text-amber-900', 
            icon: 'fa-exclamation-circle', 
            message: 'Khuyến cáo: Có tương tác nhỏ xảy ra', 
            detail: 'Hệ thống ghi nhận ảnh hưởng lâm sàng nhẹ giữa các thành phần. Bác sĩ cần lưu ý ghi chú thêm cho bệnh nhân.' 
        };
    } else if (hasLevel1) {
        // MỨC 1: NHẸ - CẦN THEO DÕI THÊM (Màu xanh dương / Thông tin)
        this.overallStatus = { 
            class: 'border-blue-400 bg-blue-50 text-blue-900', 
            icon: 'fa-info-circle', 
            message: 'Lưu ý điều trị: Cần theo dõi thêm', 
            detail: 'Xuất hiện tương tác xa hoặc cơ địa nhẹ. Không cần đổi thuốc nhưng cần dặn dò theo dõi phản ứng phụ.' 
        };
    } else {
        // AN TOÀN TUYỆT ĐỐI (Chỉ khi không dính bất kỳ mức nào từ 1 -> 5)
        this.overallStatus = { 
            class: 'border-emerald-400 bg-emerald-50 text-emerald-950', 
            icon: 'fa-check-circle', 
